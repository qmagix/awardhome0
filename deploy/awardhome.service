[Unit]
Description=AwardHome (Node/Express)
After=network.target

[Service]
Type=simple
User=awardhome
WorkingDirectory=/opt/awardhome
EnvironmentFile=/opt/awardhome/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/awardhome

[Install]
WantedBy=multi-user.target
