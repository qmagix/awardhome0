{
  "openapi": "3.0.3",
  "info": {
    "title": "AwardHome Mobile API",
    "version": "1.0.0",
    "description": "Versioned JSON API for the AwardHome family app (design v2 \u00a79, development plan M5).\n\nAuthentication is an opaque bearer token, never a session cookie, so no CSRF token is involved: nothing attaches a bearer token automatically, so there is nothing for a cross-site request to forge.\n\nRead endpoints that mirror a public web page work with no token at all \u2014 guest browsing needs no account.\n\nNothing in this API writes a canonical award, event, or studio. Family input lands in staging and is promoted by a reviewer, by corroboration between unrelated households, or (for independent dancers, who have no studio owner to review them) automatically and labelled as such."
  },
  "servers": [
    {
      "url": "/api/v1/mobile"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Access token from /auth/verify or /auth/refresh. Short-lived (15 minutes by default); refresh tokens rotate on every use and a reused one revokes the whole session."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable machine code."
          },
          "message": {
            "type": "string",
            "description": "Human-readable, safe to show a family."
          }
        },
        "required": [
          "error"
        ]
      },
      "Tokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Access token lifetime in seconds."
          }
        }
      },
      "Award": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "place": {
            "type": "string",
            "nullable": true
          },
          "performance_name": {
            "type": "string",
            "nullable": true
          },
          "award_type": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "age_division": {
            "type": "string",
            "nullable": true
          },
          "verification_status": {
            "type": "string",
            "nullable": true,
            "description": "family_submitted | corroborated | studio_confirmed | source_verified. family_submitted awards are public but held out of competitive rankings."
          },
          "event_name": {
            "type": "string",
            "nullable": true
          },
          "event_year": {
            "type": "integer",
            "nullable": true
          },
          "org_name": {
            "type": "string",
            "nullable": true
          },
          "studio_name": {
            "type": "string",
            "nullable": true,
            "description": "Independent dancers render as \"Independent\"."
          },
          "dancer_count": {
            "type": "integer"
          },
          "updated_at": {
            "type": "string",
            "nullable": true,
            "description": "Derived sync marker; pass back as updated_since."
          },
          "award_class": {
            "type": "string",
            "nullable": true,
            "description": "overall | title | scholarship | special | studio. Decides how an empty placement reads."
          },
          "place_display": {
            "type": "string",
            "description": "Placement as a reader should see it: ordinals normalised (\"1\" -> \"1st\"), and an empty placement rendered as \"Winner\" for scholarships/titles/special/studio awards \u2014 which have no rank \u2014 or \"N/A\" otherwise. Formatted by the same helper the web pages use; prefer this over `place`."
          }
        }
      },
      "Submission": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "client_submission_id": {
            "type": "string"
          },
          "performance_name": {
            "type": "string"
          },
          "group_size": {
            "type": "string",
            "enum": [
              "solo",
              "duet",
              "trio",
              "small_group",
              "large_group",
              "line",
              "grand_line",
              "production"
            ]
          },
          "cast_complete": {
            "type": "integer",
            "description": "0 for group formats, always \u2014 the record is explicitly partial."
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "needs_info",
              "accepted",
              "rejected",
              "withdrawn"
            ]
          },
          "verification_level": {
            "type": "string"
          },
          "award_id": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "EventOption": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "upcoming",
              "candidate",
              "event"
            ],
            "description": "upcoming = the organizer's own announced tour stop; candidate = added by a family; event = canonical historical event."
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "when": {
            "type": "string",
            "nullable": true
          },
          "where": {
            "type": "string",
            "nullable": true
          },
          "distance_miles": {
            "type": "number",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "paths": {
    "/openapi.json": {
      "get": {
        "summary": "This document",
        "security": [],
        "responses": {
          "200": {
            "description": "The contract"
          }
        }
      }
    },
    "/auth/request-code": {
      "post": {
        "summary": "Email a one-time sign-in code",
        "description": "Always returns 200 with the same body whether or not the address has an account \u2014 this endpoint must not become an account-existence oracle.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "summary": "Exchange a code for tokens",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "device_label": {
                    "type": "string"
                  },
                  "platform": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "code"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tokens"
                }
              }
            }
          },
          "401": {
            "description": "Bad or expired code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "A first-time address gets an account created here rather than being sent to the website to make one \u2014 the code already proved the person controls it. `isNewAccount` says which happened."
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate tokens",
        "description": "Refresh tokens are single-use. Presenting one that has already been rotated revokes the whole session \u2014 we cannot distinguish replay from theft, so we assume theft.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "refresh_token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tokens"
                }
              }
            }
          },
          "401": {
            "description": "Sign in again"
          }
        }
      }
    },
    "/auth/revoke": {
      "post": {
        "summary": "Revoke this device, or every device",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "all": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Revoked; effective on the next request"
          }
        }
      }
    },
    "/auth/sessions": {
      "get": {
        "summary": "Devices signed in to this account",
        "responses": {
          "200": {
            "description": "Sessions"
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "The household: dancers managed, with derived studio affiliations",
        "responses": {
          "200": {
            "description": "Household"
          }
        },
        "description": "Dancers this household manages, plus any it has a PENDING claim on. `standing` is 'owner' or 'pending_claim' \u2014 a pending claimant may record awards, but they stage and are sent only when the claim is approved. Each dancer also carries `independent_publish_status` ('none' | 'requested' | 'approved') \u2014 meaningful only for independents, and the difference between an app that promises review and one that admits there is no reviewer. Order is part of the contract, not a display detail: confirmed dancers first (alphabetical, so a stable list does not reshuffle between visits), then pending claims newest-first. Each row also carries `claim_at`, the pending claim's timestamp, or null."
      }
    },
    "/dancers/search": {
      "get": {
        "summary": "Search dancers by name",
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matches"
          }
        }
      }
    },
    "/dancers/{id}/awards": {
      "get": {
        "summary": "Trophy case",
        "description": "Public, and honours the owner's per-card hide. Ordered most-recent-first by competition year. Page with `cursor` (opaque `\"<year>:<id>\"` keyset, echoed back as `nextCursor`) and sync with `updated_since`.",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Numeric id or unique_id."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque keyset cursor of the form \"<year>:<id>\", taken from a previous nextCursor."
          },
          {
            "name": "updated_since",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Awards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "awards": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Award"
                      }
                    },
                    "nextCursor": {
                      "type": "integer",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such dancer"
          }
        }
      }
    },
    "/dancers/{id}/claim": {
      "post": {
        "summary": "Claim a dancer profile",
        "description": "A second household claiming the same dancer contests both claims, which routes them to AwardHome and away from any studio. The response includes `unclaimedStudio` when the dancer's studio has no owner \u2014 nobody at that studio will review the claim, and the family is the person positioned to change that.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "relationship": {
                    "type": "string"
                  },
                  "proof": {
                    "type": "string"
                  },
                  "studio_code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Filed"
          },
          "409": {
            "description": "Already claimed"
          },
          "429": {
            "description": "Daily limit"
          }
        }
      }
    },
    "/events/nearby": {
      "get": {
        "summary": "Event picker",
        "description": "Ranks the organizer's geocoded tour stops, other families' candidates, and canonical events. Pass lat/lng/date for the one-tap case, or q to search by name.",
        "security": [],
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Options",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "options": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EventOption"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events/candidates": {
      "post": {
        "summary": "Create an event candidate (never a canonical event)",
        "description": "Send check_only:true to see likely duplicates without creating anything. Without confirm_new, a likely twin comes back as 409 with the duplicates instead of creating a second row.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "city": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "venue": {
                    "type": "string"
                  },
                  "lat": {
                    "type": "number"
                  },
                  "lng": {
                    "type": "number"
                  },
                  "org_id": {
                    "type": "integer"
                  },
                  "check_only": {
                    "type": "boolean"
                  },
                  "confirm_new": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "start_date"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "409": {
            "description": "Likely duplicates offered"
          }
        }
      }
    },
    "/submissions": {
      "get": {
        "summary": "Status feed for this household",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "updated_since",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Submissions"
          }
        }
      },
      "post": {
        "summary": "Submit a missing award",
        "description": "Idempotent on (user, client_submission_id): a retried offline upload returns the ORIGINAL row. group_size is required \u2014 it decides the canonical write path. The studio is derived from affiliation and is never accepted as free text.\n\nA PENDING claimant may submit: the row stages with `unverified_household = 1`, `queued: true` comes back, and it takes neither automatic promotion door (independent auto-approval or corroboration) until her claim is approved. It is also not offered as anyone else's corroboration in the meantime. Approving the claim clears the marker and re-runs promotion for everything she queued.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_submission_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "dancer_id": {
                    "type": "integer"
                  },
                  "event_id": {
                    "type": "integer"
                  },
                  "event_candidate_id": {
                    "type": "integer"
                  },
                  "upcoming_event_id": {
                    "type": "integer"
                  },
                  "studio_id": {
                    "type": "integer",
                    "description": "Only honoured when the dancer has more than one affiliation."
                  },
                  "performance_name": {
                    "type": "string"
                  },
                  "group_size": {
                    "type": "string"
                  },
                  "place": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "award_type": {
                    "type": "string"
                  },
                  "age_division": {
                    "type": "string"
                  },
                  "teacher": {
                    "type": "string"
                  },
                  "choreographer": {
                    "type": "string"
                  },
                  "cast_names": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "notes": {
                    "type": "string"
                  },
                  "event_session_id": {
                    "type": "string",
                    "description": "From /event-sessions. Validated against the caller; an id belonging to another household is dropped, not rejected."
                  },
                  "card_photo_object_key": {
                    "type": "string",
                    "description": "Object key from an evidence upload, reused as the award card's photo. Enters moderation at 'pending' when the award is promoted \u2014 never published by submitting."
                  },
                  "card_photo_media_type": {
                    "type": "string"
                  },
                  "thank_you_note": {
                    "type": "string",
                    "description": "Card acknowledgement. Also enters moderation at 'pending' on promotion."
                  },
                  "card_consent_affirmed": {
                    "type": "boolean",
                    "description": "Parent/guardian affirmation, or permission from everyone pictured. Recorded once per (uploader, dancer)."
                  }
                },
                "required": [
                  "client_submission_id",
                  "dancer_id",
                  "performance_name",
                  "group_size"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "200": {
            "description": "Idempotent replay of an earlier submission"
          },
          "400": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Daily limit"
          }
        }
      }
    },
    "/submissions/{id}/evidence": {
      "post": {
        "summary": "Request an upload grant",
        "description": "Two-step so the storage driver can change (local disk today, S3/R2 later) without the client changing. Evidence is private and is never share media.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Grant issued"
          },
          "404": {
            "description": "No such submission"
          }
        }
      }
    },
    "/uploads": {
      "post": {
        "summary": "Redeem an upload grant with the file bytes",
        "description": "Send the raw bytes with the grant in the X-Upload-Grant header. The server identifies the file by its magic bytes, not by Content-Type, and strips EXIF/metadata before storing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored"
          },
          "400": {
            "description": "Bad grant or unsupported type"
          },
          "413": {
            "description": "Too large"
          }
        }
      }
    },
    "/evidence/{id}": {
      "get": {
        "summary": "Download evidence (uploader and reviewers only)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file, as an attachment"
          },
          "404": {
            "description": "Not found, or not yours"
          }
        }
      }
    },
    "/corrections": {
      "post": {
        "summary": "Propose a correction to a published award",
        "description": "A proposal, never an edit. Only a household whose own dancer is on the award may file one.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "award_id": {
                    "type": "integer"
                  },
                  "dancer_id": {
                    "type": "integer"
                  },
                  "field": {
                    "type": "string",
                    "enum": [
                      "performance_name",
                      "place",
                      "award_type",
                      "category",
                      "age_division"
                    ]
                  },
                  "proposed_value": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "award_id",
                  "dancer_id",
                  "field",
                  "proposed_value"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Filed"
          },
          "403": {
            "description": "Not your dancer's award"
          }
        }
      }
    },
    "/activity": {
      "get": {
        "summary": "Decisions and questions on this household's things",
        "description": "Deliberately not an engagement feed \u2014 decisions and questions only, the same rule push notifications follow.",
        "responses": {
          "200": {
            "description": "Activity"
          }
        }
      }
    },
    "/devices": {
      "post": {
        "summary": "Register for push",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "platform": {
                    "type": "string"
                  },
                  "token": {
                    "type": "string"
                  },
                  "preferences": {
                    "type": "object"
                  }
                },
                "required": [
                  "platform",
                  "token"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered"
          }
        }
      }
    },
    "/event-sessions": {
      "post": {
        "summary": "Open (or rejoin) the session for a weekend at one event",
        "description": "Get-or-create. A client that lost its local copy \u2014 reinstalled, switched devices mid-weekend \u2014 rejoins the same session rather than starting a second one, which is why the id is issued by the server rather than minted on the device. 201 when created, 200 when rejoining.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event_id": {
                    "type": "integer"
                  },
                  "event_candidate_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created"
          },
          "200": {
            "description": "Existing session rejoined"
          },
          "400": {
            "description": "An event is required"
          }
        }
      }
    },
    "/event-sessions/{id}": {
      "get": {
        "summary": "What this session already knows",
        "description": "Suggested dancer, studio, teacher and choreographer from earlier submissions in the same batch \u2014 suggestions, never silently applied.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session context"
          },
          "404": {
            "description": "No such session"
          }
        }
      }
    },
    "/studios/search": {
      "get": {
        "summary": "Search studios by name",
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matches, each with is_claimed"
          }
        }
      }
    },
    "/studios/{id}": {
      "get": {
        "summary": "Public studio summary",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "unique_id or numeric id"
          }
        ],
        "responses": {
          "200": {
            "description": "Studio and stats"
          },
          "404": {
            "description": "No such studio (independent dancers' synthetic studios are never returned)"
          }
        },
        "description": "Public. Returns the studio, aggregate stats, and a RECOGNITION PREVIEW \u2014 `recentEvents` (newest season first; event names carry the city, which identifies a studio better than the address column, on file for only 1,340 of 25,081) and `recentAwards` (named routines first, since a nameless convention scholarship identifies nothing). `recentAwards` deliberately carries NO dancer names: roster lists are not public, and a page asking \"do you recognise this studio?\" is the last place that should change. `studio.is_mine` is true only for the caller who owns it \u2014 a guest learns nothing beyond `is_claimed`."
      }
    },
    "/studios/{id}/claim": {
      "post": {
        "summary": "Claim a studio",
        "description": "Mirrors the web flow including the domain fast-track: a claimant whose verified email domain matches the studio's website is approved immediately. Safe on mobile for the same reason it is on the web \u2014 the address is verified, here by the sign-in code itself.\n\n`contact_name`, `role` and `show_publicly` are stored structurally as well as in the reviewer's proof text. On approval they become studios.manager_name / manager_role / manager_public, so a claimed studio page can answer \"who manages this?\" \u2014 but only when the claimant ticked the box saying families would see it. A contact name given as verification evidence is not a public byline, so consent is asked at collection and never inferred.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "contact_name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "studio_address": {
                    "type": "string",
                    "description": "Required \u2014 how same-named studios are told apart."
                  },
                  "proof": {
                    "type": "string"
                  }
                },
                "required": [
                  "contact_name",
                  "studio_address"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Filed, or approved outright on a domain match"
          },
          "409": {
            "description": "Already claimed"
          }
        }
      }
    },
    "/dancers/{id}/publish-request": {
      "post": {
        "summary": "Ask AwardHome to publish an independent dancer's record",
        "description": "Independent dancers have no studio director, so family-entered awards are kept PRIVATELY by default rather than auto-published: 'is this your child?' and 'do we publish your unreviewed entries on a public page?' are different questions, and only the second is one AwardHome can meaningfully answer. This asks for the second. A superadmin grant is retroactive \u2014 the whole private record publishes at once, still labelled family_submitted and still held out of rankings. Corroboration by another household publishes an independent record with no grant at all.\n\nOwner only. 400 `not_independent` if the dancer has a studio: their director confirms awards, so there is nothing to ask for.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Numeric id or unique_id."
          }
        ],
        "responses": {
          "200": {
            "description": "State after the request ('requested', or 'approved' if already granted)"
          },
          "400": {
            "description": "Not an independent dancer"
          },
          "403": {
            "description": "Not this household's dancer"
          },
          "404": {
            "description": "No such dancer"
          }
        }
      }
    },
    "/studios/{id}/claim-photo": {
      "post": {
        "summary": "Attach the claimant's photo to their pending studio claim",
        "description": "Raw image bytes (JPEG or PNG). PRIVATE \u2014 it goes to reviewers, never to the studio page. Two different arguments for it: a studio's own \"meet the staff\" page is public, so a face is checkable evidence in a way a typed name is not; and being asked for your own face raises the cost of a speculative claim.\n\nSame treatment as award evidence: the bytes are believed rather than the Content-Type header, camera metadata is stripped, and the file is written 0600 outside the served tree. Only ever attachable to the caller's OWN pending claim \u2014 404 otherwise, so a studio id alone cannot be used to put a face on someone else's claim. Public display of a manager photo is a separate, unbuilt decision (`studios.manager_photo_public` exists and stays 0).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Stored"
          },
          "400": {
            "description": "Not a JPEG or PNG once sniffed"
          },
          "404": {
            "description": "No pending claim of yours on that studio"
          }
        }
      }
    }
  }
}