<%- include('partials/header') %>
<div class="container" style="max-width: 1400px;">
  <div class="header-section">
    <h1>Manage Organizations</h1>
    <p class="subtitle">View, Add, and Edit Competition Organizations</p>
  </div>

  <div class="grid">
    <div class="card glass-card" style="grid-column: 1 / -1; overflow-x: auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="color: var(--primary);">Organizations</h3>
        <div style="display: flex; gap: 0.5rem;">
          <% if (user && user.role === 'superadmin') { %>
            <a href="/admin/org-invites" class="btn btn-outline" style="border-color: var(--accent-gold); color: var(--accent-gold); text-decoration: none;">Sent Invitations</a>
          <% } %>
          <button class="btn btn-primary" onclick="showAddOrgModal()">Add Organization</button>
        </div>
      </div>

      <table style="width: 100%; text-align: left; border-collapse: collapse; margin-top: 1rem;">
        <thead>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
            <th style="padding: 0.5rem 0.75rem 0.5rem 0; color: var(--text-muted);">ID</th>
            <th style="padding: 0.5rem 0.75rem 0.5rem 0; color: var(--text-muted);">Name</th>
            <th style="padding: 0.5rem 0.75rem 0.5rem 0; color: var(--text-muted);">Slug</th>
            <th style="padding: 0.5rem 0.75rem 0.5rem 0; color: var(--text-muted);">Website</th>
            <th style="padding: 0.5rem 0.75rem 0.5rem 0; color: var(--text-muted);">Events</th>
            <th style="padding: 0.5rem 0.75rem 0.5rem 0; color: var(--text-muted);">Status</th>
            <th style="padding: 0.5rem 0; color: var(--text-muted); text-align: right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% orgs.forEach(org => { %>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
              <td style="padding: 0.5rem 0.75rem 0.5rem 0;"><%= org.id %></td>
              <td style="padding: 0.5rem 0.75rem 0.5rem 0;"><strong><%= org.name %></strong></td>
              <td style="padding: 0.5rem 0.75rem 0.5rem 0;"><code><%= org.slug %></code></td>
              <td style="padding: 0.5rem 0.75rem 0.5rem 0;">
                <% if (org.website) { %>
                  <a href="<%= org.website %>" target="_blank" style="color: var(--secondary);"><%= org.website %></a>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td style="padding: 0.5rem 0.75rem 0.5rem 0;"><%= org.event_count || 0 %></td>
              <td style="padding: 0.5rem 0.75rem 0.5rem 0;">
                <% if (org.owner_id) { %>
                  <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #10b981;" title="<%= org.owner_email || '' %>">Claimed</span>
                <% } else if (org.last_invited_at) { %>
                  <span class="badge" style="background: rgba(234, 179, 8, 0.2); color: #eab308; white-space: nowrap;" title="Last invited <%= org.last_invited_at %>">Invited <%= new Date(org.last_invited_at + 'Z').toLocaleDateString() %></span>
                <% } else { %>
                  <span style="color: var(--text-muted); font-size: 0.85rem;">Unclaimed</span>
                <% } %>
              </td>
              <td class="org-actions" style="padding: 0.5rem 0 0.5rem 0.75rem; text-align: right; display: flex; justify-content: flex-end; align-items: center; gap: 0.4rem;">
                <% if (user && user.role === 'superadmin' && !org.owner_id) { %>
                  <button class="btn" style="background: rgba(212, 175, 55, 0.15); border: 1px solid var(--accent-gold); color: var(--accent-gold);"
                          data-org-id="<%= org.id %>" data-org-name="<%= org.name %>"
                          onclick="showInviteModal(this)">Invite</button>
                <% } %>
                <a href="/admin/org/<%= org.slug %>/categories" class="btn btn-warning" style="text-decoration: none;">Categories</a>
                <a href="/manage/org/<%= org.id %>" target="_blank" class="btn btn-outline" style="border-color: var(--accent-gold); color: var(--accent-gold); text-decoration: none;">Dashboard</a>
                <button class="btn btn-secondary" onclick="showEditOrgModal('<%= org.id %>', '<%= org.name.replace(/'/g, "\\'") %>', '<%= org.slug %>', '<%= (org.website || '').replace(/'/g, "\\'") %>')">Edit</button>
                <form action="/admin/orgs/<%= org.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this organization? This cannot be undone.');">
                  <button type="submit" class="btn" style="background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); color: #ef4444;">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
          <% if (orgs.length === 0) { %>
            <tr><td colspan="7" style="text-align: center; padding: 1rem;">No organizations found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal for Add/Edit -->
<div id="orgModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; justify-content: center; align-items: center;">
  <div class="card glass-card" style="width: 100%; max-width: 500px;">
    <h2 id="modalTitle" style="margin-top: 0; margin-bottom: 1.5rem;">Add Organization</h2>
    <form id="orgForm" method="POST" action="/admin/orgs">
      <input type="hidden" name="id" id="orgId">
      
      <div style="margin-bottom: 1rem;">
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Name</label>
        <input type="text" name="name" id="orgName" class="premium-input" style="width: 100%;" required>
      </div>
      
      <div style="margin-bottom: 1rem;">
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Slug</label>
        <input type="text" name="slug" id="orgSlug" class="premium-input" style="width: 100%;" required>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Website</label>
        <input type="url" name="website" id="orgWebsite" class="premium-input" style="width: 100%;" placeholder="https://...">
      </div>
      
      <div style="display: flex; gap: 1rem; justify-content: flex-end;">
        <button type="button" class="btn btn-secondary" onclick="hideModal()">Cancel</button>
        <button type="submit" class="btn btn-primary" id="modalSubmitBtn">Save</button>
      </div>
    </form>
  </div>
</div>

<style>
.org-actions .btn { padding: 0.35rem 0.7rem; font-size: 0.8rem; white-space: nowrap; }
</style>

<script>
function showAddOrgModal() {
  document.getElementById('modalTitle').textContent = 'Add Organization';
  document.getElementById('orgForm').action = '/admin/orgs';
  document.getElementById('orgId').value = '';
  document.getElementById('orgName').value = '';
  document.getElementById('orgSlug').value = '';
  document.getElementById('orgWebsite').value = '';
  document.getElementById('orgModal').style.display = 'flex';
}

function showEditOrgModal(id, name, slug, website) {
  document.getElementById('modalTitle').textContent = 'Edit Organization';
  document.getElementById('orgForm').action = '/admin/orgs/' + id + '/edit';
  document.getElementById('orgId').value = id;
  document.getElementById('orgName').value = name;
  document.getElementById('orgSlug').value = slug;
  document.getElementById('orgWebsite').value = website;
  document.getElementById('orgModal').style.display = 'flex';
}

function hideModal() {
  document.getElementById('orgModal').style.display = 'none';
}

// Auto-fill slug when name is typed (only for new orgs)
document.getElementById('orgName').addEventListener('input', function(e) {
  if (document.getElementById('orgId').value === '') {
    const slug = e.target.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    document.getElementById('orgSlug').value = slug;
  }
});

async function generateLoginLink(userId, targetUrl) {
  try {
    const res = await fetch('/admin/impersonate/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ user_id: userId, target_url: targetUrl })
    });
    const data = await res.json();
    
    if (data.success) {
      document.getElementById('generated-link-input').value = data.link;
      document.getElementById('link-modal').style.display = 'flex';
    } else {
      alert('Error generating link: ' + data.error);
    }
  } catch (e) {
    alert('Failed to connect to server.');
  }
}

function copyToClipboard() {
  const input = document.getElementById('generated-link-input');
  input.select();
  input.setSelectionRange(0, 99999);
  navigator.clipboard.writeText(input.value)
    .then(() => alert("Link copied to clipboard! Open an Incognito window and paste it."))
    .catch(err => alert("Failed to copy. Please copy it manually."));
}
</script>

<!-- Modal for displaying the generated link -->
<div id="link-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center;">
  <div class="card glass-card" style="max-width: 500px; width: 90%; text-align: center;">
    <h3 style="margin-bottom: 1rem; color: var(--accent-gold);">One-Time Login Link Generated!</h3>
    <p class="text-muted" style="margin-bottom: 1.5rem; font-size: 0.9rem;">This link will log you in as the account owner. It expires in 1 hour and can only be used once.</p>
    
    <input type="text" id="generated-link-input" class="premium-input" readonly style="width: 100%; margin-bottom: 1rem; text-align: center; font-size: 0.85rem; color: #f3e5ab;">
    
    <div style="display: flex; gap: 1rem; justify-content: center;">
      <button class="btn btn-primary" onclick="copyToClipboard()">Copy to Clipboard</button>
      <button class="btn btn-outline" onclick="document.getElementById('link-modal').style.display='none'">Close</button>
    </div>
    
    <p style="margin-top: 1rem; font-size: 0.8rem; color: #10b981;">Tip: Paste this link into a new <strong>Incognito Window</strong> so you don't lose your Superadmin session!</p>
  </div>
</div>

<% if (user && user.role === 'superadmin') { %>
<!-- Invitation letter composition modal -->
<div id="inviteModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; overflow-y: auto;">
  <div class="card glass-card" style="width: 100%; max-width: 720px; margin: 3rem auto; position: relative;">
    <button onclick="hideInviteModal()" style="position: absolute; right: 1rem; top: 1rem; background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.5rem;">&times;</button>
    <h2 style="margin-top: 0;">✉️ Invitation Letter — <span id="inviteOrgName"></span></h2>
    <p class="text-muted" style="margin-bottom: 1rem; font-size: 0.9rem;">
      Review and personalize before sending — a line about their specific events dramatically lifts response rates.
      An unsubscribe footer is appended automatically. Leave <code>{CLAIM_LINK}</code> in place: it becomes a private,
      single-use claim link (valid 30 days) when the letter is sent. Delete it to send a letter without one.
    </p>

    <div id="inviteResendWarning" style="display: none; background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.3); color: #eab308; padding: 0.6rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.9rem;"></div>

    <div id="inviteLoading" style="text-align: center; padding: 2rem; color: var(--text-muted);">Loading template…</div>

    <form id="inviteForm" style="display: none; flex-direction: column; gap: 1rem;" onsubmit="return sendInvite(event)">
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 220px;">
          <label style="display: block; margin-bottom: 0.4rem; color: var(--text-muted); font-size: 0.9rem;">To (email)</label>
          <input type="email" id="inviteEmail" class="premium-input" required style="width: 100%;" placeholder="director@competition.com">
        </div>
      </div>
      <div>
        <label style="display: block; margin-bottom: 0.4rem; color: var(--text-muted); font-size: 0.9rem;">Subject</label>
        <input type="text" id="inviteSubject" class="premium-input" required style="width: 100%;">
      </div>
      <div>
        <label style="display: block; margin-bottom: 0.4rem; color: var(--text-muted); font-size: 0.9rem;">Letter (plain text — line breaks and links are preserved)</label>
        <textarea id="inviteBody" rows="18" required style="width: 100%; padding: 0.75rem 1rem; border-radius: 8px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.15); color: white; font-family: inherit; font-size: 0.92rem; line-height: 1.5; resize: vertical;"></textarea>
      </div>
      <div id="inviteError" style="display: none; color: #ef4444; font-size: 0.9rem;"></div>
      <div style="display: flex; gap: 1rem; justify-content: flex-end;">
        <button type="button" class="btn btn-secondary" onclick="hideInviteModal()">Cancel</button>
        <button type="submit" id="inviteSendBtn" class="btn btn-primary">Send Invitation</button>
      </div>
    </form>
  </div>
</div>

<script>
let inviteOrgId = null;

// A non-JSON response here means an HTML page came back — a login redirect
// (expired session) or a 404 (server running older code). Say so instead of
// surfacing a JSON parse error.
async function fetchJson(url, opts) {
  const res = await fetch(url, opts);
  const ct = res.headers.get('content-type') || '';
  if (!ct.includes('application/json')) {
    throw new Error(res.status === 404
      ? 'Endpoint not found (' + res.status + ') — if the app was just updated, restart the server.'
      : 'Unexpected response (' + res.status + ') — your session may have expired; refresh the page and log in again.');
  }
  const data = await res.json();
  if (!res.ok) throw new Error(data.error || 'Request failed (' + res.status + ')');
  return data;
}

async function showInviteModal(btn) {
  inviteOrgId = btn.dataset.orgId;
  document.getElementById('inviteOrgName').textContent = btn.dataset.orgName;
  document.getElementById('inviteModal').style.display = 'block';
  document.getElementById('inviteForm').style.display = 'none';
  document.getElementById('inviteLoading').style.display = 'block';
  document.getElementById('inviteError').style.display = 'none';
  document.getElementById('inviteResendWarning').style.display = 'none';

  try {
    const data = await fetchJson('/admin/orgs/' + inviteOrgId + '/invite-template');

    document.getElementById('inviteEmail').value = (data.lastInvite && data.lastInvite.email) || '';
    document.getElementById('inviteSubject').value = data.subject;
    document.getElementById('inviteBody').value = data.body;
    if (data.lastInvite) {
      const w = document.getElementById('inviteResendWarning');
      w.textContent = 'Heads up: an invitation was already sent to ' + data.lastInvite.email +
        ' on ' + new Date(data.lastInvite.sent_at + 'Z').toLocaleDateString() + '. Sending again is allowed but make it a follow-up, not a repeat.';
      w.style.display = 'block';
    }
    document.getElementById('inviteLoading').style.display = 'none';
    document.getElementById('inviteForm').style.display = 'flex';
  } catch (e) {
    document.getElementById('inviteLoading').textContent = 'Error: ' + e.message;
  }
}

function hideInviteModal() {
  document.getElementById('inviteModal').style.display = 'none';
}

async function sendInvite(event) {
  event.preventDefault();
  const btn = document.getElementById('inviteSendBtn');
  const errEl = document.getElementById('inviteError');
  btn.disabled = true;
  btn.textContent = 'Sending…';
  errEl.style.display = 'none';

  try {
    const data = await fetchJson('/admin/orgs/' + inviteOrgId + '/invite', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: document.getElementById('inviteEmail').value,
        subject: document.getElementById('inviteSubject').value,
        body: document.getElementById('inviteBody').value
      })
    });
    if (!data.success) throw new Error(data.error || 'Send failed');
    alert('Invitation sent to ' + data.to);
    window.location.reload();
  } catch (e) {
    errEl.textContent = e.message;
    errEl.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Send Invitation';
  }
  return false;
}
</script>
<% } %>

<%- include('partials/footer') %>
