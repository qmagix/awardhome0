<%- include('partials/header') %>
<div class="container">

  <!-- Org identity -->
  <div class="card glass-card" style="padding: 2.5rem; margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 2rem; flex-wrap: wrap;">
      <% if (org.logo_url) { %>
        <img src="<%= org.logo_url %>" alt="<%= org.name %> logo"
          style="width: 96px; height: 96px; border-radius: 16px; object-fit: contain; background: rgba(255,255,255,0.05); padding: 8px;">
      <% } %>
      <div style="flex: 1; min-width: 260px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
          <h1 style="margin: 0 0 0.25rem; font-size: 2.2rem;"><%= org.name %></h1>
          <div style="display: flex; align-items: center; gap: 1rem; flex-shrink: 0;">
            <% if (!org.owner_id) { %>
              <a href="#" onclick="openOrgBenefitsModal(event)" style="color: var(--primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Why Claim?</a>
              <a href="mailto:hello@awardhome.com?subject=Organizer claim: <%= org.name %>" class="btn btn-primary">Claim This Page</a>
            <% } else if (typeof user !== 'undefined' && user && user.id === org.owner_id) { %>
              <a href="/manage/org/<%= org.id %>" class="btn btn-outline">Manage Organization</a>
            <% } %>
          </div>
        </div>
        <% if (org.slogan) { %>
          <p class="text-gold" style="font-weight: 600; margin: 0 0 0.5rem;"><%= org.slogan %></p>
        <% } %>
        <% if (org.description) { %>
          <p style="color: var(--text-muted); max-width: 640px; margin: 0; line-height: 1.6;"><%= org.description %></p>
        <% } %>
        <% if (org.website) { %>
          <% const orgSite = org.website.match(/^https?:\/\//) ? org.website : 'https://' + org.website; %>
          <a href="<%= orgSite %>" target="_blank" rel="noopener" class="btn btn-outline" style="margin-top: 1rem; display: inline-flex; align-items: center; gap: 0.4rem;">
            Visit Website &amp; Register for Events ↗
          </a>
        <% } %>
      </div>
    </div>

    <!-- Stats strip -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-top: 2rem;">
      <div style="text-align: center;">
        <div style="font-size: 2rem; font-weight: 800;" class="text-gold"><%= eventsCount %></div>
        <div style="font-size: 0.8rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted);">Events</div>
      </div>
      <div style="text-align: center;">
        <div style="font-size: 2rem; font-weight: 800;" class="text-gold"><%= (stats.totalAwards || 0).toLocaleString() %></div>
        <div style="font-size: 0.8rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted);">Awards Recorded</div>
      </div>
      <div style="text-align: center;">
        <div style="font-size: 2rem; font-weight: 800;" class="text-gold"><%= (stats.totalStudios || 0).toLocaleString() %></div>
        <div style="font-size: 0.8rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted);">Studios Awarded</div>
      </div>
      <% if (stats.firstYear) { %>
        <div style="text-align: center;">
          <div style="font-size: 2rem; font-weight: 800;" class="text-gold"><%= stats.firstYear %></div>
          <div style="font-size: 0.8rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted);">On AwardHome Since</div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Event history -->
  <h2>Event History</h2>
  <% groupedData.forEach(function(g) { %>
    <h3 class="year-divider"><%= g.year %></h3>
    <div class="card glass-card" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
      <% g.events.forEach(function(event, i) { %>
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.5rem; <%= i > 0 ? 'border-top: 1px solid rgba(255,255,255,0.05);' : '' %>">
          <div style="color: var(--text-color); font-weight: 600;">
            <% if (isAdmin) { %>
              <a href="/dance/event/<%= event.id %>" style="color: inherit;"><%= formatEventTitle(event.name, org.name) %></a>
            <% } else { %>
              <%= formatEventTitle(event.name, org.name) %>
            <% } %>
          </div>
          <% if (event.award_count > 0) { %>
            <span class="badge badge-count" style="flex-shrink: 0;"><%= event.award_count.toLocaleString() %> Awards</span>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% }); %>

  <!-- Organizer CTA -->
  <div class="card glass-card" style="padding: 2rem; margin: 2.5rem 0; text-align: center;">
    <h3 style="margin: 0 0 0.5rem;">Are you the organizer of <%= org.name %>?</h3>
    <p style="color: var(--text-muted); max-width: 560px; margin: 0 auto 1.25rem;">
      AwardHome Dance is free for organizers. Claim this page to add your logo, custom trophy
      icons, and marketing profile — your brand on every award your dancers share.
    </p>
    <a href="mailto:hello@awardhome.com?subject=Organizer claim: <%= org.name %>" class="btn btn-primary">Claim this page</a>
  </div>

</div>

<!-- Organizer Benefits Modal -->
<div id="org-benefits-modal"
  style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); z-index: 9999; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s ease;">
  <div class="card glass-card"
    style="position: relative; max-width: 520px; width: 90%; padding: 2.5rem; transform: scale(0.95); transition: transform 0.3s ease;">
    <button onclick="closeOrgBenefitsModal()"
      style="position: absolute; top: 1rem; right: 1rem; background: transparent; border: none; color: white; font-size: 1.5rem; cursor: pointer;">&times;</button>
    <h2 style="margin-top: 0; margin-bottom: 1.5rem; color: var(--primary); display: flex; align-items: center; gap: 0.5rem;">
      ✨ Why Claim Your Organization?</h2>

    <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.25rem;">
      <li style="display: flex; align-items: flex-start; gap: 1rem;">
        <span style="font-size: 1.5rem;">🏆</span>
        <div>
          <strong style="display: block; font-size: 1.05rem; margin-bottom: 0.25rem; color: white;">Your Brand on Every Trophy</strong>
          <span style="color: var(--text-muted); font-size: 0.9rem;">Upload your logo and custom trophy icons — they appear on every award card your dancers share on social media.</span>
        </div>
      </li>
      <li style="display: flex; align-items: flex-start; gap: 1rem;">
        <span style="font-size: 1.5rem;">📣</span>
        <div>
          <strong style="display: block; font-size: 1.05rem; margin-bottom: 0.25rem; color: white;">Marketing Profile</strong>
          <span style="color: var(--text-muted); font-size: 0.9rem;">Add your slogan and description so this page pitches your competition to every studio browsing AwardHome Dance.</span>
        </div>
      </li>
      <li style="display: flex; align-items: flex-start; gap: 1rem;">
        <span style="font-size: 1.5rem;">📊</span>
        <div>
          <strong style="display: block; font-size: 1.05rem; margin-bottom: 0.25rem; color: white;">Attendance Insights</strong>
          <span style="color: var(--text-muted); font-size: 0.9rem;">See analytics on the studios attending your events — including how many other competitions they attend each year.</span>
        </div>
      </li>
      <li style="display: flex; align-items: flex-start; gap: 1rem;">
        <span style="font-size: 1.5rem;">🎟️</span>
        <div>
          <strong style="display: block; font-size: 1.05rem; margin-bottom: 0.25rem; color: white;">Drive Event Registrations</strong>
          <span style="color: var(--text-muted); font-size: 0.9rem;">Link your event registration site right from this page — every dancer and studio browsing your results is one click from signing up for your next event.</span>
        </div>
      </li>
      <li style="display: flex; align-items: flex-start; gap: 1rem;">
        <span style="font-size: 1.5rem;">🗂️</span>
        <div>
          <strong style="display: block; font-size: 1.05rem; margin-bottom: 0.25rem; color: white;">Permanent Results Archive</strong>
          <span style="color: var(--text-muted); font-size: 0.9rem;">We host your results forever, interactively — no more "where can I find last year's results?" emails.</span>
        </div>
      </li>
    </ul>

    <a href="mailto:hello@awardhome.com?subject=Organizer claim: <%= org.name %>" class="btn btn-primary"
      style="display: block; text-align: center; margin-top: 2rem;">Claim This Page — It's Free</a>
  </div>
</div>

<script>
  function openOrgBenefitsModal(e) {
    if (e) e.preventDefault();
    const m = document.getElementById('org-benefits-modal');
    m.style.display = 'flex';
    setTimeout(() => {
      m.style.opacity = '1';
      m.querySelector('.card').style.transform = 'scale(1)';
    }, 10);
  }
  function closeOrgBenefitsModal() {
    const m = document.getElementById('org-benefits-modal');
    m.style.opacity = '0';
    m.querySelector('.card').style.transform = 'scale(0.95)';
    setTimeout(() => { m.style.display = 'none'; }, 300);
  }
  document.addEventListener('click', function (event) {
    const m = document.getElementById('org-benefits-modal');
    if (event.target === m) closeOrgBenefitsModal();
  });
</script>
<%- include('partials/footer') %>
