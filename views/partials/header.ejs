<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' — AwardHome' : 'AwardHome | Dance' %></title>
  <% if (typeof pageDesc !== 'undefined' && pageDesc) { %><meta name="description" content="<%= pageDesc %>"><% } %>
  <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
  <script src="/js/csrf.js"></script>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <nav class="glass-nav">
    <div class="nav-content" style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
      <a href="/dance" class="brand">Award<span>Home</span><span class="brand-tag">Dance</span></a>
      <button class="nav-toggle" aria-label="Menu" aria-expanded="false" onclick="var l=document.getElementById('nav-links');var open=l.classList.toggle('open');this.setAttribute('aria-expanded',open);">☰</button>
      <div class="nav-links" id="nav-links">
        <% if (typeof user !== 'undefined' && user) { %>
          <% if (user.role === 'admin' || user.role === 'superadmin') { %>
            <a href="/admin" style="color: white; text-decoration: none; font-weight: 600;">Dashboard</a>
            <a href="/admin/claims" style="color: white; text-decoration: none; font-weight: 600;">Admin Claims</a>
            <a href="/admin/studio-drafts" style="color: white; text-decoration: none; font-weight: 600;">Data Drafts</a>
            <a href="/admin/marketing/studios" style="color: #fbbf24; text-decoration: none; font-weight: 600;">📣 Invites</a>
          <% } %>
          <% if (user.role === 'superadmin') { %>
            <a href="/admin/duplicates" style="color: white; text-decoration: none; font-weight: 600;">Studio Duplicates</a>
            <a href="/admin/users" style="color: white; text-decoration: none; font-weight: 600;">User Mgmt</a>
            <a href="/admin/settings" style="color: #f3e5ab; text-decoration: none; font-weight: 600;">⚙️ Settings</a>
          <% } %>
          <% if (user.role === 'studio_owner') { %>
            <a href="/my-studio" style="color: white; text-decoration: none; font-weight: 600;">Manage Studio</a>
            <a href="/my-studio/public" style="color: white; text-decoration: none; font-weight: 600;">Public View</a>
          <% } %>
          <% if (user.role === 'org_owner') { %>
            <a href="/dance" style="color: white; text-decoration: none; font-weight: 600;">Home</a>
            <a href="/my-org" style="color: white; text-decoration: none; font-weight: 600;">Dashboard</a>
            <a href="/my-org?tab=past-events" style="color: white; text-decoration: none; font-weight: 600;">My Events</a>
            <a href="/my-org/public" style="color: white; text-decoration: none; font-weight: 600;">Public Page</a>
          <% } %>
          <% if (user.role === 'dancer_owner' || user.role === 'user') { %>
            <a href="/my-dancers" style="color: white; text-decoration: none; font-weight: 600;">My Dancers</a>
          <% } %>
          <a href="/my-feedback" style="color: white; text-decoration: none; font-weight: 600;">My Feedback</a>
          <a href="#" onclick="openFeedbackModal(event)" style="color: #fbbf24; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 0.3rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            Send Feedback
          </a>
          <span class="nav-email" style="color: var(--text-muted); font-size: 0.9rem;"><%= user.email %></span>
          <a href="/logout" style="color: var(--primary); text-decoration: none; font-weight: 600;">Logout</a>
        <% } else { %>
          <a href="/login" style="color: white; text-decoration: none; font-weight: 600;">Login</a>
          <a href="/register" class="btn btn-primary" style="padding: 0.4rem 1.1rem; font-size: 0.9rem; text-decoration: none;">Register</a>
        <% } %>
      </div>
    </div>
  </nav>
  <main>
  
  <% if (typeof user !== 'undefined' && user) { %>
    <%- include('feedback_modal') %>
  <% } %>
