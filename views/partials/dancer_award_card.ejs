<%
  const placeText = formatPlacement(award);
  let placeClass = 'award-place award-place-large';
  if (placeText.length > 25) {
    placeClass = 'award-place award-place-small';
  } else if (placeText.length > 12) {
    placeClass = 'award-place award-place-medium';
  }

  let tier = 'tier-star';
  let icon = '⭐';
  const pLower = placeText.toLowerCase();
  const typeLower = (award.award_type || '').toLowerCase();

  if (isPremiumAward(award)) {
    tier = 'tier-gold'; icon = getPremiumDetails(award).icon;
  } else if (pLower.includes('1st') || pLower === 'winner' || pLower.includes('first') || pLower === 'champion') {
    tier = 'tier-gold'; icon = '🏆';
  } else if (pLower.includes('2nd') || pLower.includes('second')) {
    tier = 'tier-silver'; icon = '🥈';
  } else if (pLower.includes('3rd') || pLower.includes('third')) {
    tier = 'tier-bronze'; icon = '🥉';
  } else if (pLower.includes('4th') || pLower.includes('5th') || pLower.includes('6th') ||
    pLower.includes('7th') || pLower.includes('8th') || pLower.includes('9th') ||
    pLower.includes('10th')) {
    // keep as star
  } else if (pLower.includes('miss') || typeLower.includes('miss') || pLower.includes('mr ') ||
    typeLower.includes('mr ')) {
    tier = 'tier-gold'; icon = '🏆';
  }

  if (pLower.includes('1st runner')) { tier = 'tier-silver'; icon = '🥈'; }
  else if (pLower.includes('2nd runner')) { tier = 'tier-bronze'; icon = '🥉'; }

  const isGroup = typeof isGroupAward !== 'undefined' && isGroupAward;
  const design = (typeof cardDesign !== 'undefined' && cardDesign) ? cardDesign : 'classic';

  // Logo shows only once a superadmin has fitted it into the coin and
  // flipped logo_approved (concierge default-off; the coin keeps mixed-org
  // grids to one silhouette regardless of logo shape). Fit settings → CSS
  // vars (styles.css has the defaults). Values are numbers sanitized at
  // save time (routes/dance/orgs.js). Shared by the front coin and the
  // flipbook colophon page.
  const lci = award.customIconsObj || {};
  const showOrgLogo = !!(award.logo_url && lci.logo_approved && !lci.hide_logo);
  const logoVars = [];
  if (showOrgLogo) {
    if (lci.logo_opacity !== undefined) logoVars.push('--org-logo-opacity: ' + lci.logo_opacity);
    const logoTf = [];
    if (lci.logo_offset_x || lci.logo_offset_y) logoTf.push('translate(' + (lci.logo_offset_x || 0) + 'px, ' + (lci.logo_offset_y || 0) + 'px)');
    if (lci.logo_rotation) logoTf.push('rotate(' + lci.logo_rotation + 'deg)');
    if (lci.logo_size && lci.logo_size !== 24) logoTf.push('scale(' + (lci.logo_size / 24) + ')');
    if (logoTf.length) logoVars.push('--org-logo-transform: ' + logoTf.join(' '));
  }

  // WYSIWYG editor (manage card page): pages that would only materialize
  // with content instead materialize as inline-editable placeholders.
  // Never set on public pages — visitors must not see "upload here".
  const editMode = typeof cardEditMode !== 'undefined' && !!cardEditMode;

  // Flipbook back-stack: pages materialize only when their content exists,
  // so the first flip always lands on a complete certificate.
  // Photo page: the per-award photo (usually the routine's performance
  // shot, approved in award_card_photos) wins; the dancer-level default
  // card photo is the fallback. Award photos get a rectangular frame
  // (action shots crop badly in a circle), the default keeps the medallion.
  const awardPhoto = design === 'flipbook' ? (award.award_photo_url || null) : null;
  const defaultPhoto = (dancer.card_photo_url && dancer.card_photo_status === 'approved') ? dancer.card_photo_url : null;
  const cardPhoto = awardPhoto || defaultPhoto;
  const hasPhotoPage = design === 'flipbook' && (editMode || !!cardPhoto);
  const cardAcks = (design === 'flipbook' && award.acks) ? award.acks : [];
  const hasAckPage = editMode || cardAcks.length > 0;
  const hasColophonPage = design === 'flipbook' && showOrgLogo;
  const pageCount = 1 + (hasPhotoPage ? 1 : 0) + (hasAckPage ? 1 : 0) + (hasColophonPage ? 1 : 0);
%>
<div class="flip-card <%= design === 'flipbook' ? 'flipbook' : '' %>"
  <%- editMode ? ' data-award-id="' + award.id + '" data-state="' + award.editState + '"' : '' %> role="button" tabindex="0" aria-label="Flip award card"
  onclick="if(this.dataset.swiped){delete this.dataset.swiped;return;}this.classList.toggle('flipped')"
  onkeydown="if(event.target===this&&(event.key==='Enter'||event.key===' ')){event.preventDefault();this.classList.toggle('flipped');}else if(event.target===this&&this.classList.contains('flipped')&&(event.key==='ArrowRight'||event.key==='ArrowLeft')&&window.tcbNavKey){event.preventDefault();tcbNavKey(this,event.key==='ArrowRight'?1:-1);}">
  <div class="flip-card-inner">
            <div class="premium-trophy-card flip-front <%= isPremiumAward(award) ? 'premium-award-border' : '' %>">
              <% if (!award.is_self_added) { %>
                <div class="verified-badge" title="Official Verified Award">
                  <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" width="14"
                    height="14">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                  </svg>
                </div>
                <% } %>
              <% if (editMode) { %>
                <span class="card-edit-chip chip-<%= award.editState %>" data-role="state-chip">
                  <%= award.editState === 'done' ? '✓ Done' : (award.editState === 'partial' ? '1 to add' : '2 to add') %>
                </span>
              <% } %>
                    <div class="content-wrapper <%= tier %>">
                      <div class="trophy-icon">
                        <% const customIconSolo=getCustomIcon(award, award.customIconsObj); %>
                          <% if (customIconSolo) { %>
                            <img src="<%= customIconSolo %>" alt="Icon" class="trophy-custom-icon">
                            <% } else { %>
                              <%= icon %>
                                <% } %>
                      </div>
                      <% if (showOrgLogo) { %>
                        <span class="card-org-coin"<%- logoVars.length ? ' style="' + logoVars.join('; ') + '"' : '' %>>
                          <img src="<%= award.logo_url %>" title="<%= award.org_name %> Logo">
                        </span>
                        <% } %>
                      <div class="card-body">
                          <div class="<%= placeClass %>">
                            <%= placeText %>
                          </div>
                          <% if (award.is_self_added) { %>
                            <span class="badge badge-self-reported"
                              title="Unverified manually reported award">Self-Reported</span>
                            <% } %>
                              <% if (award.performance_name) { %>
                                <p class="category">
                                  <%= award.award_type %>
                                </p>
                                <h3>
                                  <%= award.performance_name %>
                                </h3>
                                <% } else { %>
                                  <h3>
                                    <%= award.award_type %>
                                  </h3>
                                  <% } %>
                                    <% if (award.age_division) { %>
                                      <div class="age-division-row"><span class="badge badge-age-division">
                                          <%= award.age_division %>
                                        </span></div>
                                      <% } %>
                                        <% if (award.category) { %>
                                          <p class="sub-category">
                                            <%= award.category %>
                                          </p>
                                          <% } %>
                                            <p class="sub-category event-line">
                                              <%= formatEventTitle(award.event_name, award.org_name, award.event_year) %>
                                            </p>
                      </div>
                    </div>
            </div>

    <!-- Back face: champagne certificate with the dancer's name. In the
         flipbook design it is page 1 of a swipeable back-stack (photo,
         acknowledgements, organizer colophon pages appear only when their
         gated content exists). -->
    <div class="trophy-card-back <%= design === 'flipbook' ? 'tcb-book' : '' %>">
      <% const certOpen = design === 'flipbook' ? '<div class="tcb-page tcb-page-cert active">' : ''; %>
      <%- certOpen %>
      <div class="tcb-col tcb-who">
        <div class="tcb-icon"><%= icon %></div>
        <div class="tcb-eyebrow">Presented to</div>
        <div class="tcb-name"><%= dancer.name %></div>
        <% if (dancer.vanity_tag) { %>
          <div class="tcb-tag">#<%= dancer.vanity_tag %></div>
        <% } %>
        <% if (isGroup) { %>
          <div class="tcb-with">together with teammates</div>
        <% } %>
      </div>
      <div class="tcb-rule"></div>
      <div class="tcb-col tcb-what">
        <div class="tcb-place"><%= placeText %></div>
        <% if (award.performance_name) { %>
          <div class="tcb-perf">&ldquo;<%= award.performance_name %>&rdquo;</div>
        <% } %>
        <% const typeDupes = award.award_type && award.award_type.trim().toLowerCase() === placeText.trim().toLowerCase();
           const catParts = [typeDupes ? null : award.award_type, award.age_division, award.category].filter(Boolean); %>
        <% if (catParts.length) { %>
          <div class="tcb-cat"><%= catParts.join(' · ') %></div>
        <% } %>
        <div class="tcb-event"><%= formatEventTitle(award.event_name, award.org_name, award.event_year) %></div>
      </div>
      <%- design === 'flipbook' ? '</div>' : '' %>

      <% if (hasPhotoPage) { %>
        <div class="tcb-page tcb-page-photo">
          <% if (editMode) { %>
            <% if (award.ownPhoto) { %>
              <div class="tcb-photo-frame tcb-photo-frame-rect" data-role="photo-frame">
                <img src="<%= award.ownPhoto.photo_url %>" alt="Award photo" loading="lazy">
              </div>
              <div class="tcb-edit-status status-<%= award.ownPhoto.status %>" data-role="photo-status"><%=
                award.ownPhoto.status === 'approved' ? '✓ Live' :
                (award.ownPhoto.status === 'pending' ? 'Pending review' : 'Not approved — try another') %></div>
              <div class="tcb-edit-actions">
                <button type="button" class="tcb-edit-btn" onclick="event.stopPropagation(); editPickPhoto(this);">Replace</button>
                <button type="button" class="tcb-edit-btn tcb-edit-danger" onclick="event.stopPropagation(); editRemovePhoto(this);">Remove</button>
              </div>
            <% } else { %>
              <button type="button" class="tcb-photo-placeholder" data-role="photo-placeholder"
                onclick="event.stopPropagation(); editPickPhoto(this);">
                <span class="tcb-ph-icon">📷</span>
                <span>Upload this routine's photo</span>
              </button>
              <% if (defaultPhoto) { %>
                <div class="tcb-edit-hint">Cards show your default photo until then</div>
              <% } %>
            <% } %>
            <input type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif"
              style="display: none;" onclick="event.stopPropagation();" onchange="editPhotoChosen(this)">
            <div class="tcb-photo-name"><%= dancer.name %></div>
          <% } else { %>
            <div class="tcb-photo-frame <%= awardPhoto ? 'tcb-photo-frame-rect' : '' %>">
              <img src="<%= cardPhoto %>" alt="<%= dancer.name %>" loading="lazy">
            </div>
            <div class="tcb-photo-name"><%= dancer.name %></div>
            <% if (awardPhoto && award.performance_name) { %>
              <div class="tcb-photo-caption">&ldquo;<%= award.performance_name %>&rdquo;</div>
            <% } %>
          <% } %>
        </div>
      <% } %>

      <% if (hasAckPage) { %>
        <div class="tcb-page tcb-page-ack">
          <div class="tcb-icon">💛</div>
          <div class="tcb-eyebrow">With thanks</div>
          <% if (editMode) { %>
            <textarea class="tcb-ack-input" maxlength="280" rows="4" data-role="ack-input"
              placeholder="Write your thank-you note here — teachers, teammates, family…"
              onclick="event.stopPropagation();"><%= award.ownAck ? award.ownAck.message : '' %></textarea>
            <div class="tcb-edit-actions">
              <span class="tcb-edit-status <%= award.ownAck ? 'status-' + award.ownAck.status : '' %>" data-role="ack-status"><%=
                !award.ownAck ? '' :
                award.ownAck.status === 'approved' ? '✓ Live' :
                (award.ownAck.status === 'pending' ? 'Pending review' : 'Not approved — edit and resave') %></span>
              <button type="button" class="tcb-edit-btn" onclick="event.stopPropagation(); editSaveAck(this);">Save</button>
            </div>
            <% if (cardAcks.length) { %>
              <div class="tcb-ack-lines tcb-ack-mates">
                <% cardAcks.forEach(function(ack) { %>
                  <div class="tcb-ack-line">
                    <span class="tcb-ack-msg">&ldquo;<%= ack.message %>&rdquo;</span>
                    <span class="tcb-ack-author">&mdash; <%= ack.dancer_name %></span>
                  </div>
                <% }); %>
              </div>
            <% } %>
          <% } else { %>
            <div class="tcb-ack-lines">
              <% cardAcks.forEach(function(ack) { %>
                <div class="tcb-ack-line <%= ack.dancer_id === dancer.id ? 'tcb-ack-mine' : '' %>">
                  <span class="tcb-ack-msg">&ldquo;<%= ack.message %>&rdquo;</span>
                  <span class="tcb-ack-author">&mdash; <%= ack.dancer_name %></span>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (hasColophonPage) { %>
        <div class="tcb-page tcb-page-colophon">
          <div class="tcb-eyebrow">Presented by</div>
          <span class="tcb-colo-coin"<%- logoVars.length ? ' style="' + logoVars.join('; ') + '"' : '' %>>
            <img src="<%= award.logo_url %>" alt="<%= award.org_name %> logo">
          </span>
          <div class="tcb-colo-org"><%= award.org_name %></div>
          <% if (lci.colophon_message) { %>
            <div class="tcb-colo-msg">&ldquo;<%= lci.colophon_message %>&rdquo;</div>
          <% } %>
          <div class="tcb-event"><%= formatEventTitle(award.event_name, award.org_name, award.event_year) %></div>
        </div>
      <% } %>

      <% if (design === 'flipbook' && pageCount > 1) { %>
        <button class="tcb-arrow tcb-arrow-prev" type="button" aria-label="Previous page" title="Previous page"
          onclick="event.stopPropagation(); tcbNav(this, -1);">&lsaquo;</button>
        <button class="tcb-arrow tcb-arrow-next" type="button" aria-label="Next page" title="Next page"
          onclick="event.stopPropagation(); tcbNav(this, 1);">&rsaquo;</button>
        <div class="tcb-dots" aria-hidden="true">
          <% for (let i = 0; i < pageCount; i++) { %>
            <button class="tcb-dot <%= i === 0 ? 'active' : '' %>" type="button" tabindex="-1"
              onclick="event.stopPropagation(); tcbGo(this, <%= i %>);"></button>
          <% } %>
        </div>
      <% } %>

      <% if (!editMode) { %>
        <%
          // "won 4th" but "was named Winner" / "were named Miss Mini Dance"
          const shareVerb = /^\d/.test(placeText) ? 'won' : (isGroup ? 'were named' : 'was named');
          const shareBits = [dancer.name, isGroup ? 'and teammates' : null, shareVerb, placeText];
          if (award.performance_name) shareBits.push(`with "${award.performance_name}"`);
          shareBits.push('at ' + formatEventTitle(award.event_name, award.org_name, award.event_year), '🏆');
        %>
        <button class="tcb-share" type="button" aria-label="Share this award" title="Share this award"
          data-share-text="<%= shareBits.filter(Boolean).join(' ') %>"
          onclick="event.stopPropagation(); shareAwardCard(this);">
          <svg viewBox="0 0 24 24" width="13" height="13" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
        </button>
      <% } %>
      <div class="tcb-brand">AwardHome</div>
    </div>
  </div>
</div>
