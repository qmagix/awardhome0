<%- include('partials/header') %>
<div class="container" style="max-width: 1000px; margin-top: 2rem; margin-bottom: 4rem;">
  <div class="header-section">
    <h1>Card Content Review</h1>
    <p class="subtitle">Approve dancer photos and thank-you notes before they appear on public flip-book award cards.</p>
    <a href="/admin" class="btn btn-outline" style="margin-top: 1rem;">&larr; Back to Admin</a>
  </div>

  <div class="card glass-card" style="margin-bottom: 2rem;">
    <% if (flaggedLive && flaggedLive.length) { %>
    <div class="card glass-card" style="margin-bottom: 1.5rem; border-color: rgba(224, 179, 87, 0.5);">
      <h2 style="color: var(--primary); margin-bottom: 0.5rem;">⚑ Viewer Flags on Live Content (<%= flaggedLive.length %>)</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;">
        This content was previously reinstated after review, so new flags no longer take it down
        automatically — you decide. <strong>Keep</strong> dismisses the flags; <strong>Remove</strong> unpublishes.</p>
      <% flaggedLive.forEach(function(f) { %>
        <div style="display: flex; align-items: center; gap: 1rem; padding: 0.6rem 0; border-top: 1px solid var(--border-color);" data-flag-row>
          <span style="color: var(--text-muted); font-size: 0.8rem; min-width: 90px;"><%= f.content_type %> · <%= f.flag_count %> flag<%= f.flag_count > 1 ? 's' : '' %></span>
          <% if (f.content_type === 'ack') { %>
            <span style="flex: 1;">&ldquo;<%= f.content_preview %>&rdquo;</span>
          <% } else { %>
            <img src="<%= f.content_preview %>" style="height: 48px; border-radius: 6px;" alt="flagged photo">
            <span style="flex: 1;"></span>
          <% } %>
          <button class="btn btn-primary" onclick="resolveFlag(this, '<%= f.content_type %>', <%= f.content_id %>, 'keep')">Keep</button>
          <button class="btn" style="border: 1px solid #c0392b; color: #e57368;" onclick="resolveFlag(this, '<%= f.content_type %>', <%= f.content_id %>, 'remove')">Remove</button>
        </div>
      <% }); %>
    </div>
    <% } %>

    <h2 style="color: var(--primary); margin-bottom: 1rem;">📸 Pending Default Card Photos (<%= pendingPhotos.length %>)</h2>
    <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">One per dancer — the fallback shown on cards without their own award photo.</p>
    <% if (pendingPhotos.length === 0) { %>
      <p style="color: var(--text-muted);">Nothing waiting. 🎉</p>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% pendingPhotos.forEach(p => { %>
          <div id="photo-row-<%= p.id %>" style="display: flex; gap: 1.25rem; align-items: center; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 1rem; flex-wrap: wrap;">
            <div style="width: 90px; height: 90px; border-radius: 50%; overflow: hidden; border: 2px solid #c9a961; flex-shrink: 0;">
              <img src="<%= p.card_photo_url %>" alt="<%= p.name %>" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div style="flex: 1; min-width: 200px;">
              <a href="/dancer/<%= p.unique_id %>" target="_blank" style="color: white; font-weight: 600; text-decoration: none;"><%= p.name %></a>
              <div style="color: var(--text-muted); font-size: 0.85rem;">Uploaded by <%= p.uploader_email || 'unknown' %></div>
              <a href="<%= p.card_photo_url %>" target="_blank" style="color: var(--primary); font-size: 0.8rem;">View full size</a>
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <button class="btn btn-primary" style="font-size: 0.85rem;" onclick="moderate('photo', <%= p.id %>, 'approve', 'photo-row-<%= p.id %>')">Approve</button>
              <button class="btn btn-outline" style="font-size: 0.85rem; border-color: #ef4444; color: #ef4444;" onclick="moderate('photo', <%= p.id %>, 'reject', 'photo-row-<%= p.id %>')">Reject</button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="card glass-card" style="margin-bottom: 2rem;">
    <h2 style="color: var(--primary); margin-bottom: 1rem;">🏆 Pending Award Photos (<%= pendingAwardPhotos.length %>)</h2>
    <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">Per-award performance shots — these replace the dancer's default photo on that specific card.</p>
    <% if (pendingAwardPhotos.length === 0) { %>
      <p style="color: var(--text-muted);">Nothing waiting. 🎉</p>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% pendingAwardPhotos.forEach(p => { %>
          <div id="awphoto-row-<%= p.id %>" style="display: flex; gap: 1.25rem; align-items: center; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 1rem; flex-wrap: wrap;">
            <div style="width: 120px; height: 90px; border-radius: 6px; overflow: hidden; border: 2px solid #c9a961; flex-shrink: 0;">
              <img src="<%= p.photo_url %>" alt="Award photo" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div style="flex: 1; min-width: 200px;">
              <a href="/dancer/<%= p.unique_id %>" target="_blank" style="color: white; font-weight: 600; text-decoration: none;"><%= p.dancer_name %></a>
              <div style="color: var(--text-muted); font-size: 0.85rem;">
                on <strong><%= p.performance_name || p.award_type || 'award' %></strong>
                (<%= p.event_name || 'event' %><%= p.year ? ', ' + p.year : '' %>)
              </div>
              <div style="color: var(--text-muted); font-size: 0.8rem;">Uploaded by <%= p.uploader_email || 'unknown' %> &middot; <a href="<%= p.photo_url %>" target="_blank" style="color: var(--primary);">View full size</a></div>
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <button class="btn btn-primary" style="font-size: 0.85rem;" onclick="moderate('award-photo', <%= p.id %>, 'approve', 'awphoto-row-<%= p.id %>')">Approve</button>
              <button class="btn btn-outline" style="font-size: 0.85rem; border-color: #ef4444; color: #ef4444;" onclick="moderate('award-photo', <%= p.id %>, 'reject', 'awphoto-row-<%= p.id %>')">Reject</button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="card glass-card">
    <h2 style="color: var(--primary); margin-bottom: 1rem;">💛 Pending Thank-You Notes (<%= pendingAcks.length %>)</h2>
    <% if (pendingAcks.length === 0) { %>
      <p style="color: var(--text-muted);">Nothing waiting. 🎉</p>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% pendingAcks.forEach(a => { %>
          <div id="ack-row-<%= a.id %>" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 1rem;">
            <div style="display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
              <div style="flex: 1; min-width: 240px;">
                <div style="font-style: italic; color: #f3e5ab; margin-bottom: 0.5rem;">&ldquo;<%= a.message %>&rdquo;</div>
                <div style="font-size: 0.85rem; color: var(--text-muted);">
                  &mdash; <a href="/dancer/<%= a.unique_id %>" target="_blank" style="color: white; text-decoration: none;"><%= a.dancer_name %></a>
                  on <strong><%= a.performance_name || a.award_type || 'award' %></strong>
                  (<%= a.event_name || 'event' %><%= a.year ? ', ' + a.year : '' %>)
                </div>
                <% if (a.moderation_note) { %>
                  <% const flagged = a.moderation_note.startsWith('flagged'); %>
                  <span class="badge" style="margin-top: 0.4rem; display: inline-block; font-size: 0.72rem; <%=
                    flagged ? 'background: rgba(239, 68, 68, 0.2); color: #ef4444;'
                            : 'background: rgba(16, 185, 129, 0.2); color: #10b981;' %>">
                    🤖 <%= a.moderation_note %>
                  </span>
                <% } %>
              </div>
              <div style="display: flex; gap: 0.5rem; align-items: flex-start;">
                <button class="btn btn-primary" style="font-size: 0.85rem;" onclick="moderate('ack', <%= a.id %>, 'approve', 'ack-row-<%= a.id %>')">Approve</button>
                <button class="btn btn-outline" style="font-size: 0.85rem; border-color: #ef4444; color: #ef4444;" onclick="moderate('ack', <%= a.id %>, 'reject', 'ack-row-<%= a.id %>')">Reject</button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <% if (autoApproved && autoApproved.length > 0) { %>
    <div class="card glass-card" style="margin-top: 2rem;">
      <h2 style="color: var(--primary); margin-bottom: 0.5rem;">🤖 Recently Auto-Approved Notes (<%= autoApproved.length %>)</h2>
      <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">Trust-but-verify: the machine put these live. Revoke pulls a note (and its identical copies) off the cards.</p>
      <div style="display: flex; flex-direction: column; gap: 0.6rem;">
        <% autoApproved.forEach(a => { %>
          <div id="auto-row-<%= a.id %>" style="display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 0.75rem 1rem;">
            <div style="flex: 1; min-width: 240px; font-size: 0.9rem;">
              <span style="font-style: italic; color: #f3e5ab;">&ldquo;<%= a.message %>&rdquo;</span>
              <span style="color: var(--text-muted); font-size: 0.8rem;"> &mdash;
                <a href="/dancer/<%= a.unique_id %>" target="_blank" style="color: white; text-decoration: none;"><%= a.dancer_name %></a>
                on <%= a.performance_name || a.award_type || 'award' %> (<%= a.event_name || 'event' %><%= a.year ? ', ' + a.year : '' %>)</span>
            </div>
            <button class="btn btn-outline" style="font-size: 0.8rem; border-color: #ef4444; color: #ef4444;"
              onclick="revokeAck(<%= a.id %>, 'auto-row-<%= a.id %>')">Revoke</button>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>

<script>
  async function revokeAck(id, rowId) {
    if (!confirm('Pull this note (and identical copies) off the public cards?')) return;
    try {
      const res = await fetch('/api/admin/card-ack/' + id + '/revoke', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}'
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const row = document.getElementById(rowId);
      row.style.opacity = '0.4';
      row.style.pointerEvents = 'none';
    } catch (err) {
      alert('Failed to revoke: ' + err.message);
    }
  }

  async function moderate(kind, id, action, rowId) {
    const url = kind === 'photo' ? '/api/admin/card-photo/' + id
      : kind === 'award-photo' ? '/api/admin/card-award-photo/' + id
      : '/api/admin/card-ack/' + id;
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action })
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const row = document.getElementById(rowId);
      row.style.opacity = '0.4';
      row.style.pointerEvents = 'none';
      row.insertAdjacentHTML('beforeend',
        '<div style="width: 100%; margin-top: 0.5rem; font-size: 0.8rem; color: ' +
        (action === 'approve' ? '#10b981">✓ Approved' : '#ef4444">✗ Rejected') + '</div>');
    } catch (err) {
      alert('Failed to save decision: ' + err.message);
    }
  }
</script>

<%- include('partials/footer') %>

<script>
  async function resolveFlag(btn, type, id, action) {
    btn.disabled = true;
    const res = await fetch('/api/admin/flag-resolve', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content_type: type, content_id: id, action: action }),
    });
    if (res.ok) btn.closest('[data-flag-row]').style.opacity = '0.35';
    else { btn.disabled = false; alert('Failed — try again'); }
  }
</script>
