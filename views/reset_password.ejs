<%- include('partials/header') %>
<div class="container" style="max-width: 420px; margin-top: 4rem;">
  <div class="card glass-card" style="padding: 2.5rem;">
    <% if (expired) { %>
      <h2 style="text-align: center; margin-top: 0; color: var(--primary);">This link has expired</h2>
      <p style="color: var(--text-muted); line-height: 1.6; text-align: center;">
        Reset links work once and last an hour — for your security, this one is no longer valid.
      </p>
      <p style="text-align: center; margin-top: 1.5rem;">
        <a href="/forgot-password" style="color: var(--primary);">Send me a new link</a>
      </p>
    <% } else { %>
      <h2 style="text-align: center; margin-top: 0; color: var(--primary);">Choose a new password</h2>
      <% if (error) { %>
        <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #ef4444; padding: 1rem; border-radius: 6px; margin: 1rem 0; text-align: center;"><%= error %></div>
      <% } %>
      <form action="/reset-password/<%= token %>" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem; margin-top: 1.5rem;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div>
          <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text-muted);">New password</label>
          <input type="password" name="password" required minlength="8" autofocus placeholder="At least 8 characters"
            style="width: 100%; padding: 0.75rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.2); color: white;">
        </div>
        <div>
          <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text-muted);">Confirm new password</label>
          <input type="password" name="password_confirm" required minlength="8"
            style="width: 100%; padding: 0.75rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.2); color: white;">
        </div>
        <button type="submit" class="btn" style="background: var(--primary); color: #0a0a0a; border: none; padding: 0.75rem; font-weight: 600; border-radius: 6px; cursor: pointer;">Save new password</button>
      </form>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
