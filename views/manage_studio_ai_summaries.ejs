<%- include('partials/header') %>

<div class="container manage-layout" style="margin-top: 4rem; display: flex; gap: 2rem;">
  
  <!-- Sidebar Navigation -->
  <div class="manage-sidebar" style="width: 250px; flex-shrink: 0;">
    <div class="card glass-card" style="padding: 1.5rem; position: sticky; top: 2rem;">
      <h3 style="margin-top: 0; color: var(--primary); font-size: 1.1rem;">Management</h3>
      <ul style="list-style: none; padding: 0; margin: 1rem 0 0 0; display: flex; flex-direction: column; gap: 0.5rem;">
        <li>
          <a href="/manage/studio/<%= studio.id %>" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            👤 Profile & Customization
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/roster" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            👥 Dancer Roster
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/group-dancers" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            🎭 Check Routine Dancers<% if (typeof missingRoutinesCount !== 'undefined' && missingRoutinesCount > 0) { %> <span style="background: rgba(245,158,11,0.2); color: #fbbf24; border-radius: 10px; padding: 0.05rem 0.5rem; font-size: 0.75rem; font-weight: 700;"><%= missingRoutinesCount %></span><% } %>
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/routines" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            🗂 All Routines
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/history" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            📊 Organization History
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/awards" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            🏆 Awards Editor
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/widget" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            📈 Widget Builder
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/verifications" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            ✅ Pending Verifications
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/ai-summaries" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: white; background: rgba(212, 175, 55, 0.1); border-left: 3px solid var(--primary); font-weight: 600;">
            ✨ AI Summaries
          </a>
        </li>
      </ul>
      
      <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.1);">
        <a href="/dance/studio/<%= studio.unique_id %>" style="color: var(--primary); text-decoration: none; font-size: 0.9rem;">&larr; Back to Public Profile</a>
      </div>
    </div>
  </div>

  <!-- Main Content Area -->
  <div style="flex-grow: 1;">
    <div class="header-section" style="margin-bottom: 2rem;">
      <h1>AI Summaries Library</h1>
      <p class="subtitle">View and manage all of the marketing copy previously generated by your AI assistant.</p>
    </div>

    <div class="card glass-card" style="padding: 2rem;">
      <% if (groupedSummaries.length === 0) { %>
        <div style="text-align: center; padding: 3rem 0; color: var(--text-muted);">
          <div style="font-size: 3rem; margin-bottom: 1rem;">✨</div>
          <h3>No AI Summaries Yet</h3>
          <p>Generate your first AI marketing summary by visiting the <a href="/manage/studio/<%= studio.id %>/history" style="color: var(--primary);">Organization History</a> tab!</p>
        </div>
      <% } else { %>
        <% groupedSummaries.forEach(orgGroup => { %>
          <div style="margin-bottom: 3rem;">
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.1);">
              <% if (orgGroup.org_logo) { %>
                <img src="<%= orgGroup.org_logo %>" alt="<%= orgGroup.org_name %>" style="height: 30px; border-radius: 4px;">
              <% } else { %>
                <div style="width: 30px; height: 30px; border-radius: 4px; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--text-muted); font-size: 0.8rem;"><%= orgGroup.org_name.substring(0, 2).toUpperCase() %></div>
              <% } %>
              <h2 style="margin: 0; color: white;"><%= orgGroup.org_name %></h2>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
              <% orgGroup.items.forEach(summary => { %>
                <div style="background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 1.5rem; position: relative;">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                    <div>
                      <span style="background: rgba(255, 255, 255, 0.08); color: #e0e0e0; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; font-weight: bold;">
                        Tone: <%= summary.tone %>
                      </span>
                      <div style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.5rem;">
                        Generated on <%= new Date(summary.created_at).toLocaleDateString() %>
                      </div>
                    </div>
                    <button class="btn btn-sm btn-primary" onclick="copyToClipboard('summary_<%= summary.id %>')" id="btn_copy_<%= summary.id %>">
                      📋 Copy
                    </button>
                  </div>
                  
                  <textarea id="summary_<%= summary.id %>" style="width: 100%; min-height: 150px; padding: 1rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px; font-family: inherit; resize: vertical;" readonly><%= summary.user_edited_response %></textarea>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<script>
function copyToClipboard(elementId) {
  const textarea = document.getElementById(elementId);
  textarea.select();
  document.execCommand('copy');
  
  const btnId = 'btn_copy_' + elementId.split('_')[1];
  const btn = document.getElementById(btnId);
  const oldText = btn.innerText;
  btn.innerText = '✅ Copied!';
  setTimeout(() => btn.innerText = oldText, 2000);
}
</script>

<%- include('partials/footer') %>
