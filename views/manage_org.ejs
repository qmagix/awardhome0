<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Organization: <%= org.name %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="dashboard-body">
    <%- include('partials/header') %>

    <div class="dashboard-container container">
        <aside class="dashboard-sidebar">
            <div class="sidebar-org-profile">
                <% if (org.logo_url) { %>
                    <img src="<%= org.logo_url %>" alt="<%= org.name %> Logo" class="sidebar-logo">
                <% } else { %>
                    <div class="sidebar-avatar-placeholder"><%= org.name.substring(0, 2).toUpperCase() %></div>
                <% } %>
                <h2><%= org.name %></h2>
                <span class="badge badge-premium" style="margin-top: 0.5rem;">Verified Organizer</span>
            </div>
            
            <nav class="sidebar-nav">
                <a href="/manage/org/<%= org.id %>" class="active" style="margin-bottom: 0;">Overview</a>
                <div class="sub-nav">
                    <a href="#stats-section" class="sub-nav-link active-sub" onclick="showTab('stats-section'); return false;">↳ Stats & Examples</a>
                    <a href="#marketing-profile" class="sub-nav-link" onclick="showTab('marketing-profile'); return false;">↳ Marketing Profile</a>
                    <a href="#upload-section" class="sub-nav-link" onclick="showTab('upload-section'); return false;">↳ Upload Results</a>
                    <a href="#past-events" class="sub-nav-link" onclick="showTab('past-events'); return false;">↳ Past Events</a>
                    <a href="#upcoming-events" class="sub-nav-link" onclick="showTab('upcoming-events'); return false;">↳ Upcoming Events</a>
                </div>
                <a href="/manage/org/<%= org.id %>/branding" style="margin-top: 1rem;">Branding & Icons</a>
                <a href="/faq/organizer" class="text-muted" style="margin-top: 2rem;">Organizer FAQ</a>
            </nav>
        </aside>

        <main class="dashboard-content">
            <header class="dashboard-header">
                <% if (!onboarding.hasData && !onboarding.hasUpload) { %>
                    <h1>Welcome to AwardHome 🎉</h1>
                    <p class="text-muted">Your organizer account is live. One upload is all it takes to get <%= org.name %>'s results onto dancer and studio pages across the platform.</p>
                <% } else { %>
                    <h1>Organizer Overview</h1>
                    <p class="text-muted">Welcome to your dashboard. Upload results directly to instantly update dancer portfolios across the platform.</p>
                <% } %>
            </header>

            <% if (!onboarding.complete) { %>
            <section class="card glass-card" style="margin-bottom: 2rem; border-color: rgba(212, 175, 55, 0.45); background: linear-gradient(145deg, rgba(212, 175, 55, 0.08) 0%, rgba(0,0,0,0.25) 100%);">
                <div class="card-body" style="padding: 1.5rem 1.75rem;">
                    <h2 style="margin: 0 0 0.35rem; font-size: 1.15rem; color: var(--accent-gold);">
                        <%= (!onboarding.hasData && !onboarding.hasUpload) ? 'Get set up in three steps' : 'Finish setting up ' + org.name %>
                    </h2>
                    <p class="text-muted" style="margin: 0 0 1.25rem; font-size: 0.9rem;">
                        Everything here is concierge — you send, our team does the rest.
                    </p>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem;">

                        <div style="border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 1.1rem 1.2rem; <%= (onboarding.hasData || onboarding.hasUpload) ? 'opacity: 0.75;' : 'border-color: rgba(212, 175, 55, 0.5);' %>">
                            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; color: <%= (onboarding.hasData || onboarding.hasUpload) ? '#10b981' : 'var(--accent-gold)' %>; margin-bottom: 0.4rem;">
                                <%= onboarding.hasData ? '✓ RESULTS LIVE' : (onboarding.hasUpload ? '✓ UPLOADED — WE\'RE ON IT' : 'STEP 1 · START HERE' ) %>
                            </div>
                            <h3 style="margin: 0 0 0.4rem; font-size: 1rem;">Upload your results</h3>
                            <p class="text-muted" style="margin: 0 0 0.8rem; font-size: 0.85rem; line-height: 1.5;">
                                One event or your entire history at once — any format, even a zipped archive or a database export. We parse, verify, and publish, usually within a few days.
                            </p>
                            <% if (!onboarding.hasData && !onboarding.hasUpload) { %>
                                <button class="btn btn-primary" style="padding: 0.45rem 1rem; font-size: 0.85rem;" onclick="showTab('upload-section')">Upload results</button>
                            <% } else if (!onboarding.hasData) { %>
                                <button class="btn btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem;" onclick="showTab('upload-section')">Upload another event</button>
                            <% } %>
                        </div>

                        <div style="border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 1.1rem 1.2rem; <%= onboarding.hasProfile ? 'opacity: 0.75;' : '' %>">
                            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; color: <%= onboarding.hasProfile ? '#10b981' : 'var(--text-muted)' %>; margin-bottom: 0.4rem;">
                                <%= onboarding.hasProfile ? '✓ DONE' : 'STEP 2' %>
                            </div>
                            <h3 style="margin: 0 0 0.4rem; font-size: 1rem;">Tell studios who you are</h3>
                            <p class="text-muted" style="margin: 0 0 0.8rem; font-size: 0.85rem; line-height: 1.5;">
                                Slogan, description, and your registration link — shown on your public page to every studio and family browsing results.
                            </p>
                            <% if (!onboarding.hasProfile) { %>
                                <button class="btn btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem;" onclick="showTab('marketing-profile')">Set up profile</button>
                            <% } %>
                        </div>

                        <div style="border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 1.1rem 1.2rem; <%= onboarding.hasLogo ? 'opacity: 0.75;' : '' %>">
                            <div style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; color: <%= onboarding.hasLogo ? '#10b981' : 'var(--text-muted)' %>; margin-bottom: 0.4rem;">
                                <%= onboarding.hasLogo ? (onboarding.logoApproved ? '✓ LIVE ON CARDS' : '✓ UPLOADED — BEING FITTED') : 'STEP 3' %>
                            </div>
                            <h3 style="margin: 0 0 0.4rem; font-size: 1rem;">Your brand on every card</h3>
                            <p class="text-muted" style="margin: 0 0 0.8rem; font-size: 0.85rem; line-height: 1.5;">
                                Upload your logo and our design team hand-fits it into the gold coin on every award card dancers share.
                            </p>
                            <% if (!onboarding.hasLogo) { %>
                                <a href="/manage/org/<%= org.id %>/branding" class="btn btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem; text-decoration: none; display: inline-block;">Upload logo</a>
                            <% } %>
                        </div>

                    </div>
                </div>
            </section>
            <% } %>

            <div id="stats-section" class="dashboard-tab">
                <section class="stats-grid">
                    <div class="stat-card">
                        <h3>Total Awards Distributed</h3>
                        <div class="stat-value"><%= stats.total_awards ? stats.total_awards.toLocaleString() : 0 %></div>
                    </div>
                    <div class="stat-card">
                        <h3>Total Studios Attended</h3>
                        <div class="stat-value"><%= stats.total_studios ? stats.total_studios.toLocaleString() : 0 %></div>
                    </div>
                    <% if (rank > 1) { %>
                    <div class="stat-card" style="border-top: 4px solid var(--accent-gold);">
                        <h3>Platform Ranking</h3>
                        <div class="stat-value">#<%= rank %></div>
                        <div class="stat-trend" style="color: var(--accent-gold);">Largest Organization</div>
                    </div>
                    <% } %>
                </section>

                <section class="card glass-card" style="margin-top: 2rem;">
                    <div class="card-header">
                        <h2>Live Mockups</h2>
                        <p class="text-muted">See how your organization's awards look on dancer and studio portfolios.</p>
                    </div>
                    <div class="card-body" style="display: flex; gap: 1rem; flex-wrap: wrap;">
                        <% if (topDancer) { %>
                            <a href="/dancer/<%= topDancer.unique_id %>" target="_blank" class="btn btn-outline">
                                View Dancer Mockup (<%= topDancer.name %>)
                            </a>
                        <% } %>
                        <% if (topStudio) { %>
                            <a href="/dance/studio/<%= topStudio.unique_id %>" target="_blank" class="btn btn-outline">
                                View Studio Mockup (<%= topStudio.name %>)
                            </a>
                        <% } %>
                    </div>
                </section>
            </div>

            <section id="marketing-profile" class="card glass-card dashboard-tab" style="display: none; margin-top: 2rem; border-color: var(--primary); background: linear-gradient(145deg, rgba(79, 70, 229, 0.1) 0%, rgba(0,0,0,0.2) 100%);">
                <div class="card-header">
                    <h2 style="color: var(--primary);">Marketing Profile</h2>
                    <p class="text-muted">Enhance your public organization page with a marketing slogan and description to attract studios and dancers.</p>
                </div>
                <div class="card-body">
                    <form action="/manage/org/<%= org.id %>/marketing" method="POST" class="upload-form">
                        <div class="form-group">
                            <label>Slogan (Short Marketing Tagline)</label>
                            <input type="text" name="slogan" placeholder="e.g. 'The Most Prestigious Dance Tour'" value="<%= org.slogan || '' %>" class="form-control" style="background: rgba(0,0,0,0.3); color: white;">
                        </div>
                        <div class="form-group" style="margin-top: 1rem;">
                            <label>Event Description</label>
                            <textarea name="description" rows="4" placeholder="Describe what makes your competition special..." class="form-control" style="background: rgba(0,0,0,0.3); color: white; resize: vertical;"><%= org.description || '' %></textarea>
                        </div>
                        <div class="form-group" style="margin-top: 1rem;">
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Website / Registration Link</label>
                            <input type="text" name="website" placeholder="e.g. https://yourcompetition.com/register" value="<%= org.website || '' %>" class="form-control" style="background: rgba(0,0,0,0.3); color: white;">
                            <small style="color: var(--text-muted);">Shown on your public page so dancers and studios can register for your events.</small>
                        </div>
                        <button type="submit" class="btn save-btn" style="margin-top: 1rem;">Save Marketing Profile</button>
                    </form>
                </div>
            </section>

            <section id="upload-section" class="card glass-card dashboard-tab" style="display: none; margin-top: 2rem;">
                <div class="card-header">
                    <h2>Upload Event Results</h2>
                    <p class="text-muted">Send results in whatever format your scoring system produces. Our team will parse, verify, and publish them to dancer and studio portfolios.</p>
                </div>
                <div class="card-body">
                    <div style="background: rgba(212, 175, 55, 0.08); border: 1px solid rgba(212, 175, 55, 0.35); padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem;">
                        <h4 style="margin: 0 0 0.5rem 0; color: var(--accent-gold);">Years of history? No need to send events one by one — all at once works great</h4>
                        <p style="margin: 0; font-size: 0.9rem; color: var(--text-muted); line-height: 1.5;">
                            Zip your entire results archive (any folder structure, any mix of formats) and upload it
                            as a single file — put something like <em>"Full archive 2019&ndash;2025"</em> as the event name.
                            Or skip the form entirely: email <a href="mailto:hello@awardhome.com?subject=Results archive" style="color: var(--accent-gold);">hello@awardhome.com</a>
                            a Google Drive or Dropbox link. Our team and parsing scripts handle the splitting,
                            matching, and publishing — that's the whole point of the concierge model.
                        </p>
                    </div>
                    <div style="background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.3); padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 2rem;">
                        <h4 style="margin: 0 0 0.5rem 0; color: #eab308;">What to include — results go live fastest in this shape</h4>
                        <p style="margin: 0 0 0.5rem 0; font-size: 0.9rem; color: var(--text-muted);">
                            One row per routine per award, with these columns:
                        </p>
                        <p style="margin: 0 0 0.5rem 0; font-size: 0.9rem;">
                            <strong>Required:</strong> Event Name, Event Date, Routine Name, Placement / Award, Category or Style, Age Division, Dancer Name(s), Studio
                        </p>
                        <p style="margin: 0 0 1rem 0; font-size: 0.9rem; color: var(--text-muted);">
                            <strong>Great to have:</strong> Award Type (Overall / Adjudicated / Special / Title), Entry Number, Scores.
                            Full dancer names (not initials) and consistent studio spellings help us match records correctly the first time.
                        </p>
                        <!-- Data-URI template so we don't need a static file -->
                        <a href="data:text/csv;charset=utf-8,Event Name,Event Date,Routine Name,Placement,Award Type,Category/Style,Age Division,Dancers,Studio,Entry Number%0ABaltimore Nationals,May 10-12 2026,Jazz Hands,1st Overall,Overall,Jazz,Junior,%22John Doe, Jane Smith%22,Starlight Dance Academy,112" download="template_org_results.csv" class="btn" style="background: transparent; border: 1px solid #eab308; color: #eab308; padding: 0.5rem 1rem; text-decoration: none; font-size: 0.9rem;">Download CSV Template</a>
                        <p style="margin: 1rem 0 0 0; font-size: 0.85rem; color: var(--text-muted);">
                            This is the ideal, not a requirement — if all you have is PDFs or a database export (SQL dump, SQLite, Access), upload that and we'll take it from there.
                        </p>
                    </div>
                    <form action="/manage/org/<%= org.id %>/upload" method="POST" enctype="multipart/form-data" class="upload-form">
                        <div class="form-group">
                            <label>Event Name (e.g. Baltimore Nationals — or "Full archive 2019–2025" for a bulk zip)</label>
                            <input type="text" name="event_name" required>
                        </div>
                        <div class="form-group" style="display: flex; gap: 1rem;">
                            <div style="flex: 1;">
                                <label>Date</label>
                                <input type="text" name="event_date" placeholder="May 10-12, 2025" required>
                            </div>
                            <div style="flex: 1;">
                                <label>Location</label>
                                <input type="text" name="event_location" placeholder="Baltimore, MD" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Results File (CSV, TXT, Excel, PDF, SQL dump, SQLite/Access database, or ZIP — up to 50 MB)</label>
                            <input type="file" name="results_file" accept=".csv,.txt,.xlsx,.xls,.pdf,.sql,.sqlite,.sqlite3,.db,.mdb,.accdb,.zip" required>
                            <small style="color: var(--text-muted);">Larger than 50 MB — or easier for you another way? Zip it, or simply email
                            <a href="mailto:hello@awardhome.com?subject=Results for processing" style="color: var(--accent-gold);">hello@awardhome.com</a>
                            with a Google Drive or Dropbox link and we'll take it from there.</small>
                        </div>
                        <button type="submit" class="btn btn-primary" style="width: 100%;">Upload & Process</button>
                    </form>

                    <% if (uploads && uploads.length > 0) { %>
                        <h3 style="margin-top: 2rem; margin-bottom: 1rem;">Recent Uploads</h3>
                        <table class="data-table" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>Event</th>
                                    <th>Date Uploaded</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% uploads.forEach(u => { %>
                                    <tr>
                                        <td><strong><%= u.event_name %></strong> <span class="text-muted">(<%= u.event_location %>)</span></td>
                                        <td><%= new Date(u.created_at).toLocaleDateString() %></td>
                                        <td>
                                            <% if (u.status === 'pending') { %>
                                                <span class="badge" style="background: rgba(234, 179, 8, 0.2); color: #eab308;">AI Processing Soon</span>
                                            <% } else if (u.status === 'processed') { %>
                                                <span class="badge badge-premium">Processed</span>
                                            <% } else { %>
                                                <span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #ef4444;"><%= u.status %></span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
            </section>

    <section id="past-events" class="card glass-card dashboard-tab" style="display: none; margin-top: 2rem;">
        <div class="card-header">
            <h2>Published Events</h2>
            <p class="text-muted">Search by year, city, or event name to locate specific results.</p>
        </div>
        <div class="card-body">
            <% if (events && events.length > 0) { %>
                <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
                    <div style="flex: 1;">
                        <label style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.25rem; display: block;">Year (Optional)</label>
                        <input type="number" id="eventSearchYear" placeholder="e.g. 2025" class="form-control" style="width: 100%; padding: 0.75rem 1rem; border-radius: 8px; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.2); color: white; font-size: 1rem;">
                    </div>
                    <div style="flex: 2;">
                        <label style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.25rem; display: block;">Location / Event Name</label>
                        <input type="text" id="eventSearchLocation" placeholder="e.g. San Jose" class="form-control" style="width: 100%; padding: 0.75rem 1rem; border-radius: 8px; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.2); color: white; font-size: 1rem;">
                    </div>
                </div>
                
                <p id="searchPromptMessage" style="color: var(--text-muted); margin-top: 1rem; text-align: center;">There are <%= events.length %> total events. Enter a year and type at least 3 letters of the location to display results.</p>

                <table class="data-table" id="eventTable" style="width: 100%; display: none;">
                    <thead>
                        <tr>
                            <th>Year</th>
                            <th>Event Name</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="eventTableBody">
                        <% events.forEach((e) => { %>
                            <tr class="event-row" data-year="<%= e.year %>" data-search="<%= (e.name + ' ' + (e.date_string || '')).toLowerCase() %>">
                                <td><%= e.year %></td>
                                <td><%= e.name %> <%= e.date_string ? '(' + e.date_string + ')' : '' %></td>
                                <td><a href="/dance/event/<%= e.id %>" target="_blank" class="btn btn-outline" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;">View Public Page</a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
                <p id="noEventsMessage" style="display: none; color: var(--text-muted); margin-top: 1rem; text-align: center;">No events match your search.</p>

                <script>
                    const searchYear = document.getElementById('eventSearchYear');
                    const searchLocation = document.getElementById('eventSearchLocation');
                    const table = document.getElementById('eventTable');
                    const promptMsg = document.getElementById('searchPromptMessage');
                    const noMatchMsg = document.getElementById('noEventsMessage');
                    const rows = document.querySelectorAll('.event-row');

                    function filterEvents() {
                        const yearVal = searchYear.value.trim();
                        const locVal = searchLocation.value.toLowerCase().trim();

                        // Require at least 3 characters in location to show anything
                        if (locVal.length < 3) {
                            table.style.display = 'none';
                            promptMsg.style.display = 'block';
                            noMatchMsg.style.display = 'none';
                            return;
                        }

                        // Hide prompt, prepare table
                        promptMsg.style.display = 'none';
                        let visibleCount = 0;

                        rows.forEach(row => {
                            const rowYear = row.getAttribute('data-year');
                            const rowSearch = row.getAttribute('data-search');
                            
                            let yearMatch = true;
                            if (yearVal !== '') {
                                yearMatch = (rowYear === yearVal);
                            }

                            let locMatch = rowSearch.includes(locVal);

                            if (yearMatch && locMatch) {
                                row.style.display = '';
                                visibleCount++;
                            } else {
                                row.style.display = 'none';
                            }
                        });

                        if (visibleCount === 0) {
                            noMatchMsg.style.display = 'block';
                            table.style.display = 'none';
                        } else {
                            noMatchMsg.style.display = 'none';
                            table.style.display = 'table';
                        }
                    }

                    searchYear.addEventListener('input', filterEvents);
                    searchLocation.addEventListener('input', filterEvents);
                </script>
            <% } else { %>
                <p>No past events found.</p>
            <% } %>
        </div>
    </section>

    <section id="upcoming-events" class="card glass-card dashboard-tab" style="display: none; margin-top: 2rem;">
        <div class="card-header">
            <h2>Upcoming Events</h2>
            <p class="text-muted">Your tour dates, shown on your public page and in the studio-facing
                <a href="/dance/events" target="_blank" style="color: var(--accent-gold);">Upcoming Events directory</a>
                — where studios and parents plan their competition season, sorted by distance from them, with
                shortlists and calendar export. A complete, current schedule is what turns browsers into
                bookings — dates you enter here are authoritative and always override anything our team imported.</p>
            <p class="text-muted" style="margin-top: 0.5rem;">
                <span style="color: var(--accent-gold);">✦ Gold Register buttons:</span> your first one is
                <strong>free</strong> — place it on any event below (you can move it anytime) and that event's
                Register button appears in featured gold in the directory. Additional gold buttons are available
                per event starting <strong>October 15, 2026</strong> — email
                <a href="mailto:hello@awardhome.com?subject=Gold Register buttons" style="color: var(--accent-gold);">hello@awardhome.com</a>.
                Placement changes emphasis only; listing order is not sponsored.</p>
        </div>
        <div class="card-body">
            <form id="upcomingForm" action="/manage/org/<%= org.id %>/upcoming" method="POST"
                  style="background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 1.25rem; margin-bottom: 2rem;">
                <h4 id="upcomingFormTitle" style="margin: 0 0 1rem 0;">Add an event</h4>
                <div style="display: grid; grid-template-columns: 2fr 1.2fr 0.6fr; gap: 1rem;">
                    <div class="form-group" style="margin: 0;">
                        <label>Event Name *</label>
                        <input type="text" name="name" required maxlength="120" placeholder="e.g. Regional — Dallas" class="form-control">
                    </div>
                    <div class="form-group" style="margin: 0;">
                        <label>City</label>
                        <input type="text" name="city" maxlength="80" placeholder="e.g. Dallas" class="form-control">
                    </div>
                    <div class="form-group" style="margin: 0;">
                        <label>State</label>
                        <input type="text" name="state" maxlength="2" placeholder="TX" class="form-control" style="text-transform: uppercase;">
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 1rem; margin-top: 1rem;">
                    <div class="form-group" style="margin: 0;">
                        <label>Start Date *</label>
                        <input type="date" name="start_date" required class="form-control">
                    </div>
                    <div class="form-group" style="margin: 0;">
                        <label>End Date</label>
                        <input type="date" name="end_date" class="form-control">
                    </div>
                    <div class="form-group" style="margin: 0;">
                        <label>Venue</label>
                        <input type="text" name="venue" maxlength="120" placeholder="e.g. Gaylord Texan Convention Center" class="form-control">
                    </div>
                </div>
                <div class="form-group" style="margin: 1rem 0 0 0;">
                    <label>Registration Link</label>
                    <input type="text" name="registration_url" maxlength="300" placeholder="https://..." class="form-control">
                </div>
                <div style="margin-top: 1.25rem; display: flex; gap: 0.75rem;">
                    <button type="submit" class="btn btn-primary" id="upcomingSubmitBtn">Add Event</button>
                    <button type="button" class="btn btn-outline" id="upcomingCancelEdit" style="display: none;" onclick="resetUpcomingForm()">Cancel Edit</button>
                </div>
            </form>

            <% if (upcomingEvents && upcomingEvents.length > 0) { %>
                <table class="data-table" style="width: 100%;">
                    <thead>
                        <tr><th>Dates</th><th>Event</th><th>Location</th><th>Register</th><th>Gold</th><th style="width: 130px;">Actions</th></tr>
                    </thead>
                    <tbody>
                        <% upcomingEvents.forEach((ev) => { %>
                            <% const past = (ev.end_date || ev.start_date) < new Date().toISOString().slice(0, 10); %>
                            <tr style="<%= past ? 'opacity: 0.45;' : '' %>"
                                data-ev='<%- JSON.stringify({ id: ev.id, name: ev.name, city: ev.city, state: ev.state, venue: ev.venue, start_date: ev.start_date, end_date: ev.end_date, registration_url: ev.registration_url }).replace(/'/g, "&#39;") %>'>
                                <td style="white-space: nowrap;"><%= ev.start_date %><%= ev.end_date ? ' → ' + ev.end_date : '' %><%= past ? ' (past)' : '' %></td>
                                <td><%= ev.name %><% if (ev.venue) { %><br><small class="text-muted"><%= ev.venue %></small><% } %></td>
                                <td><%= [ev.city, ev.state].filter(Boolean).join(', ') %></td>
                                <td><% if (ev.registration_url) { %><a href="<%= ev.registration_url %>" target="_blank" rel="noopener" style="color: var(--accent-gold);">Link</a><% } %></td>
                                <td style="white-space: nowrap;">
                                    <% if (ev.gold === 'free') { %>
                                        <span style="color: var(--accent-gold); font-size: 0.8rem;" title="Your free gold button — move it by placing it on another event">✦ Free gold</span>
                                    <% } else if (ev.gold === 'paid') { %>
                                        <span style="color: var(--accent-gold); font-size: 0.8rem;">✦ Gold</span>
                                    <% } else if (!past) { %>
                                        <form action="/manage/org/<%= org.id %>/upcoming/<%= ev.id %>/gold" method="POST" style="display: inline;">
                                            <input type="hidden" name="action" value="free">
                                            <button type="submit" class="btn btn-outline" style="padding: 0.2rem 0.45rem; font-size: 0.72rem;"
                                                title="Place your free gold button on this event — it stays with the event through show day, then you can place it on your next one">Use free gold</button>
                                        </form>
                                    <% } %>
                                    <% if (user && ['admin', 'superadmin'].includes(user.role)) { %>
                                        <% if (ev.gold !== 'paid') { %>
                                        <form action="/manage/org/<%= org.id %>/upcoming/<%= ev.id %>/gold" method="POST" style="display: inline;">
                                            <input type="hidden" name="action" value="paid">
                                            <button type="submit" class="btn btn-outline" style="padding: 0.2rem 0.45rem; font-size: 0.72rem;" title="Admin: mark as purchased gold">$→✦</button>
                                        </form>
                                        <% } %>
                                        <% if (ev.gold) { %>
                                        <form action="/manage/org/<%= org.id %>/upcoming/<%= ev.id %>/gold" method="POST" style="display: inline;">
                                            <input type="hidden" name="action" value="clear">
                                            <button type="submit" class="btn btn-outline" style="padding: 0.2rem 0.45rem; font-size: 0.72rem;" title="Admin: remove gold">✕</button>
                                        </form>
                                        <% } %>
                                    <% } %>
                                </td>
                                <td style="white-space: nowrap;">
                                    <button type="button" class="btn btn-outline" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;" onclick="editUpcoming(this)">Edit</button>
                                    <form action="/manage/org/<%= org.id %>/upcoming/<%= ev.id %>/delete" method="POST" style="display: inline;"
                                          onsubmit="return confirm('Remove this event from your public listings?');">
                                        <button type="submit" class="btn btn-outline" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; border-color: #b91c1c; color: #ef4444;">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p class="text-muted">No upcoming events listed yet. Add your first tour stop above — it appears on your public page and in the directory studios browse when picking next season's competitions.</p>
            <% } %>

            <script>
                const upcomingForm = document.getElementById('upcomingForm');
                const upcomingAddAction = upcomingForm.action;
                function editUpcoming(btn) {
                    const ev = JSON.parse(btn.closest('tr').getAttribute('data-ev'));
                    upcomingForm.action = '/manage/org/<%= org.id %>/upcoming/' + ev.id + '/update';
                    for (const f of ['name', 'city', 'state', 'venue', 'start_date', 'end_date', 'registration_url']) {
                        upcomingForm.elements[f].value = ev[f] || '';
                    }
                    document.getElementById('upcomingFormTitle').textContent = 'Edit: ' + ev.name;
                    document.getElementById('upcomingSubmitBtn').textContent = 'Save Changes';
                    document.getElementById('upcomingCancelEdit').style.display = '';
                    upcomingForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                function resetUpcomingForm() {
                    upcomingForm.action = upcomingAddAction;
                    upcomingForm.reset();
                    document.getElementById('upcomingFormTitle').textContent = 'Add an event';
                    document.getElementById('upcomingSubmitBtn').textContent = 'Add Event';
                    document.getElementById('upcomingCancelEdit').style.display = 'none';
                }
            </script>
        </div>
    </section>

        </main>
    </div>

    <script>
        function showTab(tabId) {
            // Hide all tabs
            document.querySelectorAll('.dashboard-tab').forEach(el => el.style.display = 'none');
            // Show targeted tab
            const target = document.getElementById(tabId);
            if (target) {
                target.style.display = 'block';
            }
            
            // Update active state in sidebar
            document.querySelectorAll('.sidebar-nav .sub-nav-link').forEach(link => {
                link.classList.remove('active-sub');
                link.style.color = 'var(--text-muted)';
                link.style.fontWeight = 'normal';
            });
            const activeLink = document.querySelector(`a[href="#${tabId}"]`);
            if (activeLink) {
                activeLink.classList.add('active-sub');
                activeLink.style.color = 'white';
                activeLink.style.fontWeight = '600';
            }
        }

        <% if (initialTab) { %>
        // Deep-linked tab (navbar "My Events" and friends) wins over the
        // fresh-org default below.
        document.addEventListener('DOMContentLoaded', () => showTab('<%= initialTab %>'));
        <% } else if (!onboarding.hasData && !onboarding.hasUpload) { %>
        // Fresh org: the useful first screen is the upload form, not an
        // empty stats grid — open it directly (the welcome checklist above
        // it explains the rest).
        document.addEventListener('DOMContentLoaded', () => showTab('upload-section'));
        <% } %>

        // Initialize first sub-nav state
        document.addEventListener('DOMContentLoaded', () => {
            const firstLink = document.querySelector('.sub-nav-link.active-sub');
            if (firstLink) {
                firstLink.style.color = 'white';
                firstLink.style.fontWeight = '600';
            }
        });
    </script>

    <style>
        .dashboard-container {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }
        .dashboard-sidebar {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 2rem 1.5rem;
            height: fit-content;
            position: sticky;
            top: 2rem;
        }
        .sidebar-org-profile {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        .sidebar-logo, .sidebar-avatar-placeholder {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            margin-bottom: 1rem;
            object-fit: cover;
            border: 2px solid var(--accent-gold);
        }
        .sidebar-avatar-placeholder {
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: bold;
            color: white;
        }
        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .sidebar-nav a {
            padding: 0.75rem 1rem;
            border-radius: 8px;
            color: var(--text-light);
            text-decoration: none;
            transition: all 0.2s ease;
            font-weight: 500;
        }
        .sidebar-nav a:hover, .sidebar-nav a.active {
            background: rgba(255, 255, 255, 0.1);
            color: white;
        }
        .sub-nav {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            padding-left: 1.5rem;
            margin-bottom: 0.5rem;
        }
        .sub-nav a {
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
            color: var(--text-muted);
            border-radius: 6px;
        }
        .sub-nav a:hover {
            background: rgba(255,255,255,0.05);
            color: white;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-top: 1.5rem;
        }
        .stat-card {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(8px);
            border-radius: 16px;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.5);
            border-color: rgba(255, 255, 255, 0.3);
        }
        .stat-card h3 {
            font-size: 1rem;
            color: #cbd5e1;
            margin-bottom: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .stat-value {
            font-size: 3rem;
            font-weight: 800;
            color: #ffffff;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        }
        .upload-form .form-group {
            margin-bottom: 1.5rem;
        }
        .upload-form label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: var(--text-muted);
        }
        .upload-form input, .upload-form textarea {
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            font-family: inherit;
        }
        .upload-form input:focus, .upload-form textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.2);
        }
        @media (max-width: 768px) {
            .dashboard-container {
                grid-template-columns: 1fr;
            }
            .dashboard-sidebar {
                position: static;
            }
        }
    </style>
</body>
</html>
