  .faq-section ul { margin-left: 1.5rem; margin-top: 0.5rem; color: #555; }
  .faq-section p { line-height: 1.6; color: #444; }

  .badge-common { display: inline-block; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.85rem; margin-right: 0.5rem; }
  .pending { background-color: #ffeeba; color: #856404; }
  .link-active { background-color: #cce5ff; color: #004085; }
</style>

