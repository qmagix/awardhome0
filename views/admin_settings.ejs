<%- include('partials/header') %>
<div class="container" style="max-width: 1000px; margin-top: 2rem; margin-bottom: 4rem;">
  <div class="header-section">
    <h1>System Settings</h1>
    <p class="subtitle">Superadmin control panel for global platform configurations.</p>
    <a href="/admin" class="btn btn-outline" style="margin-top: 1rem;">&larr; Back to Admin</a>
  </div>

  <div class="card glass-card" style="margin-bottom: 2rem;">
    <h2 style="color: var(--primary); margin-bottom: 1rem;">AI Model Configuration</h2>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;">
      Select the underlying OpenAI model used to generate marketing summaries across the platform. This change takes effect instantly without requiring a server reboot.
    </p>

    <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
      <!-- GPT-4o Mini -->
      <label style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer;">
        <input type="radio" name="openai_model" value="gpt-4o-mini" <%= settings['openai_model'] === 'gpt-4o-mini' ? 'checked' : '' %> style="margin-top: 0.3rem;">
        <div>
          <div style="font-weight: bold; color: white; margin-bottom: 0.25rem;">gpt-4o-mini <span style="background: rgba(16, 185, 129, 0.2); color: #10b981; font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.5rem;">Recommended</span></div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">
            Cost: 🟢 Very Low | Speed: ⚡️ Very Fast | Quality: Good<br>
            Perfect for generating standard marketing summaries at high volume and low cost.
          </div>
        </div>
      </label>

      <!-- GPT-4o -->
      <label style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer;">
        <input type="radio" name="openai_model" value="gpt-4o" <%= settings['openai_model'] === 'gpt-4o' ? 'checked' : '' %> style="margin-top: 0.3rem;">
        <div>
          <div style="font-weight: bold; color: white; margin-bottom: 0.25rem;">gpt-4o</div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">
            Cost: 🔴 High | Speed: ⏱️ Moderate | Quality: 🌟 Excellent<br>
            High-intelligence flagship model. Use sparingly for premium users or complex reasoning tasks.
          </div>
        </div>
      </label>
      
      <!-- o1-mini -->
      <label style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer;">
        <input type="radio" name="openai_model" value="o1-mini" <%= settings['openai_model'] === 'o1-mini' ? 'checked' : '' %> style="margin-top: 0.3rem;">
        <div>
          <div style="font-weight: bold; color: white; margin-bottom: 0.25rem;">o1-mini <span style="background: rgba(59, 130, 246, 0.2); color: #60a5fa; font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.5rem;">New</span></div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">
            Cost: 🟡 Medium | Speed: ⏱️ Moderate | Quality: 🌟 Advanced<br>
            Fast, cost-effective reasoning model. Excellent for complex multi-step instructions.
          </div>
        </div>
      </label>

      <!-- o3-mini -->
      <label style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer;">
        <input type="radio" name="openai_model" value="o3-mini" <%= settings['openai_model'] === 'o3-mini' ? 'checked' : '' %> style="margin-top: 0.3rem;">
        <div>
          <div style="font-weight: bold; color: white; margin-bottom: 0.25rem;">o3-mini <span style="background: rgba(255, 255, 255, 0.08); color: #e0e0e0; font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.5rem;">Latest</span></div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">
            Cost: 🟡 Medium | Speed: ⚡️ Fast | Quality: 🌟 State-of-the-Art<br>
            The newest cost-effective reasoning model. Best balance of speed, cost, and high intelligence.
          </div>
        </div>
      </label>

      <!-- GPT-3.5 Turbo -->
      <label style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer;">
        <input type="radio" name="openai_model" value="gpt-3.5-turbo" <%= settings['openai_model'] === 'gpt-3.5-turbo' ? 'checked' : '' %> style="margin-top: 0.3rem;">
        <div>
          <div style="font-weight: bold; color: white; margin-bottom: 0.25rem;">gpt-3.5-turbo</div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">
            Cost: 🟢 Very Low | Speed: ⚡️ Fast | Quality: Fair<br>
            Legacy fallback model. Not recommended unless other models are experiencing outages.
          </div>
        </div>
      </label>
    </div>

    <button id="btnSaveAi" class="btn btn-primary" onclick="saveAiModel()">💾 Save Configuration</button>
    <span id="saveAiStatus" style="margin-left: 1rem; color: #10b981; display: none;">✅ Saved successfully!</span>
  </div>

  <div class="card glass-card" style="margin-bottom: 2rem;">
    <h2 style="color: var(--primary); margin-bottom: 1rem;">Award Card Design</h2>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;">
      Which card design public dancer pages render (A/B probe — visitors can preview either
      variant with <code>?card_design=classic</code> / <code>?card_design=flipbook</code> /
      <code>?card_design=rafters</code> on a dancer page;
      <code>?card_design=default</code> clears their session override). Takes effect instantly.
    </p>

    <% const cardDesign = settings['card_design'] || 'classic'; %>
    <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
      <label style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer;">
        <input type="radio" name="card_design" value="classic" <%= cardDesign === 'classic' ? 'checked' : '' %> style="margin-top: 0.3rem;">
        <div>
          <div style="font-weight: bold; color: white; margin-bottom: 0.25rem;">Classic <span style="background: rgba(255,255,255,0.08); color: #e0e0e0; font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.5rem;">Original</span></div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">
            Two faces: trophy front, certificate back with the share button.
          </div>
        </div>
      </label>

      <label style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer;">
        <input type="radio" name="card_design" value="flipbook" <%= cardDesign === 'flipbook' ? 'checked' : '' %> style="margin-top: 0.3rem;">
        <div>
          <div style="font-weight: bold; color: white; margin-bottom: 0.25rem;">Flip-book <span style="background: rgba(139, 92, 246, 0.2); color: #c4b5fd; font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.5rem;">New</span></div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">
            The back becomes a paged mini-book: certificate &rarr; photo &rarr; thank-you notes &rarr; organizer colophon.
            Pages appear only when their approval-gated content exists (see <a href="/admin/card-content" style="color: var(--primary);">Card Content Review</a>).
          </div>
        </div>
      </label>
      <label style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer;">
        <input type="radio" name="card_design" value="rafters" <%= cardDesign === 'rafters' ? 'checked' : '' %> style="margin-top: 0.3rem;">
        <div>
          <div style="font-weight: bold; color: white; margin-bottom: 0.25rem;">Rafters <span style="background: rgba(212, 175, 55, 0.2); color: #f3e5ab; font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.5rem;">Engraved</span></div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">
            The classic anatomy reskinned in the Rafters design language: engraved stage-black front,
            gold hairlines and base strip, Cinzel display type. Same certificate back, no flipbook pages.
          </div>
        </div>
      </label>
    </div>

    <button id="btnSaveCard" class="btn btn-primary" onclick="saveCardDesign()">💾 Save Card Design</button>
    <span id="saveCardStatus" style="margin-left: 1rem; color: #10b981; display: none;">✅ Saved successfully!</span>
  </div>

  <div class="card glass-card" style="margin-bottom: 2rem;">
    <h2 style="color: var(--primary); margin-bottom: 1rem;">Card Content Moderation</h2>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;">
      How thank-you notes are reviewed. The pipeline (rules &rarr; trusted authors &rarr; OpenAI
      Moderation API) only runs when the <a href="/admin/features" style="color: var(--primary);">auto_moderation
      feature flag</a> is enabled; photos always stay human-reviewed. Machine failures never
      auto-approve — notes just fall back to the queue.
    </p>

    <% const modMode = settings['moderation_mode'] || 'manual'; %>
    <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
      <label style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer;">
        <input type="radio" name="moderation_mode" value="manual" <%= modMode === 'manual' ? 'checked' : '' %> style="margin-top: 0.3rem;">
        <div>
          <div style="font-weight: bold; color: white; margin-bottom: 0.25rem;">Manual</div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">Every note waits for human review (launch default).</div>
        </div>
      </label>
      <label style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer;">
        <input type="radio" name="moderation_mode" value="assisted" <%= modMode === 'assisted' ? 'checked' : '' %> style="margin-top: 0.3rem;">
        <div>
          <div style="font-weight: bold; color: white; margin-bottom: 0.25rem;">Assisted</div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">Machine verdicts (🤖 machine-clean / flagged + reason) appear in the review queue, but a human still clicks every approval.</div>
        </div>
      </label>
      <label style="display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer;">
        <input type="radio" name="moderation_mode" value="auto" <%= modMode === 'auto' ? 'checked' : '' %> style="margin-top: 0.3rem;">
        <div>
          <div style="font-weight: bold; color: white; margin-bottom: 0.25rem;">Auto <span style="background: rgba(16, 185, 129, 0.2); color: #10b981; font-size: 0.7rem; padding: 0.1rem 0.4rem; border-radius: 4px; margin-left: 0.5rem;">Sustainable</span></div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">Machine-clean notes go live instantly; flagged notes queue for review. A "Recently Auto-Approved" feed on the review page allows one-click revoke.</div>
        </div>
      </label>
    </div>

    <button id="btnSaveMod" class="btn btn-primary" onclick="saveSetting('moderation_mode', 'btnSaveMod', 'saveModStatus')">💾 Save Moderation Mode</button>
    <span id="saveModStatus" style="margin-left: 1rem; color: #10b981; display: none;">✅ Saved successfully!</span>
  </div>
</div>

<script>
async function saveSetting(key, btnId, statusId) {
  const selected = document.querySelector(`input[name="${key}"]:checked`).value;
  const btn = document.getElementById(btnId);
  const status = document.getElementById(statusId);
  btn.disabled = true;
  try {
    const res = await fetch('/api/admin/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key, value: selected })
    });
    if (res.ok) {
      status.style.display = 'inline';
      setTimeout(() => status.style.display = 'none', 3000);
    } else {
      alert('Failed to save settings');
    }
  } catch (err) {
    alert('Network error while saving settings');
  } finally {
    btn.disabled = false;
  }
}
</script>

<script>
async function saveCardDesign() {
  const selected = document.querySelector('input[name="card_design"]:checked').value;
  const btn = document.getElementById('btnSaveCard');
  const status = document.getElementById('saveCardStatus');
  btn.disabled = true;
  try {
    const res = await fetch('/api/admin/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key: 'card_design', value: selected })
    });
    if (res.ok) {
      status.style.display = 'inline';
      setTimeout(() => status.style.display = 'none', 3000);
    } else {
      alert('Failed to save settings');
    }
  } catch (err) {
    alert('Network error while saving settings');
  } finally {
    btn.disabled = false;
  }
}
</script>

<script>
async function saveAiModel() {
  const selectedModel = document.querySelector('input[name="openai_model"]:checked').value;
  const btn = document.getElementById('btnSaveAi');
  const status = document.getElementById('saveAiStatus');
  
  btn.disabled = true;
  btn.innerText = 'Saving...';
  
  try {
    const res = await fetch('/api/admin/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key: 'openai_model', value: selectedModel })
    });
    
    if (res.ok) {
      status.style.display = 'inline';
      setTimeout(() => status.style.display = 'none', 3000);
    } else {
      alert('Failed to save settings');
    }
  } catch (err) {
    alert('Network error while saving settings');
  } finally {
    btn.disabled = false;
    btn.innerText = '💾 Save Configuration';
  }
}
</script>

<%- include('partials/footer') %>
