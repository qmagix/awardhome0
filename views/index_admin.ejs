<%- include('partials/header') %>
<nav class="section-nav" aria-label="Page sections">
  <div class="section-nav-inner">
    <a href="#competitions">Competitions</a>
    <a href="#leaderboards">Leaderboards</a>
  </div>
</nav>
<section class="hero">
  <div style="margin-bottom: 1rem;"><span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4); font-size: 0.9rem;">👑 Admin View</span></div>
  <h1>Discover the Stars</h1>
  <p>Explore award-winning studios and dancers from top competitions.</p>
  <%- include('partials/hero_search') %>
</section>
<div class="container">
  <h2 id="competitions" class="anchor-section">Competitions & Organizations</h2>
  <div class="grid" style="margin-bottom: 3rem;">
    <% orgs.forEach(function(org) { %>
      <a href="/dance/org/<%= org.slug %>" class="card glass-card hover-zoom" style="border-color: rgba(212, 175, 55, 0.3);">
        <h3><%= org.name %></h3>
        <div style="margin-bottom: 1.5rem; color: var(--text-muted); font-size: 0.9rem;">
          <span class="badge" style="background: rgba(255, 255, 255, 0.1);"><%= org.event_count || 0 %> Events</span>
          <% if (org.event_count > 0) { %>
            <span style="font-size: 0.8rem;">(Since <%= org.data_since %>)</span>
          <% } %>
        </div>
        <span class="btn btn-outline">View Events &rarr;</span>
      </a>
    <% }); %>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <h2 id="leaderboards" class="anchor-section" style="margin: 0;">🏆 Global Leaderboards</h2>
    <div class="view-toggle" style="display: flex; gap: 0.5rem; background: rgba(0,0,0,0.3); padding: 0.3rem; border-radius: 8px;">
      <button id="btn-studios" class="btn btn-primary btn-sm" onclick="setLeaderboardView('studios')" style="border-radius: 6px;">Top Studios</button>
      <button id="btn-dancers" class="btn btn-outline btn-sm" onclick="setLeaderboardView('dancers')" style="border-radius: 6px; border: none;">Top Dancers</button>
    </div>
  </div>
  
  <!-- STUDIOS LEADERBOARD -->
  <div id="leaderboard-studios-wrapper">
  
  <div class="tabs-container" style="margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); overflow-x: auto;">
    <ul class="year-tabs">
      <li class="tab-item active" data-target="leaderboard-alltime">All-Time (Past 5 Years)</li>
      <li class="tab-item" data-target="leaderboard-thisyear">This Year</li>
      <li class="tab-item" data-target="leaderboard-firstplaces-thisyear">1st Places This Year</li>
    </ul>
  </div>

  <div class="tab-pane active" id="leaderboard-alltime">
    <div class="card glass-card" style="padding: 0; overflow: hidden; margin-bottom: 4rem;">
      <div style="display: flex; padding: 1rem 1.5rem; background: rgba(0,0,0,0.3); border-bottom: 1px solid rgba(255,255,255,0.1); font-weight: bold; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase;">
        <div style="width: 60px; text-align: center;">Rank</div>
        <div style="flex-grow: 1;">Studio Name</div>
        <div style="width: 100px; text-align: right;">Total Awards</div>
      </div>
      
      <%- include('partials/leaderboard_rows', { rows: topStudios.slice(0, previewCount), type: 'studio', offset: 0 }) %>
      <% if (topStudios.length > previewCount) { %>
        <div class="lb-more"><button class="btn btn-outline btn-sm" onclick="loadFullBoard(this, 'studios-alltime')">Show all <%= topStudios.length %></button></div>
      <% } %>
    </div>
  </div>

  <div class="tab-pane" id="leaderboard-thisyear">
    <div class="card glass-card" style="padding: 0; overflow: hidden; margin-bottom: 4rem;">
      <div style="display: flex; padding: 1rem 1.5rem; background: rgba(0,0,0,0.3); border-bottom: 1px solid rgba(255,255,255,0.1); font-weight: bold; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase;">
        <div style="width: 60px; text-align: center;">Rank</div>
        <div style="flex-grow: 1;">Studio Name</div>
        <div style="width: 100px; text-align: right;">Awards</div>
      </div>
      
      <%- include('partials/leaderboard_rows', { rows: topStudiosThisYear.slice(0, previewCount), type: 'studio', offset: 0 }) %>
      <% if (topStudiosThisYear.length > previewCount) { %>
        <div class="lb-more"><button class="btn btn-outline btn-sm" onclick="loadFullBoard(this, 'studios-thisyear')">Show all <%= topStudiosThisYear.length %></button></div>
      <% } %>
    </div>
  </div>

  <div class="tab-pane" id="leaderboard-firstplaces-thisyear">
    <div class="card glass-card" style="padding: 0; overflow: hidden; margin-bottom: 4rem;">
      <div style="display: flex; padding: 1rem 1.5rem; background: rgba(0,0,0,0.3); border-bottom: 1px solid rgba(255,255,255,0.1); font-weight: bold; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase;">
        <div style="width: 60px; text-align: center;">Rank</div>
        <div style="flex-grow: 1;">Studio Name</div>
        <div style="width: 100px; text-align: right;">1st Places</div>
      </div>
      
      <%- include('partials/leaderboard_rows', { rows: topStudiosFirstPlaceThisYear.slice(0, previewCount), type: 'studio', offset: 0 }) %>
      <% if (topStudiosFirstPlaceThisYear.length > previewCount) { %>
        <div class="lb-more"><button class="btn btn-outline btn-sm" onclick="loadFullBoard(this, 'studios-firstplaces')">Show all <%= topStudiosFirstPlaceThisYear.length %></button></div>
      <% } %>
    </div>
  </div>
  </div>

  <!-- DANCERS LEADERBOARD -->
  <div id="leaderboard-dancers-wrapper" style="display: none;">
    <div class="tabs-container" style="margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); overflow-x: auto;">
      <ul class="year-tabs">
        <li class="tab-item active" data-target="leaderboard-dancer-alltime">All-Time</li>
        <li class="tab-item" data-target="leaderboard-dancer-thisyear">This Year</li>
        <li class="tab-item" data-target="leaderboard-dancer-firstplaces-thisyear">1st Places This Year</li>
      </ul>
    </div>

    <!-- Dancer All Time -->
    <div class="tab-pane active" id="leaderboard-dancer-alltime">
      <div class="card glass-card" style="padding: 0; overflow: hidden; margin-bottom: 4rem;">
        <div style="display: flex; padding: 1rem 1.5rem; background: rgba(0,0,0,0.3); border-bottom: 1px solid rgba(255,255,255,0.1); font-weight: bold; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase;">
          <div style="width: 60px; text-align: center;">Rank</div>
          <div style="width: 50px;"></div>
          <div style="flex-grow: 1;">Dancer Name</div>
          <div style="width: 100px; text-align: right;">Total Awards</div>
        </div>
        
        <%- include('partials/leaderboard_rows', { rows: topDancers.slice(0, previewCount), type: 'dancer', offset: 0 }) %>
      <% if (topDancers.length > previewCount) { %>
        <div class="lb-more"><button class="btn btn-outline btn-sm" onclick="loadFullBoard(this, 'dancers-alltime')">Show all <%= topDancers.length %></button></div>
      <% } %>
      </div>
    </div>

    <!-- Dancer This Year -->
    <div class="tab-pane" id="leaderboard-dancer-thisyear">
      <div class="card glass-card" style="padding: 0; overflow: hidden; margin-bottom: 4rem;">
        <div style="display: flex; padding: 1rem 1.5rem; background: rgba(0,0,0,0.3); border-bottom: 1px solid rgba(255,255,255,0.1); font-weight: bold; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase;">
          <div style="width: 60px; text-align: center;">Rank</div>
          <div style="width: 50px;"></div>
          <div style="flex-grow: 1;">Dancer Name</div>
          <div style="width: 100px; text-align: right;">Awards</div>
        </div>
        
        <%- include('partials/leaderboard_rows', { rows: topDancersThisYear.slice(0, previewCount), type: 'dancer', offset: 0 }) %>
      <% if (topDancersThisYear.length > previewCount) { %>
        <div class="lb-more"><button class="btn btn-outline btn-sm" onclick="loadFullBoard(this, 'dancers-thisyear')">Show all <%= topDancersThisYear.length %></button></div>
      <% } %>
      </div>
    </div>

    <!-- Dancer 1st Places -->
    <div class="tab-pane" id="leaderboard-dancer-firstplaces-thisyear">
      <div class="card glass-card" style="padding: 0; overflow: hidden; margin-bottom: 4rem;">
        <div style="display: flex; padding: 1rem 1.5rem; background: rgba(0,0,0,0.3); border-bottom: 1px solid rgba(255,255,255,0.1); font-weight: bold; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase;">
          <div style="width: 60px; text-align: center;">Rank</div>
          <div style="width: 50px;"></div>
          <div style="flex-grow: 1;">Dancer Name</div>
          <div style="width: 100px; text-align: right;">1st Places</div>
        </div>
        
        <%- include('partials/leaderboard_rows', { rows: topDancersFirstPlaceThisYear.slice(0, previewCount), type: 'dancer', offset: 0 }) %>
      <% if (topDancersFirstPlaceThisYear.length > previewCount) { %>
        <div class="lb-more"><button class="btn btn-outline btn-sm" onclick="loadFullBoard(this, 'dancers-firstplaces')">Show all <%= topDancersFirstPlaceThisYear.length %></button></div>
      <% } %>
      </div>
    </div>
  </div>
</div>

<script>
async function loadFullBoard(btn, board) {
  btn.disabled = true; btn.textContent = 'Loading\u2026';
  try {
    const res = await fetch('/dance/leaderboard/' + board);
    if (!res.ok) throw new Error('fetch failed');
    const holder = btn.closest('.lb-more');
    holder.insertAdjacentHTML('beforebegin', await res.text());
    holder.remove();
  } catch (e) { btn.disabled = false; btn.textContent = 'Show all'; }
}

function setLeaderboardView(viewMode) {
  const btnStudios = document.getElementById('btn-studios');
  const btnDancers = document.getElementById('btn-dancers');
  const wrapStudios = document.getElementById('leaderboard-studios-wrapper');
  const wrapDancers = document.getElementById('leaderboard-dancers-wrapper');

  if (viewMode === 'studios') {
    wrapStudios.style.display = 'block';
    wrapDancers.style.display = 'none';
    btnStudios.classList.add('btn-primary');
    btnStudios.classList.remove('btn-outline');
    btnStudios.style.border = 'none';
    btnDancers.classList.add('btn-outline');
    btnDancers.classList.remove('btn-primary');
    btnDancers.style.border = 'none';
  } else {
    wrapStudios.style.display = 'none';
    wrapDancers.style.display = 'block';
    btnDancers.classList.add('btn-primary');
    btnDancers.classList.remove('btn-outline');
    btnDancers.style.border = 'none';
    btnStudios.classList.add('btn-outline');
    btnStudios.classList.remove('btn-primary');
    btnStudios.style.border = 'none';
  }
}
</script>



<%- include('partials/footer') %>
