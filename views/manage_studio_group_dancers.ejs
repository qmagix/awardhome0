<%- include('partials/header') %>

<div class="container manage-layout" style="margin-top: 4rem; display: flex; gap: 2rem;">

  <!-- Sidebar Navigation -->
  <div class="manage-sidebar" style="width: 250px; flex-shrink: 0;">
    <div class="card glass-card" style="padding: 1.5rem; position: sticky; top: 2rem;">
      <h3 style="margin-top: 0; color: var(--primary); font-size: 1.1rem;">Management</h3>
      <ul style="list-style: none; padding: 0; margin: 1rem 0 0 0; display: flex; flex-direction: column; gap: 0.5rem;">
        <li>
          <a href="/manage/studio/<%= studio.id %>" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            👤 Profile & Customization
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/roster" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            👥 Dancer Roster
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/group-dancers" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: white; background: rgba(212, 175, 55, 0.1); border-left: 3px solid var(--primary); font-weight: 600;">
            🎭 Check Routine Dancers<% if (typeof missingRoutinesCount !== 'undefined' && missingRoutinesCount > 0) { %> <span style="background: rgba(245,158,11,0.2); color: #fbbf24; border-radius: 10px; padding: 0.05rem 0.5rem; font-size: 0.75rem; font-weight: 700;"><%= missingRoutinesCount %></span><% } %>
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/routines" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            🗂 All Routines
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/history" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            📊 Organization History
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/awards" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            🏆 Awards Editor
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/widget" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            📈 Widget Builder
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/verifications" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            ✅ Pending Verifications
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/ai-summaries" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            ✨ AI Summaries
          </a>
        </li>
      </ul>

      <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.1);">
        <a href="/dance/studio/<%= studio.unique_id %>" style="color: var(--primary); text-decoration: none; font-size: 0.9rem;">&larr; Back to Public Profile</a>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div style="flex: 1; min-width: 0; margin-bottom: 4rem;">
    <div class="header-section" style="margin-bottom: 1rem;">
      <h1 style="margin-bottom: 0.25rem;">🎭 Check Routine Dancers<% if (typeof missingRoutinesCount !== 'undefined' && missingRoutinesCount > 0) { %> <span style="background: rgba(245,158,11,0.2); color: #fbbf24; border-radius: 10px; padding: 0.05rem 0.5rem; font-size: 0.75rem; font-weight: 700;"><%= missingRoutinesCount %></span><% } %></h1>
      <p class="subtitle" style="margin: 0;">
        Routines with awards that aren't credited to dancers yet — usually because the
        competition never published the names. List each routine's cast so every dancer
        gets these wins on their own trophy case; if nothing is actually missing (say,
        a solo whose competition never printed the name), mark it complete.
      </p>
    </div>

    <% if (totalCount === 0) { %>
      <div class="card glass-card" style="padding: 2.5rem; text-align: center;">
        <p style="margin: 0; color: var(--text-muted);">No routines found for your studio yet.</p>
      </div>
    <% } else { %>
      <div class="card glass-card" style="padding: 1rem 1.5rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 240px;">
          <% if (openCount === 0) { %>
            <strong style="color: #34d399;">🎉 All <%= totalCount %> routines are checked</strong>
            <span style="color: var(--text-muted);">— nothing waiting.</span>
          <% } else { %>
            <strong style="color: #fbbf24;"><%= openCount %></strong>
            <span style="color: var(--text-muted);">of <%= totalCount %> routines still to check · <%= doneCount %> done.</span>
          <% } %>
          <div style="margin-top: 0.25rem;">
            <% if (showAll) { %>
              <a href="/manage/studio/<%= studio.id %>/group-dancers" style="color: var(--primary); font-size: 0.85rem;">Show only routines needing attention</a>
            <% } else { %>
              <a href="/manage/studio/<%= studio.id %>/group-dancers?all=1" style="color: var(--primary); font-size: 0.85rem;">Show all <%= totalCount %> routines<%= legacyCount > 0 ? ' (including completed & ' + legacyCount + ' legacy)' : ' (including completed)' %></a>
            <% } %>
          </div>
        </div>
        <small style="color: var(--text-muted);">Paste names — one per line or comma-separated — then preview before anything saves.</small>
      </div>
      <% if (routines.length === 0 && openCount === 0) { %>
        <div class="card glass-card" style="padding: 2rem; text-align: center;">
          <p style="margin: 0; color: var(--text-muted);">Nothing needs attention — every routine either has its dancers or was marked complete. 🎉</p>
        </div>
      <% } %>

      <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin: -0.5rem 0 1.5rem 0.25rem; font-size: 0.8rem; color: var(--text-muted);">
        <span><span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: rgba(212,175,55,0.5); vertical-align: middle;"></span> from competition results</span>
        <span>👤 added by your studio</span>
        <span><span style="color: #60a5fa;">✓</span> claimed by dancer, verified</span>
        <span>⏳ dancer claim awaiting your verification</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% routines.forEach((r, i) => { %>
          <%- include('partials/gd_routine_card', { r, studio, autoOpen: r.cast.length === 0 && i < 3 }) %>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/gd_modals') %>
<script src="/js/ui_dialogs.js"></script>
<script src="/js/gd_card.js"></script>

<%- include('partials/footer') %>
