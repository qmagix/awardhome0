<%- include('partials/header') %>

<div class="container" style="margin-top: 4rem; max-width: 900px; padding-bottom: 4rem;">

  <div class="header-section" style="margin-bottom: 2rem;">
    <h1>Add a missing award</h1>
    <p class="subtitle">
      For <strong><%= dancer.name %></strong>. Competitions don't always publish everything —
      when something is missing, you can add it here. It stays private to you until a
      reviewer confirms it.
    </p>
    <p style="margin: 0.5rem 0 0;">
      <a href="/manage/dancer/<%= dancer.id %>" style="color: var(--primary); text-decoration: none;">&larr; Back to <%= dancer.name %>'s profile</a>
    </p>
  </div>

  <% if (typeof independentPublish !== 'undefined' && independentPublish && independentPublish !== 'approved') { %>
    <div class="card glass-card" style="margin-bottom: 1.5rem; border-left: 3px solid var(--gold-vivid);">
      <p style="margin: 0 0 0.5rem;"><strong>This is a private record for now.</strong></p>
      <p style="margin: 0 0 0.75rem; color: var(--text-muted); font-size: 0.92rem;">
        <%= dancer.name %> dances independently, so there is no studio director to confirm awards.
        Everything you add is kept for you and stays private — nobody else can see it. It goes public
        automatically if another family records the same result, or when AwardHome reviews the record
        and approves it. Keep adding: nothing is lost by entering the rest now.
      </p>
      <% if (independentPublish === 'requested') { %>
        <p style="margin: 0; color: var(--text-muted); font-size: 0.92rem;">
          ✓ You&rsquo;ve asked AwardHome to review this record. We&rsquo;ll email you.
        </p>
      <% } else { %>
        <form method="POST" action="/manage/dancer/<%= dancer.id %>/publish-request" style="margin: 0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-primary" style="padding: 0.5rem 1.1rem;">
            Ask AwardHome to publish this record
          </button>
        </form>
      <% } %>
    </div>
  <% } %>

  <% if (notice) { %>
    <div class="card glass-card" style="margin-bottom: 1.5rem; border-left: 3px solid #6bbf6b;">
      <p style="margin: 0;"><%= notice %></p>
    </div>
  <% } %>

  <% if (errors && errors.length) { %>
    <div class="card glass-card" style="margin-bottom: 1.5rem; border-left: 3px solid #d98a8a;">
      <p style="margin: 0 0 0.5rem; font-weight: 600;">We couldn't save that yet:</p>
      <ul style="margin: 0; padding-left: 1.2rem;">
        <% errors.forEach(function (e) { %><li><%= e %></li><% }); %>
      </ul>
    </div>
  <% } %>

  <div class="card glass-card">
    <form method="POST" action="/manage/dancer/<%= dancer.id %>/submissions"
          style="display: flex; flex-direction: column; gap: 1.5rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <!-- One key per rendered form: a double-click or a refresh-resend returns
           the original submission instead of creating a second award. -->
      <input type="hidden" name="client_submission_id" value="<%= clientSubmissionId %>">

      <!-- Studio: DERIVED from affiliation, never typed. -->
      <div>
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Studio</label>
        <% if (affiliations.length === 0) { %>
          <p style="margin: 0; padding: 0.75rem; background: rgba(0,0,0,0.3); border-radius: 6px;">
            Dancing independently — no studio on this award.
          </p>
        <% } else if (affiliations.length === 1) { %>
          <p style="margin: 0; padding: 0.75rem; background: rgba(0,0,0,0.3); border-radius: 6px;">
            <%= affiliations[0].is_independent ? 'Independent' : affiliations[0].name %>
          </p>
        <% } else { %>
          <select name="studio_id" required
                  style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
            <option value="">Which studio was this routine danced for?</option>
            <% affiliations.forEach(function (s) { %>
              <option value="<%= s.id %>" <%= String(form.studio_id) === String(s.id) ? 'selected' : '' %>>
                <%= s.is_independent ? 'Independent' : s.name %>
              </option>
            <% }); %>
          </select>
        <% } %>
        <p style="margin: 0.4rem 0 0; font-size: 0.8rem; color: var(--text-muted);">
          Taken from <%= dancer.name %>'s studio affiliations — you never have to type it.
          A studio switch doesn't rewrite history: past awards keep the studio they were danced for.
        </p>
      </div>

      <!-- Event picker: organizer tour stops (geocoded, one tap), other
           families' candidates, then canonical events by name. A family may
           create an event, but only ever as a candidate — never a canonical
           `events` row. -->
      <div>
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Competition *</label>

        <!-- Exactly one of these three carries the answer. -->
        <input type="hidden" name="event_id" id="eventId" value="<%= form.event_id || '' %>">
        <input type="hidden" name="event_candidate_id" id="eventCandidateId" value="<%= form.event_candidate_id || '' %>">
        <input type="hidden" name="upcoming_event_id" id="upcomingEventId" value="<%= form.upcoming_event_id || '' %>">

        <div id="eventChosen" style="<%= chosenEvent ? '' : 'display: none;' %> padding: 0.75rem; background: rgba(212,175,55,0.1); border: 1px solid rgba(212,175,55,0.35); border-radius: 6px;">
          <strong id="eventChosenName"><%= chosenEvent ? chosenEvent.name : '' %></strong>
          <span id="eventChosenMeta" style="color: var(--text-muted);"><%= chosenEvent && chosenEvent.when ? ' · ' + chosenEvent.when : '' %><%= chosenEvent && chosenEvent.note ? ' · ' + chosenEvent.note : '' %></span>
          <button type="button" id="eventClear" class="btn btn-outline" style="margin-left: 0.75rem; padding: 0.2rem 0.6rem; font-size: 0.8rem;">Change</button>
        </div>

        <div id="eventPicker" style="<%= chosenEvent ? 'display: none;' : '' %>">
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; margin-bottom: 0.5rem;">
            <button type="button" id="nearMe" class="btn btn-outline" style="padding: 0.5rem 0.9rem;">📍 Events near me</button>
            <input type="date" id="eventDate" title="Competition date"
                   style="padding: 0.6rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
            <span style="color: var(--text-muted); font-size: 0.85rem;">or search by name:</span>
          </div>
          <input type="text" id="eventSearch" autocomplete="off" placeholder="Start typing a competition or event name…"
                 style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
          <p id="pickerStatus" style="margin: 0.4rem 0 0; font-size: 0.8rem; color: var(--text-muted);"></p>
          <div id="eventResults" style="margin-top: 0.5rem; display: none; max-height: 280px; overflow-y: auto; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.15); border-radius: 6px;"></div>

          <p style="margin: 0.75rem 0 0; font-size: 0.85rem; color: var(--text-muted);">
            Genuinely not there?
            <button type="button" id="toggleCreate" class="btn btn-outline" style="padding: 0.2rem 0.6rem; font-size: 0.8rem;">Add the event</button>
          </p>

          <!-- Create an event candidate. Not part of the award form: it posts
               on its own so the half-filled award beside it keeps its state. -->
          <div id="createEvent" style="display: none; margin-top: 0.75rem; padding: 1rem; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.12); border-radius: 6px;">
            <p style="margin: 0 0 0.75rem; font-size: 0.85rem; color: var(--text-muted);">
              Whatever you add here becomes selectable by other families at the same event straight
              away, so nobody has to add it twice. It is marked "added by a family" until a reviewer
              confirms it.
            </p>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem;">
              <input type="text" id="ceName" placeholder="Event name *" maxlength="140"
                     style="padding: 0.6rem; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
              <input type="date" id="ceStart" title="First day *"
                     style="padding: 0.6rem; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
              <input type="date" id="ceEnd" title="Last day (optional)"
                     style="padding: 0.6rem; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
              <input type="text" id="ceCity" placeholder="City" maxlength="80"
                     style="padding: 0.6rem; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
              <input type="text" id="ceState" placeholder="State (2 letters)" maxlength="2"
                     style="padding: 0.6rem; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
              <input type="text" id="ceVenue" placeholder="Venue (optional)" maxlength="140"
                     style="padding: 0.6rem; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
              <select id="ceOrg" style="padding: 0.6rem; background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
                <option value="">Competition company (if you know it)</option>
                <% orgs.forEach(function (o) { %><option value="<%= o.id %>"><%= o.name %></option><% }); %>
              </select>
            </div>
            <div id="ceDuplicates" style="display: none; margin-top: 0.75rem;"></div>
            <p id="ceErrors" style="margin: 0.6rem 0 0; font-size: 0.85rem; color: #f3b0b0;"></p>
            <button type="button" id="ceSubmit" class="btn btn-primary" style="margin-top: 0.75rem; padding: 0.5rem 1rem;">Add this event</button>
          </div>
        </div>
      </div>

      <div>
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Routine name *</label>
        <input type="text" name="performance_name" required maxlength="200" value="<%= form.performance_name || '' %>"
               placeholder="e.g. Fireworks"
               style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
      </div>

      <!-- Group size decides how the award is recorded. Required, always. -->
      <div>
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Routine size *</label>
        <select name="group_size" id="groupSize" required
                style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
          <option value="">Choose one…</option>
          <% groupSizes.forEach(function (g) { %>
            <option value="<%= g.key %>" data-enumerable="<%= g.enumerable ? 1 : 0 %>"
                    <%= form.group_size === g.key ? 'selected' : '' %>><%= g.label %></option>
          <% }); %>
        </select>
        <p style="margin: 0.4rem 0 0; font-size: 0.8rem; color: var(--text-muted);">
          This one matters: it's how we know a group routine is a group, even when only
          your dancer is listed on it.
        </p>
      </div>

      <div id="castBlock" style="display: none;">
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Who else danced it?</label>
        <textarea name="cast_names" rows="3" placeholder="One name per line — optional"
                  style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;"><%= form.cast_names || '' %></textarea>
        <label style="display: flex; gap: 0.6rem; align-items: flex-start; margin-top: 0.6rem; cursor: pointer;">
          <input type="checkbox" name="cast_complete" value="1" <%= form.cast_complete ? 'checked' : '' %> style="margin-top: 0.2rem;">
          <span>That's everyone in this routine</span>
        </label>
      </div>
      <p id="castPartialNote" style="display: none; margin: -0.75rem 0 0; font-size: 0.85rem; color: var(--text-muted);">
        Just name your own dancer. Other families will fill in their own — the cast grows
        over the season without anyone typing eight names.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
        <div>
          <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Placement</label>
          <input type="text" name="place" value="<%= form.place || '' %>" placeholder="e.g. 1st"
                 style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Category / division</label>
          <input type="text" name="category" value="<%= form.category || '' %>" placeholder="e.g. Teen Contemporary"
                 style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Award name</label>
          <input type="text" name="award_type" value="<%= form.award_type || '' %>" placeholder="e.g. Platinum, Judges' Choice"
                 style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Age division</label>
          <input type="text" name="age_division" value="<%= form.age_division || '' %>" placeholder="e.g. Teen"
                 style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Teacher</label>
          <input type="text" name="teacher" value="<%= form.teacher || '' %>"
                 style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Choreographer</label>
          <input type="text" name="choreographer" value="<%= form.choreographer || '' %>"
                 style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;">
        </div>
      </div>
      <p style="margin: -0.75rem 0 0; font-size: 0.8rem; color: var(--text-muted);">
        Teacher and choreographer are almost never published by competitions. You're often the
        only person who can record who made the routine.
      </p>

      <div>
        <label style="display: block; margin-bottom: 0.5rem; color: var(--text-muted);">Anything else a reviewer should know?</label>
        <textarea name="notes" rows="2" maxlength="2000"
                  style="width: 100%; padding: 0.75rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px;"><%= form.notes || '' %></textarea>
      </div>

      <button type="submit" class="btn btn-primary" style="align-self: flex-start;">Submit for review</button>
      <p style="margin: 0; font-size: 0.8rem; color: var(--text-muted);">
        Up to <%= dailyLimit %> submissions a day per household.
      </p>
    </form>
  </div>

  <h2 style="margin-top: 3rem;">Your submissions</h2>
  <% if (!submissions.length) { %>
    <div class="card glass-card"><p style="margin: 0; color: var(--text-muted);">Nothing submitted yet.</p></div>
  <% } else { %>
    <% submissions.forEach(function (s) { %>
      <div class="card glass-card" style="margin-bottom: 1rem;" data-submission-id="<%= s.id %>">
        <div style="display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
          <div>
            <strong style="font-size: 1.05rem;"><%= s.performance_name %></strong>
            <span style="color: var(--text-muted);">— <%= s.group_size_label %></span>
            <div style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
              <% if (s.event) { %><%= s.event.name %><% if (s.event.year) { %> (<%= s.event.year %>)<% } %>
              <% } else if (s.candidate) { %><%= s.candidate.name %><% if (s.candidate.start_date) { %> (<%= s.candidate.start_date %>)<% } %>
                <span style="color: var(--gold-vivid);">· event pending confirmation</span><% } %>
              <% if (s.studio) { %> · <%= s.studio.is_independent ? 'Independent' : s.studio.name %><% } %>
              <% if (s.place) { %> · <%= s.place %><% } %>
            </div>
            <% var names = cast.get(s.id) || []; %>
            <% if (names.length) { %>
              <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.25rem;">
                With: <%= names.join(', ') %><%= s.cast_complete ? '' : ' (cast still filling in)' %>
              </div>
            <% } else if (!s.cast_complete) { %>
              <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.25rem;">Cast still filling in</div>
            <% } %>
          </div>
          <div style="text-align: right;">
            <span data-submission-status="<%= s.status %>"
                  style="display: inline-block; padding: 0.3rem 0.7rem; border-radius: 999px; font-size: 0.8rem; background: rgba(212,175,55,0.15); color: var(--gold-vivid);">
              <%= s.status === 'submitted' ? 'Pending review' : s.status %>
            </span>
            <div style="color: var(--text-muted); font-size: 0.75rem; margin-top: 0.35rem;"><%= s.created_at %></div>
          </div>
        </div>
      </div>
    <% }); %>
    <p style="color: var(--text-muted); font-size: 0.85rem;">
      Pending submissions are visible only to you. They appear on the public trophy case
      once a reviewer confirms them.
    </p>
  <% } %>
</div>

<script>
  (function () {
    var sizeSel = document.getElementById('groupSize');
    var castBlock = document.getElementById('castBlock');
    var partialNote = document.getElementById('castPartialNote');
    function syncCast() {
      var opt = sizeSel.options[sizeSel.selectedIndex];
      var enumerable = opt && opt.dataset.enumerable === '1';
      var chosen = !!sizeSel.value;
      castBlock.style.display = enumerable ? 'block' : 'none';
      partialNote.style.display = (chosen && !enumerable) ? 'block' : 'none';
    }
    sizeSel.addEventListener('change', syncCast);
    syncCast();

    // ---- Event picker ----
    // Three sources, one list. The organizer's own tour stops are geocoded, so
    // "events near me" answers the common case in one tap; other families'
    // candidates and canonical historical events fill in the rest.
    var DANCER = '<%= dancer.id %>';
    var CSRF = '<%= csrfToken %>';
    var search = document.getElementById('eventSearch');
    var results = document.getElementById('eventResults');
    var dateInput = document.getElementById('eventDate');
    var picker = document.getElementById('eventPicker');
    var chosenBox = document.getElementById('eventChosen');
    var chosenName = document.getElementById('eventChosenName');
    var chosenMeta = document.getElementById('eventChosenMeta');
    var statusLine = document.getElementById('pickerStatus');
    var ids = {
      event: document.getElementById('eventId'),
      candidate: document.getElementById('eventCandidateId'),
      upcoming: document.getElementById('upcomingEventId'),
    };
    var coords = null;
    var timer = null;

    function clearIds() { ids.event.value = ''; ids.candidate.value = ''; ids.upcoming.value = ''; }

    function choose(kind, id, name, meta) {
      clearIds();
      if (kind === 'event') ids.event.value = id;
      else if (kind === 'candidate') ids.candidate.value = id;
      else ids.upcoming.value = id;
      chosenName.textContent = name;
      chosenMeta.textContent = meta ? ' · ' + meta : '';
      chosenBox.style.display = '';
      picker.style.display = 'none';
      results.style.display = 'none';
    }

    document.getElementById('eventClear').addEventListener('click', function () {
      clearIds();
      chosenBox.style.display = 'none';
      picker.style.display = '';
    });

    function metaFor(o) {
      var bits = [];
      if (o.when) bits.push(o.when);
      if (o.where) bits.push(o.where);
      if (o.distance_miles != null) bits.push(o.distance_miles + ' mi away');
      if (o.org_name) bits.push(o.org_name);
      if (o.note) bits.push(o.note);
      return bits.join(' · ');
    }

    function renderOptions(options) {
      results.innerHTML = '';
      options.forEach(function (o) {
        var row = document.createElement('div');
        row.setAttribute('data-option', o.kind + ':' + o.id);
        row.style.cssText = 'padding:0.6rem 0.75rem;cursor:pointer;border-bottom:1px solid rgba(255,255,255,0.08);';
        var meta = metaFor(o);
        row.innerHTML = '<strong></strong><div style="font-size:0.8rem;color:var(--text-muted);"></div>';
        row.querySelector('strong').textContent = o.name;
        row.querySelector('div').textContent = meta;
        row.addEventListener('click', function () { choose(o.kind, o.id, o.name, meta); });
        results.appendChild(row);
      });
      results.style.display = options.length ? 'block' : 'none';
      if (!options.length) statusLine.textContent = 'Nothing matched — try a different spelling, or add the event below.';
    }

    function query(params) {
      var qs = new URLSearchParams(params).toString();
      return fetch('/api/dancer/' + DANCER + '/event-picker?' + qs)
        .then(function (r) { return r.json(); })
        .then(function (d) { return d.options || []; });
    }

    document.getElementById('nearMe').addEventListener('click', function () {
      if (!navigator.geolocation) {
        statusLine.textContent = 'Your browser will not share a location — search by name instead.';
        return;
      }
      statusLine.textContent = 'Looking for events near you…';
      navigator.geolocation.getCurrentPosition(function (pos) {
        coords = { lat: pos.coords.latitude, lng: pos.coords.longitude };
        var date = dateInput.value || new Date().toISOString().slice(0, 10);
        dateInput.value = date;
        statusLine.textContent = '';
        query({ lat: coords.lat, lng: coords.lng, date: date }).then(function (options) {
          if (!options.length) statusLine.textContent = 'No events found near you on that date — search by name, or add the event.';
          renderOptions(options);
        });
      }, function () {
        statusLine.textContent = 'Location was not shared — search by name instead.';
      }, { timeout: 8000 });
    });

    dateInput.addEventListener('change', function () {
      if (!coords) return;
      query({ lat: coords.lat, lng: coords.lng, date: dateInput.value }).then(renderOptions);
    });

    search.addEventListener('input', function () {
      clearTimeout(timer);
      var q = search.value.trim();
      if (q.length < 2) { results.style.display = 'none'; return; }
      timer = setTimeout(function () {
        var params = { q: q };
        if (dateInput.value) params.date = dateInput.value;
        if (coords) { params.lat = coords.lat; params.lng = coords.lng; }
        query(params).then(renderOptions).catch(function () { results.style.display = 'none'; });
      }, 200);
    });

    // ---- Add an event (a CANDIDATE, never a canonical event) ----
    // The server checks for a likely twin first and offers it back; only an
    // explicit "mine is different" creates a second row, and the two are then
    // filed as one dedup cluster for the reviewer.
    var createBox = document.getElementById('createEvent');
    var ceDupes = document.getElementById('ceDuplicates');
    var ceErrors = document.getElementById('ceErrors');
    var ceSubmit = document.getElementById('ceSubmit');
    var confirmNew = false;

    document.getElementById('toggleCreate').addEventListener('click', function () {
      createBox.style.display = createBox.style.display === 'none' ? 'block' : 'none';
      if (!document.getElementById('ceStart').value && dateInput.value) {
        document.getElementById('ceStart').value = dateInput.value;
      }
    });

    ceSubmit.addEventListener('click', function () {
      ceErrors.textContent = '';
      var body = {
        name: document.getElementById('ceName').value,
        start_date: document.getElementById('ceStart').value,
        end_date: document.getElementById('ceEnd').value,
        city: document.getElementById('ceCity').value,
        state: document.getElementById('ceState').value,
        venue: document.getElementById('ceVenue').value,
        org_id: document.getElementById('ceOrg').value,
        confirm_new: confirmNew ? '1' : '',
      };
      // Coordinates are the strongest dedup signal we can get, and a family
      // adding an event is usually standing in the venue.
      if (coords) { body.lat = coords.lat; body.lng = coords.lng; }

      ceSubmit.disabled = true;
      fetch('/api/dancer/' + DANCER + '/event-candidates', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify(body),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          ceSubmit.disabled = false;
          if (data.errors) { ceErrors.textContent = data.errors.join(' '); return; }
          if (data.offered) {
            ceDupes.innerHTML = '<p style="margin:0 0 0.5rem;font-size:0.85rem;">' +
              'Someone already added an event that looks like yours. Pick theirs if it is the same one — ' +
              'then both of your submissions land on one event.</p>';
            data.duplicates.forEach(function (d) {
              var row = document.createElement('div');
              row.setAttribute('data-duplicate-id', d.id);
              row.style.cssText = 'padding:0.5rem 0.65rem;cursor:pointer;border:1px solid rgba(255,255,255,0.15);border-radius:6px;margin-bottom:0.4rem;';
              row.innerHTML = '<strong></strong><div style="font-size:0.8rem;color:var(--text-muted);"></div>';
              row.querySelector('strong').textContent = d.name;
              row.querySelector('div').textContent = [d.start_date, [d.city, d.state].filter(Boolean).join(', ')].filter(Boolean).join(' · ');
              row.addEventListener('click', function () {
                choose('candidate', d.id, d.name, d.start_date || '');
                createBox.style.display = 'none';
              });
              ceDupes.appendChild(row);
            });
            var mine = document.createElement('button');
            mine.type = 'button';
            mine.className = 'btn btn-outline';
            mine.style.cssText = 'padding:0.3rem 0.7rem;font-size:0.85rem;';
            mine.textContent = 'None of these — mine is a different event';
            mine.addEventListener('click', function () { confirmNew = true; ceSubmit.click(); });
            ceDupes.appendChild(mine);
            ceDupes.style.display = 'block';
            return;
          }
          confirmNew = false;
          ceDupes.style.display = 'none';
          createBox.style.display = 'none';
          choose('candidate', data.candidate.id, data.candidate.name,
            (data.candidate.start_date || '') + ' · Added by a family');
        })
        .catch(function () {
          ceSubmit.disabled = false;
          ceErrors.textContent = 'Something went wrong — please try again.';
        });
    });
  })();
</script>

