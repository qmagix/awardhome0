<%- include('partials/header') %>

<div class="container" style="max-width: 1200px; margin: 2rem auto; padding: 0 1rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h1>Studio Duplicates</h1>
    <div style="display: flex; gap: 1rem;">
      <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #10b981; font-size: 1rem; padding: 0.5rem 1rem;">
        Total Studios: <%= totalStudios.toLocaleString() %>
      </span>
      <span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; font-size: 1rem; padding: 0.5rem 1rem;">
        Suspected Groups: <%= duplicateGroupsCount %>
      </span>
    </div>
  </div>

  <% if (typeof ownerRequests !== 'undefined' && ownerRequests.length > 0) { %>
    <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem; border: 1px solid rgba(245, 158, 11, 0.35);">
      <h2 style="margin: 0 0 0.5rem 0; color: #fbbf24;">Owner Merge Requests (<%= ownerRequests.length %>)</h2>
      <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
        Studio owners asked to absorb these records. Compare before approving — approval runs the merge
        immediately and emails the owner; rejecting also emails them (gently).
      </p>
      <table class="premium-table" style="width: 100%;">
        <thead>
          <tr><th>Source (to absorb)</th><th>Into (owner's studio)</th><th>Requested by</th><th>When</th><th style="text-align: right;">Actions</th></tr>
        </thead>
        <tbody>
          <% ownerRequests.forEach(function(r) { %>
            <tr>
              <td>
                <a href="/dance/studio/<%= r.source_uid %>" target="_blank" style="color: var(--primary);"><%= r.source_name %></a>
                <span class="badge" style="margin-left: 0.4rem;"><%= r.source_awards.toLocaleString() %> awards</span>
              </td>
              <td><a href="/dance/studio/<%= r.target_uid %>" target="_blank" style="color: var(--primary);"><%= r.target_name %></a></td>
              <td style="color: var(--text-muted);"><%= r.requester_email || '—' %></td>
              <td style="color: var(--text-muted);"><%= String(r.created_at).slice(0, 10) %></td>
              <td style="text-align: right; white-space: nowrap;">
                <a href="/admin/compare/studios?id1=<%= r.target_id %>&id2=<%= r.source_id %>" target="_blank" class="btn btn-warning" style="padding: 0.3rem 0.7rem; font-size: 0.8rem;">Compare</a>
                <button onclick="decideMergeRequest(<%= r.id %>, 'approve', '<%= r.source_name.replace(/'/g, '') %>')" class="btn" style="background: var(--primary); border: none; color: white; padding: 0.3rem 0.7rem; font-size: 0.8rem;">Approve &amp; merge</button>
                <button onclick="decideMergeRequest(<%= r.id %>, 'reject', '<%= r.source_name.replace(/'/g, '') %>')" class="btn" style="background: transparent; border: 1px solid rgba(255,255,255,0.2); color: var(--text-muted); padding: 0.3rem 0.7rem; font-size: 0.8rem;">Reject</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <script>
      async function decideMergeRequest(id, action, name) {
        const msg = action === 'approve'
          ? 'Merge "' + name + '" into the owner\'s studio now? This moves all its awards and emails the owner.'
          : 'Reject the request for "' + name + '"? The owner is emailed that the records stay separate.';
        if (!confirm(msg)) return;
        const res = await fetch('/api/admin/merge-requests/' + id + '/' + action, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}',
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) location.reload();
        else alert(data.error || 'Action failed');
      }
    </script>
  <% } %>

  <div class="glass-card" style="padding: 2rem;">
    <p style="color: var(--text-muted); margin-bottom: 2rem;">
      The following groups contain studios where one name is an exact case-insensitive prefix of another. Review them below and use the Compare tool to merge verified duplicates.
    </p>

    <% if (groupedDuplicates.length === 0) { %>
      <div style="text-align: center; padding: 3rem; color: var(--text-muted);">
        <h3>No Suspected Duplicates Found</h3>
        <p>Your studio database looks incredibly clean!</p>
      </div>
    <% } else { %>
      <div class="grid" style="grid-template-columns: 1fr;">
        <% groupedDuplicates.forEach(group => { %>
          <div class="card" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.1); margin-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
              <div>
                <h3 style="color: var(--primary); margin-bottom: 0.5rem;"><%= group.base.name %></h3>
                <ul style="list-style: none; padding: 0; margin: 0; color: var(--text-muted);">
                  <% group.matches.forEach(match => { %>
                    <li style="margin-bottom: 0.25rem;">↳ <%= match.name %></li>
                  <% }); %>
                </ul>
              </div>
              <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                <% group.matches.forEach(match => { %>
                  <a href="/admin/compare/studios?id1=<%= group.base.id %>&id2=<%= match.id %>" class="btn btn-warning" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;" target="_blank">
                    Compare with <%= match.name %>
                  </a>
                <% }); %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
