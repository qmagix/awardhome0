<%- include('partials/header') %>
  <div class="container">
    <div class="profile-card glass-card">
      <div class="profile-header">
        <% if (dancer.headshot_url) { %>
          <div
            style="width: 100px; height: 100px; border-radius: 50%; overflow: hidden; border: 3px solid rgba(255,255,255,0.2); box-shadow: 0 4px 15px rgba(0,0,0,0.3); flex-shrink: 0;">
            <img src="<%= dancer.headshot_url %>" alt="<%= dancer.name %>"
              style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <% } else { %>
            <div class="avatar"
              style="width: 100px; height: 100px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 3rem; background: rgba(255,255,255,0.1); border: 3px solid rgba(255,255,255,0.1); flex-shrink: 0;">
              💃</div>
            <% } %>
              <div class="profile-info" style="flex-grow: 1;">
                <div
                  style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
                  <div>
                    <h1 style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.2rem;">
                      <%= dancer.name %>
                        <% if (dancer.is_claimed) { %>
                          <svg viewBox="0 0 24 24" fill="#3b82f6" width="24" height="24" title="Verified Dancer">
                            <path
                              d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                          </svg>
                          <% } %>
                    </h1>
                    <p class="studio-name" style="margin-bottom: 0.5rem;">Affiliations:
                      <% dancer.studios.forEach((s, idx)=> { %>
                        <strong><a href="/dance/studio/<%= s.id %>">
                            <%= s.name %>
                          </a></strong>
                        <%= idx < dancer.studios.length - 1 ? ', ' : '' %>
                          <% }); %>
                    </p>
                    <p class="unique-id" style="margin-bottom: 0.5rem;">ID: <code><%= dancer.unique_id %></code><% if (dancer.vanity_tag) { %> <span class="vanity-chip">#<%= dancer.vanity_tag %></span><% } %></p>

                    <% if (dancer.instagram_handle || dancer.tiktok_handle) { %>
                      <div class="social-links" style="display: flex; gap: 1rem; margin-bottom: 0.5rem;">
                        <% if (dancer.instagram_handle) { %>
                          <a href="https://instagram.com/<%= dancer.instagram_handle.replace('@', '') %>"
                            target="_blank"
                            style="color: #fbbf24; text-decoration: none; display: flex; align-items: center; gap: 0.3rem; font-size: 0.9rem; background: rgba(236,72,153,0.1); padding: 0.2rem 0.5rem; border-radius: 4px;">
                            📸 <%= dancer.instagram_handle %>
                          </a>
                          <% } %>
                            <% if (dancer.tiktok_handle) { %>
                              <a href="https://tiktok.com/@<%= dancer.tiktok_handle.replace('@', '') %>" target="_blank"
                                style="color: #2dd4bf; text-decoration: none; display: flex; align-items: center; gap: 0.3rem; font-size: 0.9rem; background: rgba(45,212,191,0.1); padding: 0.2rem 0.5rem; border-radius: 4px;">
                                🎵 <%= dancer.tiktok_handle %>
                              </a>
                              <% } %>
                      </div>
                      <% } %>
                  </div>
                  <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.6rem;">
                    <% if (!dancer.is_claimed) { %>
                      <a href="/claim/dancer/<%= dancer.id %>" class="btn"
                        style="background: var(--primary); color: #0a0a0a; border: none; padding: 0.5rem 1.5rem; font-weight: 600; border-radius: 8px; cursor: pointer; box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3); text-decoration: none; display: inline-block; white-space: nowrap;">Claim this Dancer</a>
                    <% } else if (typeof user !== 'undefined' && user && user.id === dancer.claimed_by_user_id) { %>
                      <a href="/manage/dancer/<%= dancer.id %>" class="btn btn-secondary"
                        style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; border-color: var(--primary); color: white; background: rgba(212, 175, 55, 0.1); white-space: nowrap;">Manage Profile</a>
                    <% } %>
                    <button onclick="shareProfile()" class="btn btn-outline"
                      style="border-color: #e0e0e0; color: #e0e0e0; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; padding: 0.5rem 1rem;">
                      <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"
                        stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="18" cy="5" r="3"></circle>
                        <circle cx="6" cy="12" r="3"></circle>
                        <circle cx="18" cy="19" r="3"></circle>
                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                      </svg>
                      Share Profile
                    </button>
                  </div>
                </div>

                <div class="stats-pills"
                  style="display: flex; gap: 1rem; margin-top: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
                  <span class="badge"
                    style="background: rgba(16, 185, 129, 0.2); color: #10b981; font-size: 0.8rem; padding: 0.3rem 0.6rem;">
                    Total Awards: <%= soloAwards.length + groupAwards.length + conventionAwards.length %>
                  </span>
                  <span class="badge"
                    style="background: rgba(255, 255, 255, 0.08); color: #e0e0e0; font-size: 0.8rem; padding: 0.3rem 0.6rem;">
                    Groups: <%= groupAwards.length %>
                  </span>
                  <span class="badge"
                    style="background: rgba(212, 175, 55, 0.2); color: #fbbf24; font-size: 0.8rem; padding: 0.3rem 0.6rem;">
                    Solos: <%= soloAwards.length %>
                  </span>
                  <% if (conventionAwards.length> 0) { %>
                    <span class="badge"
                      style="background: rgba(245, 158, 11, 0.2); color: #aa8529; font-size: 0.8rem; padding: 0.3rem 0.6rem;">
                      Special / Convention: <%= conventionAwards.length %>
                    </span>
                    <% } %>
                </div>

                <% const allAwards=[...soloAwards, ...groupAwards, ...conventionAwards]; const
                  totalAwardsCount=allAwards.length; let maxYear=0; allAwards.forEach(a=> {
                  const y = parseInt(a.event_year);
                  if (!isNaN(y) && y > maxYear) maxYear = y;
                  });
                  const awardsThisYear = allAwards.filter(a => parseInt(a.event_year) === maxYear).length;
                  %>

                  <% if (totalAwardsCount> 20) { %>
                    <div
                      style="margin-top: 1rem; padding: 1.5rem; background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(212, 175, 55, 0.15) 100%); border-radius: 8px; border: 1px solid rgba(212, 175, 55, 0.3); text-align: center;">
                      <h3 style="margin-bottom: 0.5rem; color: #f3e5ab; font-size: 1.25rem;">🎉 Milestone Unlocked!</h3>
                      <p style="margin-bottom: 0; font-size: 1.05rem; color: var(--text-color); line-height: 1.5;">
                        <% if (totalAwardsCount>= 100) { %>
                          Incredible! You've earned <strong>
                            <%= totalAwardsCount %> awards
                          </strong>, including <strong>
                            <%= awardsThisYear %>
                          </strong> in <%= maxYear %> alone! You are a true competition legend!
                            <% } else if (totalAwardsCount>= 50) { %>
                              Amazing! You've earned <strong>
                                <%= totalAwardsCount %> awards
                              </strong>, including <strong>
                                <%= awardsThisYear %>
                              </strong> in <%= maxYear %>! Your dedication is truly inspiring!
                                <% } else { %>
                                  Wow! You've earned <strong>
                                    <%= totalAwardsCount %> awards
                                  </strong>, including <strong>
                                    <%= awardsThisYear %>
                                  </strong> in <%= maxYear %>! What a fantastic achievement!
                                    <% } %>
                      </p>
                    </div>
                    <% } %>

                      <% if (!dancer.is_claimed) { %>
                        <div
                          style="margin-top: 1rem; padding: 1rem; background: rgba(59, 130, 246, 0.1); border-left: 4px solid #3b82f6; border-radius: 4px;">
                          <p style="margin-bottom: 0.75rem; font-size: 0.9rem; color: var(--text-color);">
                            <strong>Notice:</strong> Our AI awards detectives and assistants may occasionally miss
                            awards and get things wrong for various reasons. You can add awards and fix issues by
                            claiming this account for yourself or your dancer.
                          </p>
                          <a href="/claim/dancer/<%= dancer.id %>" class="btn"
                            style="background: var(--primary); color: #0a0a0a; border: none; padding: 0.5rem 1.25rem; font-weight: 600; border-radius: 8px; box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3); text-decoration: none; display: inline-block; font-size: 0.9rem;">Claim this Dancer</a>
                        </div>
                        <% } %>
              </div>
      </div>
    </div>

    <div style="display: flex; justify-content: flex-end; align-items: center; margin-top: 2rem; margin-bottom: 1rem;">
      <div class="view-toggle">
        <button id="btn-mode-portrait" class="btn btn-primary btn-sm" onclick="setDisplayMode('portrait')" title="Portrait card grid">▯ Grid</button>
        <button id="btn-mode-landscape" class="btn btn-outline btn-sm" onclick="setDisplayMode('landscape')"
          style="margin-left: 0.5rem;" title="Landscape card grid">▭ Grid</button>
        <button id="btn-mode-table" class="btn btn-outline btn-sm" onclick="setDisplayMode('table')"
          style="margin-left: 0.5rem;" title="Sortable table">Table</button>
      </div>
    </div>
    <div class="awards-view-grid" style="gap: 0;">
      <% if (yearSections.length === 0) { %>
        <p>No awards found yet.</p>
      <% } else { %>
        <% yearSections.forEach(function(sec) { %>
          <h3 class="year-divider"><%= sec.year %></h3>
          <% [['Group Awards', sec.group], ['Solo Awards', sec.solo], ['Special / Convention Awards', sec.convention]].forEach(function(cat) { %>
            <% if (cat[1].length > 0) { %>
              <h4 class="type-divider"><%= cat[0] %></h4>
              <div class="awards-grid">
                <% cat[1].forEach(function(award) { %>
                  <%- include('partials/dancer_award_card', { award: award, isGroupAward: cat[0] === 'Group Awards' }) %>
                <% }); %>
              </div>
            <% } %>
          <% }); %>
        <% }); %>
      <% } %>
    </div>

<div class="awards-view-table card glass-card" style="display: none; overflow-x: auto; margin-top: 1rem;">
      <h2 style="font-size: 1.4rem; margin: 1rem 1rem 0.5rem;">Group Awards</h2>
      <table class="data-table" id="groupTable" style="width: 100%; text-align: left; border-collapse: collapse;">
        <thead>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
            <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('groupTable', 0, 'string')">Placement
              &#x21D5;</th>
            <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('groupTable', 1, 'string')">Performance Name
              &#x21D5;</th>
            <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('groupTable', 2, 'string')">Category &#x21D5;
            </th>
            <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('groupTable', 3, 'string')">Event &#x21D5;
            </th>
            <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('groupTable', 4, 'number')">Year &#x21D5;
            </th>
          </tr>
        </thead>
        <tbody>
          <% if (groupAwards.length===0) { %>
            <tr>
              <td colspan="5" style="padding: 1rem; text-align: center;">No group awards found.</td>
            </tr>
            <% } else { %>
              <% groupAwards.forEach(function(award) { %>
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                  <td style="padding: 1rem;">
                    <%= formatPlacement(award) %>
                      <% if (!award.is_self_added) { %>
                        <svg viewBox="0 0 24 24" fill="#10b981" stroke="currentColor" stroke-width="0" width="14"
                          height="14" style="display:inline-block; margin-left:4px;" title="Official Verified Award">
                          <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                        </svg>
                        <% } else { %>
                          <span style="font-size: 0.6rem; color: #eab308; margin-left: 4px;"
                            title="Self-Reported">(Self)</span>
                          <% } %>
                  </td>
                  <td style="padding: 1rem; font-weight: 600;">
                    <%= award.performance_name || 'N/A' %>
                  </td>
                  <td style="padding: 1rem;">
                    <%= award.award_type %><br>
                      <% if (award.age_division) { %>
                        <span class="badge"
                          style="background: rgba(255, 255, 255, 0.08); color: #e0e0e0; font-size: 0.65rem; border: 1px solid rgba(255, 255, 255, 0.15); padding: 1px 4px; margin-bottom: 2px; display: inline-block;">
                          <%= award.age_division %>
                        </span><br>
                        <% } %>
                          <span style="font-size: 0.8rem; color: var(--text-muted);">
                            <%= award.category %>
                          </span>
                  </td>
                  <td style="padding: 1rem;">
                    <%= award.event_name %>
                  </td>
                  <td style="padding: 1rem;">
                    <%= award.event_year %>
                  </td>
                </tr>
                <% }); %>
                  <% } %>
        </tbody>
      </table>
    </div>

    <div class="awards-view-table card glass-card" style="display: none; overflow-x: auto; margin-top: 1rem;">
      <h2 style="font-size: 1.4rem; margin: 1rem 1rem 0.5rem;">Solo Awards</h2>
      <table class="data-table" id="soloTable" style="width: 100%; text-align: left; border-collapse: collapse;">
        <thead>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
            <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('soloTable', 0, 'string')">Placement &#x21D5;
            </th>
            <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('soloTable', 1, 'string')">Performance Name
              &#x21D5;</th>
            <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('soloTable', 2, 'string')">Category &#x21D5;
            </th>
            <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('soloTable', 3, 'string')">Event &#x21D5;
            </th>
            <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('soloTable', 4, 'number')">Year &#x21D5;</th>
          </tr>
        </thead>
        <tbody>
          <% if (soloAwards.length===0) { %>
            <tr>
              <td colspan="5" style="padding: 1rem; text-align: center;">No solo awards found.</td>
            </tr>
            <% } else { %>
              <% soloAwards.forEach(function(award) { %>
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                  <td style="padding: 1rem;">
                    <%= formatPlacement(award) %>
                      <% if (!award.is_self_added) { %>
                        <svg viewBox="0 0 24 24" fill="#10b981" stroke="currentColor" stroke-width="0" width="14"
                          height="14" style="display:inline-block; margin-left:4px;" title="Official Verified Award">
                          <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                        </svg>
                        <% } else { %>
                          <span style="font-size: 0.6rem; color: #eab308; margin-left: 4px;"
                            title="Self-Reported">(Self)</span>
                          <% } %>
                  </td>
                  <td style="padding: 1rem; font-weight: 600;">
                    <%= award.performance_name || 'N/A' %>
                  </td>
                  <td style="padding: 1rem;">
                    <%= award.award_type %><br>
                      <% if (award.age_division) { %>
                        <span class="badge"
                          style="background: rgba(255, 255, 255, 0.08); color: #e0e0e0; font-size: 0.65rem; border: 1px solid rgba(255, 255, 255, 0.15); padding: 1px 4px; margin-bottom: 2px; display: inline-block;">
                          <%= award.age_division %>
                        </span><br>
                        <% } %>
                          <span style="font-size: 0.8rem; color: var(--text-muted);">
                            <%= award.category %>
                          </span>
                  </td>
                  <td style="padding: 1rem;">
                    <%= award.event_name %>
                  </td>
                  <td style="padding: 1rem;">
                    <%= award.event_year %>
                  </td>
                </tr>
                <% }); %>
                  <% } %>
        </tbody>
      </table>
    </div>
    <% if (conventionAwards && conventionAwards.length> 0) { %>
      <div class="awards-view-table card glass-card" style="display: none; overflow-x: auto; margin-top: 1rem;">
      <h2 style="font-size: 1.4rem; margin: 1rem 1rem 0.5rem;">Special / Convention Awards</h2>
        <table class="data-table" id="conventionTable"
          style="width: 100%; text-align: left; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
              <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('conventionTable', 0, 'string')">Placement
                &#x21D5;</th>
              <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('conventionTable', 1, 'string')">Award Name
                &#x21D5;</th>
              <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('conventionTable', 2, 'string')">Category
                &#x21D5;</th>
              <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('conventionTable', 3, 'string')">Event
                &#x21D5;</th>
              <th style="padding: 1rem; cursor: pointer;" onclick="sortTable('conventionTable', 4, 'number')">Year
                &#x21D5;</th>
            </tr>
          </thead>
          <tbody>
            <% conventionAwards.forEach(function(award) { %>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 1rem;">
                  <%= formatPlacement(award) %>
                    <% if (!award.is_self_added) { %>
                      <svg viewBox="0 0 24 24" fill="#10b981" stroke="currentColor" stroke-width="0" width="14"
                        height="14" style="display:inline-block; margin-left:4px;" title="Official Verified Award">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                      </svg>
                      <% } else { %>
                        <span style="font-size: 0.6rem; color: #eab308; margin-left: 4px;"
                          title="Self-Reported">(Self)</span>
                        <% } %>
                </td>
                <td style="padding: 1rem; font-weight: 600;">
                  <%= award.performance_name || award.award_type || 'N/A' %>
                </td>
                <td style="padding: 1rem;">
                  <%= award.award_type %><br>
                    <% if (award.age_division) { %>
                      <span class="badge"
                        style="background: rgba(255, 255, 255, 0.08); color: #e0e0e0; font-size: 0.65rem; border: 1px solid rgba(255, 255, 255, 0.15); padding: 1px 4px; margin-bottom: 2px; display: inline-block;">
                        <%= award.age_division %>
                      </span><br>
                      <% } %>
                        <span style="font-size: 0.8rem; color: var(--text-muted);">
                          <%= award.category %>
                        </span>
                </td>
                <td style="padding: 1rem;">
                  <%= award.event_name %>
                </td>
                <td style="padding: 1rem;">
                  <%= award.event_year %>
                </td>
              </tr>
              <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
  </div>
  <script>
    // One flat choice: portrait grid (original design), landscape grid
    // (A/B variant), or the sortable table. The card shape is persisted
    // per visitor (awardCardShape) so future analytics can read it.
    function setDisplayMode(mode) {
      const isTable = mode === 'table';
      document.querySelectorAll('.awards-view-grid').forEach(el => el.style.display = isTable ? 'none' : 'grid');
      document.querySelectorAll('.awards-view-table').forEach(el => el.style.display = isTable ? 'block' : 'none');
      if (!isTable) {
        document.querySelectorAll('.awards-grid').forEach(g => g.classList.toggle('landscape', mode === 'landscape'));
        try { localStorage.setItem('awardCardShape', mode); } catch (e) { }
      }
      ['portrait', 'landscape', 'table'].forEach(m => {
        const btn = document.getElementById('btn-mode-' + m);
        btn.classList.toggle('btn-primary', m === mode);
        btn.classList.toggle('btn-outline', m !== mode);
      });
    }
    try {
      if (localStorage.getItem('awardCardShape') === 'landscape') setDisplayMode('landscape');
    } catch (e) { }

    // Store sort directions for both tables independently
    const sortDirs = {
      soloTable: [true, true, true, true, true],
      conventionTable: [true, true, true, true, true],
      groupTable: [true, true, true, true, true]
    };

    function sortTable(tableId, columnIndex, type) {
      const table = document.getElementById(tableId);
      const tbody = table.querySelector("tbody");
      const rows = Array.from(tbody.querySelectorAll("tr"));

      if (rows.length === 0 || (rows.length === 1 && rows[0].cells.length === 1)) return;

      const isAsc = sortDirs[tableId][columnIndex];
      sortDirs[tableId][columnIndex] = !isAsc;

      rows.sort((a, b) => {
        let valA = a.cells[columnIndex].innerText.trim();
        let valB = b.cells[columnIndex].innerText.trim();

        if (type === 'number') {
          valA = parseInt(valA) || 0;
          valB = parseInt(valB) || 0;
          return isAsc ? valA - valB : valB - valA;
        } else {
          return isAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
        }
      });

      rows.forEach(row => tbody.appendChild(row));
    }

    function shareAwardCard(btn) {
      const text = btn.dataset.shareText;
      const url = window.location.href;
      if (navigator.share) {
        navigator.share({ title: '<%= dancer.name %> | AwardHome', text: text, url: url })
          .catch((error) => console.log('Error sharing', error));
      } else {
        navigator.clipboard.writeText(text + ' ' + url)
          .then(() => {
            const original = btn.innerHTML;
            btn.innerHTML = '✓';
            setTimeout(() => { btn.innerHTML = original; }, 1500);
          })
          .catch(() => alert('Failed to copy.'));
      }
    }

    function shareProfile() {
      if (navigator.share) {
        navigator.share({
          title: '<%= dancer.name %> | Digital Trophy Case',
          text: 'Check out my competitive dance awards and stats on AwardHome!',
          url: window.location.href,
        })
          .catch((error) => console.log('Error sharing', error));
      } else {
        navigator.clipboard.writeText(window.location.href)
          .then(() => alert("Profile link copied to clipboard!"))
          .catch(err => alert("Failed to copy link."));
      }
    }
  </script>

  <style>
    .data-table th:hover {
      background: rgba(255, 255, 255, 0.05);
    }
  </style>

  <%- include('partials/footer') %>