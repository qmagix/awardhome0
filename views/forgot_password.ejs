<%- include('partials/header') %>
<div class="container" style="max-width: 420px; margin-top: 4rem;">
  <div class="card glass-card" style="padding: 2.5rem;">
    <h2 style="text-align: center; margin-top: 0; color: var(--primary);">Reset your password</h2>
    <% if (sent) { %>
      <p style="color: var(--text-muted); line-height: 1.6; text-align: center;">
        If an account exists for that email, we've sent a link to choose a new password.
        It works once and expires in an hour.
      </p>
      <p style="color: var(--text-muted); line-height: 1.6; text-align: center; font-size: 0.9rem;">
        Nothing arrived? Check spam, or <a href="/forgot-password" style="color: var(--primary);">try another address</a>.
      </p>
      <p style="text-align: center; margin-top: 1.5rem;"><a href="/login" style="color: var(--primary);">Back to sign in</a></p>
    <% } else { %>
      <p style="color: var(--text-muted); line-height: 1.6; margin-bottom: 1.5rem;">
        Enter the email you signed up with and we'll send you a link to set a new one.
      </p>
      <% if (error) { %>
        <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #ef4444; padding: 1rem; border-radius: 6px; margin-bottom: 1.5rem; text-align: center;"><%= error %></div>
      <% } %>
      <form action="/forgot-password" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div>
          <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text-muted);">Email</label>
          <input type="email" name="email" required autofocus style="width: 100%; padding: 0.75rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.2); color: white;">
        </div>
        <button type="submit" class="btn" style="background: var(--primary); color: #0a0a0a; border: none; padding: 0.75rem; font-weight: 600; border-radius: 6px; cursor: pointer;">Send reset link</button>
      </form>
      <p style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-muted);">
        Remembered it? <a href="/login" style="color: var(--primary);">Sign in</a>
      </p>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
