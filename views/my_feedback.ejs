<%- include('partials/header') %>
<div class="container">
  <div class="header-section" style="margin-bottom: 2rem;">
    <h1>My Support & Feedback</h1>
    <p class="subtitle">Track your feature requests, bug reports, and see our responses.</p>
  </div>
  
  <div style="margin-bottom: 2rem;">
    <a href="#" class="btn btn-primary" onclick="openFeedbackModal(event)">+ Submit New Feedback</a>
  </div>

  <% if (feedbackList.length === 0) { %>
    <div class="card glass-card" style="text-align: center; padding: 3rem;">
      <h3 style="color: var(--text-muted);">You haven't submitted any feedback yet.</h3>
    </div>
  <% } else { %>
    <div class="grid" style="grid-template-columns: 1fr; gap: 1.5rem;">
      <% feedbackList.forEach(fb => { %>
        <div class="card glass-card" style="display: flex; flex-direction: column; gap: 1rem; border-left: 4px solid <%= fb.type === 'bug' ? '#ef4444' : (fb.type === 'feature_request' ? '#3b82f6' : '#10b981') %>;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                <span style="background: rgba(255,255,255,0.1); padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; font-weight: 600; text-transform: uppercase;">
                  <%= fb.type.replace('_', ' ') %>
                </span>
                <span style="font-size: 0.9rem; color: var(--text-muted);"><%= new Date(fb.created_at).toLocaleString() %></span>
              </div>
            </div>
            <div>
              <span style="padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.8rem; font-weight: 600; 
                <%= fb.status === 'new' ? 'background: rgba(251, 191, 36, 0.2); color: #fbbf24;' : 
                    (fb.status === 'replied' ? 'background: rgba(99, 102, 241, 0.2); color: #818cf8;' : 
                    'background: rgba(16, 185, 129, 0.2); color: #10b981;') %>">
                <%= fb.status === 'new' ? 'Pending Review' : (fb.status === 'replied' ? 'Replied' : 'Resolved') %>
              </span>
            </div>
          </div>
          
          <div style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px; color: var(--text-color); font-size: 1rem; white-space: pre-wrap;"><%= fb.message %></div>
          
          <% if (fb.admin_reply) { %>
            <div style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.3); padding: 1rem; border-radius: 8px;">
              <strong style="color: #818cf8; display: block; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
                Response from Dance Awards Team:
              </strong>
              <div style="color: white; white-space: pre-wrap;"><%= fb.admin_reply %></div>
            </div>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
