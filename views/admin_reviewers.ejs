<%- include('partials/header') %>
<div class="container" style="margin-top: 4rem;">
  <div class="header-section" style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
      <h1>Review Notifications</h1>
      <p class="subtitle">Who gets emailed when a weekly import is held for review or an organizer uploads results.</p>
    </div>
  </div>

  <% if (reviewers.length === 0) { %>
    <div class="card glass-card" style="margin-top: 2rem; padding: 1rem 1.5rem; border-color: rgba(234, 179, 8, 0.4);">
      <% if (envFallback) { %>
        <p style="margin: 0; color: #eab308;">No reviewers configured — notifications currently fall back to
          <strong><%= envFallback %></strong> (REVIEW_EMAIL / SUPERADMIN_EMAIL from the server environment).
          Add reviewers below to take over from the fallback.</p>
      <% } else { %>
        <p style="margin: 0; color: #ef4444;">No reviewers configured and no REVIEW_EMAIL / SUPERADMIN_EMAIL set on the
          server — <strong>notification emails are not being sent</strong>. Add at least one reviewer below.</p>
      <% } %>
    </div>
  <% } %>

  <div class="card glass-card" style="margin-top: 2rem; padding: 2rem;">
    <h3>Add Reviewer</h3>
    <form action="/admin/reviewers/add" method="POST" style="margin-top: 1rem; display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
      <div style="flex: 2; min-width: 220px;">
        <label for="email" style="display: block; font-size: 0.9rem; margin-bottom: 0.3rem;">Email</label>
        <input type="email" id="email" name="email" class="form-control" required style="width: 100%;">
      </div>
      <div style="flex: 1; min-width: 160px;">
        <label for="name" style="display: block; font-size: 0.9rem; margin-bottom: 0.3rem;">Name (optional)</label>
        <input type="text" id="name" name="name" class="form-control" style="width: 100%;">
      </div>
      <div>
        <button type="submit" class="btn btn-primary">Add Reviewer</button>
      </div>
    </form>
  </div>

  <div class="card glass-card" style="margin-top: 2rem; overflow-x: auto;">
    <table class="premium-table">
      <thead>
        <tr>
          <th>Email</th>
          <th>Name</th>
          <th>Added By</th>
          <th>Added</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (reviewers.length === 0) { %>
          <tr><td colspan="5" style="text-align: center;">No reviewers yet.</td></tr>
        <% } else { %>
          <% reviewers.forEach(function(r) { %>
            <tr>
              <td><%= r.email %></td>
              <td><%= r.name || '—' %></td>
              <td><%= r.added_by_email || '—' %></td>
              <td><%= new Date(r.created_at).toLocaleDateString() %></td>
              <td>
                <form action="/admin/reviewers/<%= r.id %>/delete" method="POST" style="margin: 0;">
                  <button type="submit" class="btn btn-secondary" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.4rem 0.8rem; border-radius: 4px; cursor: pointer; font-size: 0.8rem;">Remove</button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <p style="margin-top: 1.5rem; color: var(--text-muted); font-size: 0.9rem;">
    Reviewers receive: weekly-import hold alerts (amber/red validation verdicts, with a link to
    <a href="/admin/import-review" style="color: var(--primary);">Import Review</a>) and notifications when an
    organizer uploads a results file. This list does not grant any login permissions — it is purely a
    notification list.
  </p>
</div>
<%- include('partials/footer') %>
