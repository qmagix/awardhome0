<%- include('partials/header') %>

<style>
  .edit-filter-chip {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .edit-filter-chip.active {
    border-color: var(--primary);
    color: #f3e5ab;
    background: rgba(212, 175, 55, 0.12);
  }
  #edit-toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(16, 185, 129, 0.95);
    color: #04140d;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    z-index: 1000;
    display: none;
  }
</style>

<div class="container" style="max-width: 1100px; margin-top: 3rem; margin-bottom: 4rem;">
  <div class="header-section" style="margin-bottom: 1.5rem;">
    <h1>Edit <%= dancer.name %>'s Award Cards</h1>
    <p class="subtitle">Flip any card over and fill its pages right where they'll appear — photo and thank-you note.</p>
    <div style="display: flex; gap: 1.5rem; margin-top: 0.75rem; flex-wrap: wrap;">
      <a href="/manage/dancer/<%= dancer.id %>" style="color: var(--primary); text-decoration: none; font-size: 0.9rem;">&larr; Manage Profile (default photo lives there)</a>
      <a href="/dancer/<%= dancer.unique_id %>" style="color: var(--primary); text-decoration: none; font-size: 0.9rem;">View Public Trophy Case &rarr;</a>
    </div>
  </div>

  <% if (typeof photoNotice !== 'undefined' && photoNotice) { %>
    <div style="margin-bottom: 1.5rem; padding: 1rem; background: rgba(107,191,107,0.12); border-left: 4px solid #6bbf6b; border-radius: 4px; font-size: 0.9rem;">
      <%= photoNotice %>
    </div>
  <% } %>

  <!-- Teammates' photos awaiting approval on routines this dancer is in.
       A group photo shows other people's children; their families are the
       only ones who can say it shouldn't be seen, and this is the window in
       which they can. One concern stops publication. -->
  <% if (typeof castmatePhotos !== 'undefined' && castmatePhotos.length) { %>
    <div class="card glass-card" style="margin-bottom: 1.5rem;" id="castmate-photos">
      <h3 style="margin-top: 0;">Photos from <%= dancer.name %>'s routines</h3>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;">
        Other families have added these to routines <%= dancer.name %> danced in. They are not public yet —
        only families in the routine can see them. If a photo shouldn't be shared, say so and it will not be
        published while we look at it.
      </p>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <% castmatePhotos.forEach(function (p) { %>
          <div style="width: 200px;" data-castmate-photo="<%= p.id %>">
            <img src="<%= p.photo_url %>" alt="" style="width: 100%; height: 140px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(255,255,255,0.15);">
            <div style="font-size: 0.85rem; margin-top: 0.4rem;"><%= p.performance_name || 'Routine' %></div>
            <div style="font-size: 0.78rem; color: var(--text-muted);">
              <%= p.event_name || '' %><% if (p.event_year) { %> (<%= p.event_year %>)<% } %> · added for <%= p.dancer_name %>
            </div>
            <% if (p.i_objected) { %>
              <div style="font-size: 0.8rem; color: var(--gold-vivid); margin-top: 0.4rem;">You raised a concern — AwardHome will decide.</div>
            <% } else { %>
              <button type="button" class="btn btn-outline object-photo"
                      data-photo-id="<%= p.id %>"
                      style="margin-top: 0.4rem; padding: 0.25rem 0.6rem; font-size: 0.8rem; border-color: #d98a8a; color: #d98a8a;">
                Please don't share this
              </button>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <div style="margin-bottom: 1.5rem; padding: 1rem; background: rgba(59, 130, 246, 0.1); border-left: 4px solid #3b82f6; border-radius: 4px; font-size: 0.9rem; color: var(--text-color);">
    Tap a card to flip it, then use the arrows/dots to reach the photo and thank-you pages.
    New photos and notes go live <strong>once your studio approves them</strong>, and when the
    same routine won several awards at one competition, one save fills the matching cards automatically.
    <% if (consent) { %>
      <div style="margin-top: 0.5rem; color: #10b981;">✓ Photo permission on file
        (confirmed <%= new Date(consent.consented_at).toLocaleDateString() %>).</div>
    <% } %>
  </div>

  <% if (!featureNotes && !featurePhotos) { %>
    <div class="card glass-card" style="text-align: center; padding: 4rem 2rem;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🎁</div>
      <h3 style="margin: 0 0 0.5rem 0; color: white;">Card extras are coming soon</h3>
      <p style="color: var(--text-muted); margin: 0;">Photos and thank-you notes for award cards
        haven't been released yet — check back shortly!</p>
    </div>
  <% } else { %>

  <% if (!consent && featurePhotos) { %>
    <label style="display: flex; gap: 0.6rem; align-items: flex-start; margin-bottom: 1.5rem; padding: 1rem; background: rgba(212, 175, 55, 0.08); border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 8px; font-size: 0.85rem; color: var(--text-muted); cursor: pointer;">
      <input type="checkbox" id="consent-inline" style="margin-top: 0.2rem; width: 16px; height: 16px; accent-color: var(--primary);">
      <span><strong style="color: #f3e5ab;">One-time photo permission:</strong> I am this dancer's
        parent/guardian (or the dancer is an adult, or I have the family's permission), and for any
        photo I upload I have permission from everyone pictured to display it publicly on AwardHome Dance
        award cards. Check once before your first upload — you won't be asked again.</span>
    </label>
  <% } %>

  <% const counts = { waiting: 0, partial: 0, done: 0 };
     awards.forEach(a => counts[a.editState]++); %>
  <div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;" id="edit-filters">
    <button type="button" class="edit-filter-chip active" data-filter="all" onclick="editFilter(this)">All (<%= awards.length %>)</button>
    <button type="button" class="edit-filter-chip" data-filter="waiting" onclick="editFilter(this)">Needs input (<span data-count="waiting"><%= counts.waiting %></span>)</button>
    <button type="button" class="edit-filter-chip" data-filter="partial" onclick="editFilter(this)">Partial (<span data-count="partial"><%= counts.partial %></span>)</button>
    <button type="button" class="edit-filter-chip" data-filter="done" onclick="editFilter(this)">Done (<span data-count="done"><%= counts.done %></span>)</button>
  </div>

  <% if (awards.length === 0) { %>
    <div class="card glass-card" style="text-align: center; padding: 3rem;">
      <p style="color: var(--text-muted); margin: 0;">No linked awards yet.</p>
    </div>
  <% } else { %>
    <div class="awards-grid" id="edit-grid">
      <% awards.forEach(function(award) { %>
        <%- include('partials/dancer_award_card', { award: award, isGroupAward: award.dancer_count > 1, cardEditMode: true }) %>
      <% }); %>
    </div>
  <% } %>

  <% } %><%# end feature-enabled branch %>
</div>

<div id="edit-toast"></div>

<style>
  .card-vis-toggle { position: absolute; top: 8px; left: 8px; z-index: 6; padding: 3px 10px;
    border-radius: 999px; border: 1px solid rgba(255,255,255,0.35); background: rgba(0,0,0,0.55);
    color: #ddd; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em; cursor: pointer; }
  .card-vis-toggle.card-vis-hidden { border-color: #e0b357; color: #e0b357; background: rgba(40,30,0,0.75); }
  .flip-card:has(.card-vis-hidden) { opacity: 0.55; }
</style>
<script>
  // Hide/show a card on the dancer's PUBLIC page (owner display preference —
  // the record stays here and on studio surfaces). csrf.js adds the token.
  async function editToggleVisibility(btn, awardId) {
    const hide = !btn.classList.contains('card-vis-hidden');
    try {
      const res = await fetch(`/manage/dancer/${DANCER_ID}/card/visibility?json=1`, {
        method: 'POST',
        body: new URLSearchParams({ award_id: awardId, hidden: hide ? '1' : '0' }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Save failed');
      btn.classList.toggle('card-vis-hidden', data.hidden);
      btn.textContent = data.hidden ? 'Hidden' : 'Public';
      btn.title = data.hidden ? 'Hidden from your public page — click to show'
                              : 'Shown on your public page — click to hide';
      editToast(data.hidden ? 'Hidden from the public page (still yours, still in studio records)'
                            : 'Shown on the public page again');
    } catch (e) { editToast(e.message || 'Could not save — try again'); }
  }
</script>
<script src="/js/flipbook.js"></script>
<script>
  const DANCER_ID = <%= dancer.id %>;
  const FEATURE_PHOTOS = <%= featurePhotos ? 'true' : 'false' %>;
  const FEATURE_NOTES = <%= featureNotes ? 'true' : 'false' %>;
  let needConsent = <%= consent ? 'false' : 'true' %>;

  function editToast(msg) {
    const t = document.getElementById('edit-toast');
    t.textContent = msg;
    t.style.display = 'block';
    clearTimeout(t._timer);
    t._timer = setTimeout(() => { t.style.display = 'none'; }, 3500);
  }

  function editConsentOk() {
    if (!needConsent) return true;
    const box = document.getElementById('consent-inline');
    if (box && box.checked) return true;
    editToast('Please check the one-time photo permission box above the cards first.');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    return false;
  }

  // ---- Card state bookkeeping (front chip + filter counts) ----
  function editSetState(card, hasPhoto, hasAck) {
    card.dataset.hasPhoto = hasPhoto ? '1' : '';
    card.dataset.hasAck = hasAck ? '1' : '';
    const slots = [];
    if (FEATURE_PHOTOS) slots.push(hasPhoto);
    if (FEATURE_NOTES) slots.push(hasAck);
    const missing = slots.filter(s => !s).length;
    const state = missing === 0 ? 'done' : (missing === slots.length ? 'waiting' : 'partial');
    card.dataset.state = state;
    const chip = card.querySelector('[data-role="state-chip"]');
    chip.className = 'card-edit-chip chip-' + state;
    chip.textContent = state === 'done' ? '✓ Done' : missing + ' to add';
    // refresh filter counts
    const counts = { waiting: 0, partial: 0, done: 0 };
    document.querySelectorAll('#edit-grid .flip-card').forEach(c => counts[c.dataset.state]++);
    ['waiting', 'partial', 'done'].forEach(s => {
      const el = document.querySelector('[data-count="' + s + '"]');
      if (el) el.textContent = counts[s];
    });
  }
  // seed per-card flags from the server-rendered state
  document.querySelectorAll('#edit-grid .flip-card').forEach(card => {
    const st = card.dataset.state;
    card.dataset.hasPhoto = (st === 'done' || (st === 'partial' && card.querySelector('[data-role="photo-frame"]'))) ? '1' : '';
    card.dataset.hasAck = (st === 'done' || (st === 'partial' && !card.querySelector('[data-role="photo-frame"]'))) ? '1' : '';
  });

  function editFilter(btn) {
    document.querySelectorAll('.edit-filter-chip').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    document.querySelectorAll('#edit-grid .flip-card').forEach(c => {
      c.style.display = (f === 'all' || c.dataset.state === f) ? '' : 'none';
    });
  }

  // ---- Photo editing ----
  function editPickPhoto(btn) {
    if (!editConsentOk()) return;
    btn.closest('.tcb-page').querySelector('input[type="file"]').click();
  }

  async function editPhotoChosen(input) {
    if (!input.files || !input.files[0]) return;
    const card = input.closest('.flip-card');
    const page = input.closest('.tcb-page');
    const fd = new FormData();
    fd.append('award_id', card.dataset.awardId);
    fd.append('photo', input.files[0]);
    if (needConsent) fd.append('consent', 'on');
    try {
      const res = await fetch(`/manage/dancer/${DANCER_ID}/card/award-photo?json=1`, { method: 'POST', body: fd });
      const j = await res.json();
      if (!res.ok || !j.success) throw new Error(j.error || 'Upload failed');
      needConsent = false;
      const consentBar = document.getElementById('consent-inline');
      if (consentBar) consentBar.closest('label').style.display = 'none';
      // swap placeholder → framed photo with pending ribbon, in place
      const ph = page.querySelector('[data-role="photo-placeholder"]');
      if (ph) ph.remove();
      const hint = page.querySelector('.tcb-edit-hint');
      if (hint) hint.remove();
      let frame = page.querySelector('[data-role="photo-frame"]');
      if (!frame) {
        frame = document.createElement('div');
        frame.className = 'tcb-photo-frame tcb-photo-frame-rect';
        frame.dataset.role = 'photo-frame';
        frame.innerHTML = '<img alt="Award photo">';
        page.insertBefore(frame, page.firstChild);
        const status = document.createElement('div');
        status.className = 'tcb-edit-status status-pending';
        status.dataset.role = 'photo-status';
        frame.after(status);
        const actions = document.createElement('div');
        actions.className = 'tcb-edit-actions';
        actions.innerHTML = '<button type="button" class="tcb-edit-btn" onclick="event.stopPropagation(); editPickPhoto(this);">Replace</button>' +
          '<button type="button" class="tcb-edit-btn tcb-edit-danger" onclick="event.stopPropagation(); editRemovePhoto(this);">Remove</button>';
        status.after(actions);
      }
      frame.querySelector('img').src = j.photo_url;
      const status = page.querySelector('[data-role="photo-status"]');
      status.className = 'tcb-edit-status status-pending';
      status.textContent = 'Pending review';
      editSetState(card, true, card.dataset.hasAck === '1');
      editToast(j.propagated > 0
        ? `Photo saved — also applied to ${j.propagated} more award${j.propagated === 1 ? '' : 's'} of this routine.`
        : 'Photo saved — pending review.');
    } catch (err) {
      editToast(err.message);
    } finally {
      input.value = '';
    }
  }

  async function editRemovePhoto(btn) {
    const card = btn.closest('.flip-card');
    const page = btn.closest('.tcb-page');
    try {
      const body = new URLSearchParams({ award_id: card.dataset.awardId });
      const res = await fetch(`/manage/dancer/${DANCER_ID}/card/award-photo/remove?json=1`, {
        method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body
      });
      const j = await res.json();
      if (!res.ok || !j.success) throw new Error(j.error || 'Remove failed');
      // framed photo → placeholder, in place
      page.querySelector('[data-role="photo-frame"]').remove();
      const status = page.querySelector('[data-role="photo-status"]');
      if (status) status.remove();
      btn.closest('.tcb-edit-actions').remove();
      const ph = document.createElement('button');
      ph.type = 'button';
      ph.className = 'tcb-photo-placeholder';
      ph.dataset.role = 'photo-placeholder';
      ph.setAttribute('onclick', 'event.stopPropagation(); editPickPhoto(this);');
      ph.innerHTML = '<span class="tcb-ph-icon">📷</span><span>Upload this routine\'s photo</span>';
      page.insertBefore(ph, page.firstChild);
      editSetState(card, false, card.dataset.hasAck === '1');
      editToast('Photo removed.');
    } catch (err) {
      editToast(err.message);
    }
  }

  // ---- Thank-you note editing ----
  async function editSaveAck(btn) {
    const card = btn.closest('.flip-card');
    const page = btn.closest('.tcb-page');
    const message = page.querySelector('[data-role="ack-input"]').value.trim();
    try {
      const body = new URLSearchParams({ award_id: card.dataset.awardId, message });
      const res = await fetch(`/manage/dancer/${DANCER_ID}/card/ack?json=1`, {
        method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body
      });
      const j = await res.json();
      if (!res.ok || !j.success) throw new Error(j.error || 'Save failed');
      const status = page.querySelector('[data-role="ack-status"]');
      if (j.cleared) {
        status.className = 'tcb-edit-status';
        status.textContent = '';
        editSetState(card, card.dataset.hasPhoto === '1', false);
        editToast('Note removed from this award.');
      } else {
        const live = j.status === 'approved'; // auto-moderation cleared it
        status.className = 'tcb-edit-status ' + (live ? 'status-approved' : 'status-pending');
        status.textContent = live ? '✓ Live' : 'Pending review';
        editSetState(card, card.dataset.hasPhoto === '1', true);
        const tail = live ? 'live on your card!' : 'pending review.';
        editToast(j.propagated > 0
          ? `Note saved (${tail}) — also applied to ${j.propagated} more award${j.propagated === 1 ? '' : 's'} of this routine.`
          : `Note saved — ${tail}`);
      }
    } catch (err) {
      editToast(err.message);
    }
  }

  // One concern from a family in the routine stops publication. No counting,
  // no undo button: reversing it is a conversation with AwardHome, which is
  // the right amount of friction for "don't share a picture of my child".
  document.querySelectorAll('.object-photo').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!confirm('This stops the photo being published while AwardHome looks at it. Continue?')) return;
      btn.disabled = true;
      fetch('/api/card-photo/' + btn.dataset.photoId + '/object', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
      })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
          if (!res.ok) { btn.disabled = false; editToast(res.d.error || 'Could not record that.'); return; }
          window.location.href = '/manage/dancer/<%= dancer.id %>/card?objected=1';
        })
        .catch(function () { btn.disabled = false; editToast('Network error.'); });
    });
  });
</script>

<%- include('partials/footer') %>
