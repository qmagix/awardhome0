<%- include('partials/header') %>
<div class="container" style="margin-top: 4rem;">
  <div class="header-section">
    <h1>Pending Studio Claims</h1>
    <p class="subtitle">Review and verify ownership requests.</p>
  </div>

  <div class="card glass-card" style="margin-top: 2rem; overflow-x: auto;">
    <table class="premium-table">
      <thead>
        <tr>
          <th>User Email</th>
          <th>Studio</th>
          <th>Proof Provided</th>
          <th>Date Submitted</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (claims.length === 0) { %>
          <tr><td colspan="5" style="text-align: center;">No pending claims at this time.</td></tr>
        <% } else { %>
          <% claims.forEach(function(claim) { %>
            <tr>
              <td><%= claim.user_email %></td>
              <td><a href="/dance/studio/<%= claim.studio_uid %>" style="color: var(--primary);"><%= claim.studio_name %></a></td>
              <td style="white-space: pre-wrap; font-size: 0.9rem;">
                <%= claim.proof_text %>
                <% if (claim.photo_object_key) { %>
                  <%# The claimant's own photo. Private storage — this route is
                      the only way to see it. Worth checking against the
                      studio's public "meet the staff" page: that comparison is
                      real evidence, and being asked for a face is itself a
                      deterrent to a speculative claim. %>
                  <div style="margin-top: 0.6rem;">
                    <img src="/admin/claims/<%= claim.id %>/photo" alt="Claimant photo"
                         style="width: 96px; height: 96px; object-fit: cover; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2);">
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">
                      Sent by the claimant<%= claim.show_publicly ? ' · agreed to be named publicly' : ' · asked not to be named publicly' %>
                    </div>
                  </div>
                <% } else { %>
                  <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.4rem;">No photo sent</div>
                <% } %>
              </td>
              <td><%= new Date(claim.created_at).toLocaleDateString() %></td>
              <td style="display: flex; gap: 0.5rem;">
                <form action="/admin/claims/<%= claim.id %>/approve" method="POST">
                  <button type="submit" class="btn" style="background: #10b981; color: white; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer;">Approve</button>
                </form>
                <form action="/admin/claims/<%= claim.id %>/reject" method="POST">
                  <button type="submit" class="btn btn-secondary" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer;">Reject</button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="header-section" style="margin-top: 4rem;">
    <h2>Pending Dancer Claims</h2>
    <p class="subtitle">Review and verify ownership requests for dancer profiles.</p>
  </div>

  <div class="card glass-card" style="margin-top: 2rem; overflow-x: auto; margin-bottom: 4rem;">
    <table class="premium-table">
      <thead>
        <tr>
          <th>User Email</th>
          <th>Dancer</th>
          <th>Proof Provided</th>
          <th>Date Submitted</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (dancerClaims && dancerClaims.length === 0) { %>
          <tr><td colspan="5" style="text-align: center;">No pending dancer claims at this time.</td></tr>
        <% } else if (dancerClaims) { %>
          <% dancerClaims.forEach(function(claim) { %>
            <tr>
              <td><%= claim.user_email %></td>
              <td>
                <a href="/dancer/<%= claim.dancer_unique_id %>" style="color: var(--primary);"><%= claim.dancer_name %></a>
                <% if (claim.code_valid) { %>
                  <br><span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #10b981; font-size: 0.7rem;" title="Valid studio claim code — also in the studio director's Verifications queue">✓ Code: <%= claim.code_studio_name %></span>
                <% } else if (claim.proof_text && claim.proof_text.includes('did not match')) { %>
                  <br><span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; font-size: 0.7rem;" title="A studio code was entered but matched none of this dancer's studios">✗ Bad code</span>
                <% } %>
              </td>
              <td style="white-space: pre-wrap; font-size: 0.9rem;"><%= claim.proof_text %></td>
              <td><%= new Date(claim.created_at).toLocaleDateString() %></td>
              <td style="display: flex; gap: 0.5rem;">
                <form action="/admin/claims/dancer/<%= claim.id %>/approve" method="POST">
                  <button type="submit" class="btn" style="background: #10b981; color: white; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer;">Approve</button>
                </form>
                <form action="/admin/claims/dancer/<%= claim.id %>/reject" method="POST">
                  <button type="submit" class="btn btn-secondary" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer;">Reject</button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Contested: two or more households claiming one dancer. These never
       reach a studio — a director asked to choose between two families is
       being asked to arbitrate a private dispute (design §6.9). Grouped by
       dancer so both sides of one argument are read together. -->
  <% if (typeof contestedClaims !== 'undefined' && contestedClaims.length > 0) { %>
    <div class="card glass-card" style="margin-top: 2rem;" id="contested-claims">
      <h3 style="margin-top: 0; color: #f3b0b0;">⚠ Contested Dancer Claims — AwardHome only</h3>
      <p style="color: var(--text-muted); font-size: 0.9rem;">
        More than one household has claimed these dancers. Neither claimant wins silently, and no studio
        sees them. Approving one settles the others and emails everybody.
      </p>
      <table style="width: 100%;">
        <thead>
          <tr><th>Dancer</th><th>Claimant</th><th>Proof</th><th>Filed</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% var lastDancer = null; %>
          <% contestedClaims.forEach(function (claim) { %>
            <tr data-contested-claim="<%= claim.id %>"
                style="<%= lastDancer !== null && lastDancer !== claim.dancer_id ? 'border-top: 2px solid rgba(255,255,255,0.15);' : '' %>">
              <td>
                <a href="/dancer/<%= claim.dancer_unique_id %>" style="color: var(--primary);"><%= claim.dancer_name %></a>
                <% if (claim.code_valid) { %>
                  <br><span class="badge" style="background: rgba(16,185,129,0.2); color: #10b981; font-size: 0.7rem;">✓ Code: <%= claim.code_studio_name %></span>
                <% } %>
              </td>
              <td><%= claim.user_email %></td>
              <td style="white-space: pre-wrap; font-size: 0.85rem;"><%= claim.proof_text %></td>
              <td><%= new Date(claim.created_at).toLocaleDateString() %></td>
              <td style="display: flex; gap: 0.5rem;">
                <form action="/admin/claims/dancer/<%= claim.id %>/approve" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn" style="background: #10b981; color: white; border: none; padding: 0.4rem 0.85rem; border-radius: 4px; cursor: pointer;">This one</button>
                </form>
                <form action="/admin/claims/dancer/<%= claim.id %>/reject" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-secondary" style="background: rgba(239,68,68,0.2); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); padding: 0.4rem 0.85rem; border-radius: 4px; cursor: pointer;">Reject</button>
                </form>
              </td>
            </tr>
            <% lastDancer = claim.dancer_id; %>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
