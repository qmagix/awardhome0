<%- include('partials/header') %>
<div class="container" style="max-width: 560px; margin-top: 4rem;">
  <div class="card glass-card" style="padding: 2.5rem;">
    <% if (error) { %>
      <h1 style="font-size: 1.5rem; margin-bottom: 1rem;">Organizer Claim</h1>
      <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444; padding: 0.9rem 1.2rem; border-radius: 8px;">
        <%= error %>
      </div>
      <p style="margin-top: 1.5rem; color: var(--text-muted); font-size: 0.9rem;">
        Questions? Email <a href="mailto:hello@awardhome.com" style="color: var(--accent-gold);">hello@awardhome.com</a>.
      </p>
    <% } else { %>
      <h1 style="font-size: 1.6rem; margin-bottom: 0.5rem;">Claim <%= orgName %></h1>
      <p style="color: var(--text-muted); margin-bottom: 1.75rem; line-height: 1.6;">
        This private link sets up your free organizer account: your branding on every award card,
        permanent hosted results, and a dashboard to send us new event results.
      </p>

      <% if (typeof existingAccount !== 'undefined' && existingAccount) { %>
        <div style="background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.3); color: #eab308; padding: 0.9rem 1.2rem; border-radius: 8px; margin-bottom: 1.5rem;">
          <%= existingAccount %>
        </div>
        <a href="/login?next=/claim/org/<%= token %>" class="btn btn-primary" style="display: block; text-align: center; text-decoration: none;">Log In to Continue</a>
      <% } else if (user) { %>
        <p style="margin-bottom: 1.5rem;">You're logged in as <strong><%= user.email %></strong>. Claim <%= orgName %> with this account?</p>
        <form action="/claim/org/<%= token %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem;">Claim <%= orgName %></button>
        </form>
        <p style="margin-top: 1rem; color: var(--text-muted); font-size: 0.85rem;">
          Want to use a different account? <a href="/logout" style="color: var(--accent-gold);">Log out</a> first, then reopen the link from your email.
        </p>
      <% } else { %>
        <form action="/claim/org/<%= token %>" method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div>
            <label style="display: block; margin-bottom: 0.4rem; color: var(--text-muted); font-size: 0.9rem;">Email</label>
            <input type="email" name="email" value="<%= prefillEmail || '' %>" required
              style="width: 100%; padding: 0.75rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.15); background: rgba(0,0,0,0.25); color: white;">
          </div>
          <div>
            <label style="display: block; margin-bottom: 0.4rem; color: var(--text-muted); font-size: 0.9rem;">Password (8+ characters)</label>
            <input type="password" name="password" minlength="8" required
              style="width: 100%; padding: 0.75rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.15); background: rgba(0,0,0,0.25); color: white;">
          </div>
          <div>
            <label style="display: block; margin-bottom: 0.4rem; color: var(--text-muted); font-size: 0.9rem;">Confirm password</label>
            <input type="password" name="password_confirm" minlength="8" required
              style="width: 100%; padding: 0.75rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.15); background: rgba(0,0,0,0.25); color: white;">
          </div>
          <button type="submit" class="btn btn-primary" style="padding: 0.85rem; margin-top: 0.5rem;">Create Account &amp; Claim <%= orgName %></button>
        </form>
        <p style="margin-top: 1rem; color: var(--text-muted); font-size: 0.85rem;">
          Already have an AwardHome account? <a href="/login?next=/claim/org/<%= token %>" style="color: var(--accent-gold);">Log in</a> and you'll come straight back here.
        </p>
      <% } %>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
