<%- include('partials/header') %>
<div class="container" style="margin-top: 4rem;">
  <div class="header-section">
    <h1>Partner API Keys</h1>
    <p class="subtitle">Keyed access to <code>/api/v1/partner</code> — exact-match dancer lookups for vetted partners (schools verifying applicants). Every lookup is audited below; quotas count from the audit log. The API ships dark until the <code>partner_api</code> flag is on (<a href="/admin/features" style="color: var(--primary);">Release Console</a>).</p>
  </div>

  <% if (error) { %>
    <div class="card glass-card" style="margin-top: 1.5rem; padding: 1rem 1.5rem; border-color: rgba(239, 68, 68, 0.4);">
      <p style="margin: 0; color: #ef4444;"><%= error %></p>
    </div>
  <% } %>
  <% if (success) { %>
    <div class="card glass-card" style="margin-top: 1.5rem; padding: 1rem 1.5rem; border-color: rgba(34, 197, 94, 0.4);">
      <p style="margin: 0; color: #22c55e;"><%= success %></p>
    </div>
  <% } %>

  <% if (issued) { %>
    <div class="card glass-card" style="margin-top: 1.5rem; padding: 1.5rem; border-color: rgba(251, 191, 36, 0.5);">
      <h3 style="color: #fbbf24;">Key issued for <%= issued.partnerName %> — copy it NOW</h3>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Only the hash is stored. This is the one and only time the key is shown; if it is lost, revoke and reissue.</p>
      <code style="display: block; margin-top: 0.8rem; padding: 0.8rem; background: rgba(0,0,0,0.35); border-radius: 6px; font-size: 0.95rem; word-break: break-all; user-select: all;"><%= issued.rawKey %></code>
    </div>
  <% } %>

  <div class="card glass-card" style="margin-top: 2rem; padding: 2rem;">
    <h3>Issue a Key</h3>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.3rem;">
      Only after the partner has signed the data agreement (template: <code>docs/partner_data_agreement.md</code> —
      purpose limitation, no retention/resale, no re-identification, deletion propagation on suppression notices,
      $10 per 100 dancer records prepaid). Reference the signed copy below — no agreement, no key.
    </p>
    <form action="/admin/partner-keys/issue" method="POST" style="margin-top: 1rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; align-items: end;">
      <div>
        <label for="partner_name" style="display: block; font-size: 0.9rem; margin-bottom: 0.3rem;">Partner name</label>
        <input type="text" id="partner_name" name="partner_name" class="form-control" required style="width: 100%;" placeholder="Westlake Academy">
      </div>
      <div>
        <label for="contact_email" style="display: block; font-size: 0.9rem; margin-bottom: 0.3rem;">Contact email</label>
        <input type="email" id="contact_email" name="contact_email" class="form-control" style="width: 100%;">
      </div>
      <div>
        <label for="daily_quota" style="display: block; font-size: 0.9rem; margin-bottom: 0.3rem;">Daily quota</label>
        <input type="number" id="daily_quota" name="daily_quota" class="form-control" value="200" min="1" style="width: 100%;">
      </div>
      <div>
        <label for="agreement_note" style="display: block; font-size: 0.9rem; margin-bottom: 0.3rem;">Data agreement reference</label>
        <input type="text" id="agreement_note" name="agreement_note" class="form-control" required style="width: 100%;" placeholder="DPA signed 2026-09-04, Drive folder …">
      </div>
      <div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Issue Key</button>
      </div>
    </form>
  </div>

  <div class="card glass-card" style="margin-top: 2rem; overflow-x: auto;">
    <h3 style="padding: 1rem 1rem 0;">Keys</h3>
    <table class="premium-table">
      <thead>
        <tr>
          <th>Partner</th><th>Contact</th><th>Quota/day</th><th>Today</th><th>Total</th>
          <th title="Unique dancer records this calendar month — $10 per 100 (agreement §9)">Billable (mo.)</th>
          <th>Last used</th><th>Agreement</th><th>Status</th><th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (keys.length === 0) { %>
          <tr><td colspan="10" style="text-align: center;">No keys issued.</td></tr>
        <% } else { %>
          <% keys.forEach(function(k) { %>
            <tr>
              <td><%= k.partner_name %></td>
              <td><%= k.contact_email || '—' %></td>
              <td><%= k.daily_quota %></td>
              <td><%= k.queries_today %></td>
              <td><%= k.queries_total %></td>
              <td><%= k.billable_month %> <span style="color: var(--text-muted); font-size: 0.8rem;">($<%= (k.billable_month * 0.10).toFixed(2) %>)</span></td>
              <td><%= k.last_used_at || 'never' %></td>
              <td style="max-width: 220px; font-size: 0.85rem;"><%= k.agreement_note || '—' %></td>
              <td><%= k.revoked_at ? ('revoked ' + k.revoked_at) : 'active' %></td>
              <td>
                <% if (!k.revoked_at) { %>
                <form action="/admin/partner-keys/<%= k.id %>/revoke" method="POST" style="margin: 0;"
                      onsubmit="return confirm('Revoke the key for <%= k.partner_name %>? It stops working immediately.');">
                  <input type="hidden" name="reason" value="revoked from admin">
                  <button type="submit" class="btn btn-secondary" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.4rem 0.8rem; border-radius: 4px; cursor: pointer; font-size: 0.8rem;">Revoke</button>
                </form>
                <% } else { %>—<% } %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="card glass-card" style="margin-top: 2rem; overflow-x: auto;">
    <h3 style="padding: 1rem 1rem 0;">Recent Lookups <span style="font-weight: normal; color: var(--text-muted); font-size: 0.85rem;">(append-only audit — the answer to "who has looked up my child?")</span></h3>
    <table class="premium-table">
      <thead>
        <tr><th>When</th><th>Partner</th><th>Endpoint</th><th>Name asked</th><th>Studio asked</th><th>Dancers returned</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% if (log.length === 0) { %>
          <tr><td colspan="7" style="text-align: center;">No lookups yet.</td></tr>
        <% } else { %>
          <% log.forEach(function(l) { %>
            <tr>
              <td style="white-space: nowrap;"><%= l.created_at %></td>
              <td><%= l.partner_name %></td>
              <td style="font-family: monospace; font-size: 0.8rem;"><%= l.endpoint %></td>
              <td><%= l.query_name || '—' %></td>
              <td><%= l.query_studio || '—' %></td>
              <td style="font-family: monospace; font-size: 0.8rem; max-width: 240px; overflow: hidden; text-overflow: ellipsis;"><%= l.dancer_unique_ids || '—' %></td>
              <td><%= l.status %></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/footer') %>
