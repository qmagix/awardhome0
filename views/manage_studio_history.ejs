<%- include('partials/header') %>

<div class="container manage-layout" style="margin-top: 4rem; display: flex; gap: 2rem;">
  
  <!-- Sidebar Navigation -->
  <div class="manage-sidebar" style="width: 250px; flex-shrink: 0;">
    <div class="card glass-card" style="padding: 1.5rem; position: sticky; top: 2rem;">
      <h3 style="margin-top: 0; color: var(--primary); font-size: 1.1rem;">Management</h3>
      <ul style="list-style: none; padding: 0; margin: 1rem 0 0 0; display: flex; flex-direction: column; gap: 0.5rem;">
        <li>
          <a href="/manage/studio/<%= studio.id %>" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            👤 Profile & Customization
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/roster" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            👥 Dancer Roster
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/group-dancers" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            🎭 Check Routine Dancers<% if (typeof missingRoutinesCount !== 'undefined' && missingRoutinesCount > 0) { %> <span style="background: rgba(245,158,11,0.2); color: #fbbf24; border-radius: 10px; padding: 0.05rem 0.5rem; font-size: 0.75rem; font-weight: 700;"><%= missingRoutinesCount %></span><% } %>
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/routines" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            🗂 All Routines
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/history" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: white; background: rgba(212, 175, 55, 0.1); border-left: 3px solid var(--primary); font-weight: 600;">
            📊 Organization History
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/awards" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            🏆 Awards Editor
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/widget" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            📈 Widget Builder
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/verifications" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            ✅ Pending Verifications
          </a>
        </li>
        <li>
          <a href="/manage/studio/<%= studio.id %>/ai-summaries" style="display: block; padding: 0.75rem 1rem; border-radius: 6px; text-decoration: none; color: var(--text-muted); transition: background 0.2s;">
            ✨ AI Summaries
          </a>
        </li>
      </ul>
      
      <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.1);">
        <a href="/dance/studio/<%= studio.unique_id %>" style="color: var(--primary); text-decoration: none; font-size: 0.9rem;">&larr; Back to Public Profile</a>
      </div>
    </div>
  </div>

  <!-- Main Content Area -->
  <div style="flex-grow: 1;">
    <div class="header-section" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end;">
      <div>
        <h1>Organization History</h1>
        <p class="subtitle">A complete breakdown of events you've attended, summarized by organization.</p>
      </div>
      <div>
        <a href="/manage/studio/<%= studio.id %>#visibility" class="btn" style="background: rgba(255,255,255,0.1); color: white;">Manage Public Visibility</a>
      </div>
    </div>

    <!-- Org Cards -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <% if (orgs.length === 0) { %>
        <div class="card glass-card" style="text-align: center; padding: 3rem; color: var(--text-muted);">
          No events attended yet. Start adding awards to see your history!
        </div>
      <% } else { %>
        <% orgs.forEach(org => { %>
          <div class="card glass-card" style="padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1rem;">
              <div style="display: flex; align-items: center; gap: 1rem;">
                <% if (org.logo_url) { %>
                  <img src="<%= org.logo_url %>" alt="<%= org.name %>" style="height: 40px; border-radius: 4px;">
                <% } else { %>
                  <div style="width: 40px; height: 40px; border-radius: 4px; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--text-muted);"><%= org.name.substring(0, 2).toUpperCase() %></div>
                <% } %>
                <div style="display: flex; flex-direction: column;">
                  <h2 style="margin: 0; color: white; display: flex; align-items: center; gap: 1rem;">
                    <%= org.name %>
                  </h2>
                  <button type="button" class="btn" style="background: rgba(255, 255, 255, 0.08); color: #e0e0e0; border: 1px solid rgba(255, 255, 255, 0.15); padding: 0.25rem 0.75rem; font-size: 0.8rem; margin-top: 0.5rem; width: fit-content; cursor: pointer;" data-studio-id="<%= studio.id %>" data-org-id="<%= org.id %>" data-org-name="<%= org.name %>" onclick="generateSummary(this.dataset.studioId, this.dataset.orgId, this.dataset.orgName)">
                    📄 Generate Text Summary
                  </button>
                </div>
              </div>
              <div style="display: flex; gap: 1.5rem; text-align: right;">
                <div>
                  <div style="font-size: 0.8rem; color: var(--text-muted);">Total Awards</div>
                  <div style="font-size: 1.5rem; font-weight: bold; color: white;"><%= org.total_awards_all_time %></div>
                </div>
                <div>
                  <div style="font-size: 0.8rem; color: var(--text-muted);">1st Places</div>
                  <div style="font-size: 1.5rem; font-weight: bold; color: var(--primary);"><%= org.first_places_all_time %></div>
                </div>
                <div>
                  <div style="font-size: 0.8rem; color: var(--text-muted);">Major Awards
                    <button type="button" onclick="openMajorInfo()" title="What counts as a Major Award?"
                      style="background: none; border: none; color: var(--primary); cursor: pointer; padding: 0 0 0 0.15rem; font-size: 0.85rem; line-height: 1;">&#9432;</button>
                  </div>
                  <div style="font-size: 1.5rem; font-weight: bold; color: #aa8529;"><%= org.major_awards_all_time %></div>
                  <% if (!org.curated) { %><div style="font-size: 0.65rem; color: var(--text-muted);" title="This competition's own award rules aren't encoded yet, so this is a provisional keyword estimate">provisional</div><% } %>
                </div>
                <% if (org.division_placements_all_time > 0) { %>
                  <div title="Division-wide overall placements (1st-3rd) — an overall 1st is the regional or national champion. Included in Major Awards.">
                    <div style="font-size: 0.8rem; color: var(--text-muted);">Division Placements</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #aa8529;"><%= org.division_placements_all_time %></div>
                  </div>
                <% } %>
                <% if (org.highlights_all_time > 0) { %>
                  <div title="Your own emphasis — private to this page, and it shapes your AI summaries. Never shown publicly.">
                    <div style="font-size: 0.8rem; color: var(--text-muted);">Your Highlights 🔒</div>
                    <div style="font-size: 1.5rem; font-weight: bold; color: #60a5fa;"><%= org.highlights_all_time %></div>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Year by Year Breakdown -->
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <% const sortedYears = Object.keys(org.years).sort((a,b) => b - a); %>
              <% sortedYears.forEach(year => { const yrData = org.years[year]; %>
                <details style="background: rgba(0,0,0,0.3); border-radius: 6px;">
                  <summary style="padding: 1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none;">
                    <div style="display: flex; align-items: center; gap: 1rem;">
                      <span style="font-weight: bold; color: white; font-size: 1.1rem;"><%= year %></span>
                      <span style="color: var(--text-muted); font-size: 0.9rem;"><%= yrData.events.length %> Event(s)</span>
                    </div>
                    <div style="display: flex; gap: 1rem; font-size: 0.9rem; align-items: center;">
                      <span style="color: var(--text-muted);">Awards: <strong style="color: white;"><%= yrData.total_awards %></strong></span>
                      <span style="color: var(--text-muted);">1st Places: <strong style="color: var(--primary);"><%= yrData.first_places %></strong></span>
                      <span style="color: var(--text-muted);">Major: <strong style="color: #aa8529;"><%= yrData.major_awards %></strong></span>
                      <span class="yr-chevron" aria-hidden="true">&#9662;</span>
                    </div>
                  </summary>
                  <div style="padding: 0 1rem 1rem 1rem; border-top: 1px solid rgba(255,255,255,0.05); margin-top: 0.5rem; padding-top: 1rem;">
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                      <% yrData.events.forEach(evt => { %>
                        <details style="background: rgba(0,0,0,0.2); border-radius: 4px; border: 1px solid rgba(255,255,255,0.05);">
                          <summary style="padding: 0.75rem 1rem; cursor: pointer; display: flex; align-items: center; justify-content: space-between; font-size: 0.9rem;">
                            <div>
                              <strong style="color: white;"><%= evt.name %></strong> 
                              <span style="margin-left: 0.5rem; font-size: 0.85rem; color: var(--text-muted);">(<%= evt.total_awards %> Awards, <%= evt.first_places %> 1st Places)</span>
                            </div>
                          </summary>
                          <div style="padding: 0 1rem 1rem 1rem; overflow-x: auto;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
                              <thead>
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.1); color: var(--text-muted); text-align: left;">
                                  <th style="padding: 0.5rem;">Award</th>
                                  <th style="padding: 0.5rem;">Routine</th>
                                  <th style="padding: 0.5rem;">Category / Age</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% evt.awards.sort((a,b) => {
                                  const pA = parseInt(a.place) || 999;
                                  const pB = parseInt(b.place) || 999;
                                  return pA - pB;
                                }).forEach(award => { %>
                                  <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                    <td style="padding: 0.5rem;">
                                      <% if (award.is_first_place) { %>🥇 <% } %>
                                      <strong style="color: white;"><%= award.place %></strong>
                                      <% if (award.award_class) { %>
                                        <span style="color: var(--text-muted); font-size: 0.75rem; display: block; text-transform: capitalize;"><%= award.award_class %></span>
                                      <% } %>
                                    </td>
                                    <td style="padding: 0.5rem; color: white;">
                                      <%= award.performance_name || 'N/A' %>
                                      <% if (award.dancers && award.dancers.length > 0) { %>
                                        <div style="margin-top: 0.3rem; font-size: 0.75rem; color: var(--text-muted);">
                                          <%= award.dancers.join(', ') %>
                                        </div>
                                      <% } %>
                                    </td>
                                    <td style="padding: 0.5rem; color: var(--text-muted);">
                                      <%= award.category || award.award_type || 'N/A' %>
                                      <% if (award.age_division) { %>
                                        <span class="badge" style="background: rgba(255, 255, 255, 0.08); color: #e0e0e0; border: 1px solid rgba(255, 255, 255, 0.15); font-size: 0.7rem; padding: 0.1rem 0.3rem; margin-left: 0.3rem;"><%= award.age_division %></span>
                                      <% } %>
                                    </td>
                                  </tr>
                                <% }) %>
                              </tbody>
                            </table>
                          </div>
                        </details>
                      <% }) %>
                    </div>
                  </div>
                </details>
              <% }) %>
            </div>

          </div>
        <% }) %>
      <% } %>
    </div>

  </div>
</div>

<!-- Summary Modal -->
<div id="summaryModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; justify-content: center; align-items: center;">
  <div class="card glass-card" style="width: 100%; max-width: 700px; max-height: 90vh; display: flex; flex-direction: column; padding: 2rem; position: relative;">
    <button type="button" onclick="document.getElementById('summaryModal').style.display='none'" style="position: absolute; top: 1rem; right: 1rem; background: none; border: none; color: var(--text-muted); font-size: 1.5rem; cursor: pointer;">&times;</button>
    <h2 style="margin-top: 0; margin-bottom: 1rem;" id="summaryModalTitle">Awards Summary</h2>
    
    <!-- Step 1: Selection -->
    <div id="summaryStep1" style="display: flex; flex-direction: column; overflow-y: auto; flex: 1;">
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0; margin-bottom: 1rem;">Select the awards you want to include in the text summary.</p>
      
      <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
        <select id="aiToneSelect" style="flex: 1; padding: 0.5rem; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 4px;">
          <option value="Enthusiastic">Tone: Enthusiastic (Social Media)</option>
          <option value="Professional">Tone: Professional (Press Release)</option>
        </select>
        <button type="button" class="btn" id="btnGenerateAi" style="background: rgba(255, 255, 255, 0.08); color: #e0e0e0; border: 1px solid rgba(255, 255, 255, 0.15); flex: 1;" onclick="generateAiSummary()">✨ Generate AI Summary</button>
      </div>
      <p style="color: var(--text-muted); font-size: 0.82rem; margin: -0.5rem 0 1rem;">
        The writer leads with whatever you marked as notable or headline in
        <button type="button" onclick="openMajorInfo()" style="background: none; border: none; color: #60a5fa; text-decoration: underline; cursor: pointer; padding: 0; font-size: 0.82rem;">your emphasis settings</button> 🔒
      </p>

      <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
        <button type="button" class="btn" style="background: rgba(255,255,255,0.1); border: none; color: white; font-size: 0.8rem; padding: 0.25rem 0.5rem;" onclick="selectAllAwards()">Select All</button>
        <button type="button" class="btn" style="background: rgba(255,255,255,0.1); border: none; color: white; font-size: 0.8rem; padding: 0.25rem 0.5rem;" onclick="selectMostRecentYear()">Most Recent Year Only</button>
        <button type="button" class="btn" style="background: rgba(255,255,255,0.1); border: none; color: white; font-size: 0.8rem; padding: 0.25rem 0.5rem;" onclick="deselectAllAwards()">Clear All</button>
      </div>
      <div id="summaryChecklist" style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.05); color: white; margin-bottom: 1rem; overflow-y: auto;">
        Loading...
      </div>
      <button type="button" class="btn btn-primary" style="width: 100%; flex-shrink: 0;" onclick="buildFinalText()">➡️ Generate Raw Text Summary</button>
    </div>

    <!-- Step 2: Output -->
    <div id="summaryStep2" style="display: none; flex-direction: column; flex: 1;">
      <button type="button" class="btn" style="background: rgba(255,255,255,0.1); border: none; color: white; margin-bottom: 1rem; width: fit-content;" onclick="document.getElementById('summaryStep2').style.display='none'; document.getElementById('summaryStep1').style.display='flex';">⬅️ Back to Selection</button>
      <textarea id="summaryTextarea" style="width: 100%; height: 400px; padding: 1rem; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 4px; font-family: monospace; resize: vertical;" oninput="handleTextareaEdit()"></textarea>
      <div id="saveStatus" style="font-size: 0.8rem; color: var(--text-muted); text-align: right; margin-top: 0.5rem; height: 1rem;"></div>
      <button type="button" class="btn btn-primary" style="margin-top: 0.5rem; width: 100%; flex-shrink: 0;" onclick="copySummary(event)">📋 Copy to Clipboard</button>
    </div>
  </div>
</div>

<script>
let currentOrgName = '';
let currentStudioId = null;
let currentOrgId = null;
let currentAiSummaryId = null;
let saveTimeout = null;

async function generateSummary(studioId, orgId, orgName) {
  currentStudioId = studioId;
  currentOrgId = orgId;
  currentOrgName = orgName;
  document.getElementById('summaryModalTitle').innerText = orgName + ' Summary';
  document.getElementById('summaryChecklist').innerHTML = 'Loading...';
  
  document.getElementById('summaryStep1').style.display = 'flex';
  document.getElementById('summaryStep2').style.display = 'none';
  document.getElementById('summaryModal').style.display = 'flex';
  
  try {
    const res = await fetch(`/api/studio/${studioId}/history/org/${orgId}/summary`);
    const data = await res.json();
    
    if (!data.groups || Object.keys(data.groups).length === 0) {
      document.getElementById('summaryChecklist').innerHTML = '<div style="color: var(--text-muted);">No awards found.</div>';
      return;
    }

    let html = '';
    const sortedYears = Object.keys(data.groups).sort();
    
    for (const year of sortedYears) {
      html += `<div class="summary-year-group" data-year="${year}" style="margin-bottom: 1.5rem;">`;
      html += `<h3 style="margin-top: 0; margin-bottom: 0.5rem; color: #e0e0e0;">${year}</h3>`;
      
      const divKeys = Object.keys(data.groups[year]).sort();
      for (const div of divKeys) {
        html += `<div class="summary-div-group" data-div="${div}" style="margin-left: 1rem; margin-bottom: 1rem;">`;
        if (div !== 'Others') {
          html += `<div style="font-weight: bold; margin-bottom: 0.5rem; color: var(--text-muted);">${div}</div>`;
        }
        
        data.groups[year][div].forEach(award => {
          const checked = award.autoCheck ? 'checked' : '';
          html += `
            <label style="display: flex; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.5rem; cursor: pointer; font-size: 0.9rem;">
              <input type="checkbox" class="award-checkbox" data-text="${award.text.replace(/"/g, '&quot;')}" ${checked} style="margin-top: 0.2rem;">
              <span>${award.text}</span>
            </label>
          `;
        });
        html += `</div>`;
      }
      html += `</div>`;
    }
    
    document.getElementById('summaryChecklist').innerHTML = html;

  } catch (err) {
    document.getElementById('summaryChecklist').innerHTML = '<div style="color: red;">Error loading summary.</div>';
    console.error(err);
  }
}

function getSelectedAwards() {
  const selected = [];
  const checkboxes = document.querySelectorAll('.award-checkbox:checked');
  checkboxes.forEach(cb => {
    selected.push(cb.getAttribute('data-text'));
  });
  return selected;
}

function selectAllAwards() {
  document.querySelectorAll('.award-checkbox').forEach(cb => cb.checked = true);
}

function deselectAllAwards() {
  document.querySelectorAll('.award-checkbox').forEach(cb => cb.checked = false);
}

function selectMostRecentYear() {
  deselectAllAwards();
  const yearGroups = document.querySelectorAll('.summary-year-group');
  if (yearGroups.length > 0) {
    let maxYearStr = "0";
    let maxGroup = null;
    yearGroups.forEach(yg => {
      const y = yg.getAttribute('data-year');
      if (y > maxYearStr) {
        maxYearStr = y;
        maxGroup = yg;
      }
    });
    if (maxGroup) {
      maxGroup.querySelectorAll('.award-checkbox').forEach(cb => cb.checked = true);
    }
  }
}

async function generateAiSummary() {
  const selectedAwards = getSelectedAwards();
  if (selectedAwards.length === 0) return alert('Please select at least one award.');
  
  const tone = document.getElementById('aiToneSelect').value;
  const btn = document.getElementById('btnGenerateAi');
  btn.innerText = '✨ Generating...';
  btn.disabled = true;

  try {
    const res = await fetch(`/api/studio/${currentStudioId}/history/org/${currentOrgId}/ai-summary`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tone, awardsList: selectedAwards, orgName: currentOrgName })
    });
    const data = await res.json();
    
    currentAiSummaryId = data.id;
    document.getElementById('summaryTextarea').value = data.text;
    document.getElementById('summaryStep1').style.display = 'none';
    document.getElementById('summaryStep2').style.display = 'flex';
    document.getElementById('saveStatus').innerText = 'AI generated successfully.';
  } catch (err) {
    console.error(err);
    alert('Failed to generate AI summary.');
  } finally {
    btn.innerText = '✨ Generate AI Summary';
    btn.disabled = false;
  }
}

function handleTextareaEdit() {
  if (!currentAiSummaryId) return; // Only autosave if it's an AI summary
  
  document.getElementById('saveStatus').innerText = 'Saving...';
  clearTimeout(saveTimeout);
  
  saveTimeout = setTimeout(async () => {
    const text = document.getElementById('summaryTextarea').value;
    try {
      await fetch(`/api/studio/ai-summary/${currentAiSummaryId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text })
      });
      document.getElementById('saveStatus').innerText = 'All edits saved to database.';
    } catch (err) {
      document.getElementById('saveStatus').innerText = 'Failed to save edits.';
      console.error(err);
    }
  }, 1000);
}

function buildFinalText() {
  currentAiSummaryId = null; // Clear AI tracking for raw text
  document.getElementById('saveStatus').innerText = '';
  let summaryText = currentOrgName + " awards history\n\n";
  
  const yearGroups = document.querySelectorAll('.summary-year-group');
  
  yearGroups.forEach(yg => {
    const yearStr = yg.getAttribute('data-year');
    let yearHasItems = false;
    let yearTextBlock = `${yearStr}\n\n`;
    
    const divGroups = yg.querySelectorAll('.summary-div-group');
    divGroups.forEach(dg => {
      const divStr = dg.getAttribute('data-div');
      const checkboxes = dg.querySelectorAll('.award-checkbox:checked');
      
      if (checkboxes.length > 0) {
        yearHasItems = true;
        if (divStr !== 'Others') {
          yearTextBlock += `${divStr}\n`;
        }
        checkboxes.forEach(cb => {
          yearTextBlock += `${cb.getAttribute('data-text')}\n`;
        });
        yearTextBlock += `\n`;
      }
    });
    
    if (yearHasItems) {
      summaryText += yearTextBlock;
    }
  });

  document.getElementById('summaryTextarea').value = summaryText.trim();
  document.getElementById('summaryStep1').style.display = 'none';
  document.getElementById('summaryStep2').style.display = 'flex';
}

function copySummary(event) {
  const textarea = document.getElementById('summaryTextarea');
  textarea.select();
  document.execCommand('copy');
  
  const btn = event.target;
  const oldText = btn.innerText;
  btn.innerText = '✅ Copied!';
  setTimeout(() => btn.innerText = oldText, 2000);
}
</script>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
  /* The chevron used to be an absolutely-positioned ::after pinned to the
     summary's right edge, where it sat on top of the "Major: n" figure.
     It is now a real flex item at the end of the stats row, so it can
     never overlap. */
  .yr-chevron {
    color: var(--text-muted);
    font-size: 0.85rem;
    transition: transform 0.2s;
    display: inline-block;
    width: 1rem;
    text-align: center;
  }
  details[open] > summary .yr-chevron {
    transform: rotate(180deg);
  }
  details > summary:hover .yr-chevron { color: var(--primary); }
</style>

<!-- What counts as a Major Award? -->
<div id="majorInfoModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 2000; align-items: flex-start; justify-content: center; overflow-y: auto; padding: 3rem 1rem;">
  <div class="card glass-card" style="max-width: 640px; width: 100%; padding: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
      <h3 style="margin: 0; color: var(--primary);">What counts as a Major Award?</h3>
      <button onclick="document.getElementById('majorInfoModal').style.display='none'" class="btn" style="background: rgba(255,255,255,0.1); color: white; padding: 0.25rem 0.7rem;">&#10005;</button>
    </div>
    <p style="color: var(--text-muted); line-height: 1.6; margin: 1rem 0 0;">
      Where we've encoded a competition's own published rules, a
      <strong style="color: #aa8529;">Major Award</strong> is one of three things: a
      <strong>headline win</strong> (grand champion, Mr./Miss title, Grand Prix, Dancer of the Year), a
      <strong>division overall placement</strong> (1st-3rd across a whole division — an overall 1st is
      effectively the regional or national champion), or a <strong>named special award</strong>
      (judges' honors like Odyssey or Best of JUMP). Adjudication bands (Platinum, High Gold, and
      confusingly-named ones like KAR's "First Place"), narrow-category placements, and invitations
      never count. For competitions we haven't encoded yet, the figure is a provisional keyword
      estimate and is labelled as such.
    </p>
    <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.6; margin: 0.75rem 0 0;">
      This figure also appears on your <strong>public studio page</strong>, so the definition is the same for
      every studio on AwardHome Dance and isn't self-editable — that's what keeps it meaningful to the families and
      organizers reading it. Your awards below are exactly the ones being counted; if something looks wrong,
      tell us and we'll fix the classification for everyone.
    </p>
    <div id="majorInfoList" style="margin-top: 1.25rem; color: var(--text-muted);">Loading your major awards…</div>

    <div style="margin-top: 1.75rem; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.25rem;">
      <h4 style="margin: 0 0 0.4rem; color: #60a5fa;">Your own emphasis 🔒</h4>
      <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.6; margin: 0 0 0.5rem;">
        You know your circuit better than any keyword rule does. Mark what a win really means at your
        studio — it's <strong>private</strong>, it powers the "Your Highlights" figure on this page, and it
        tells the <strong>AI summary writer</strong> what to lead with and what to skip. The public
        Major Awards number never changes.
      </p>
      <p style="color: var(--text-muted); font-size: 0.82rem; line-height: 1.6; margin: 0 0 0.75rem;">
        We also read these pooled across all studios — with no way to inflate a public number, honest
        marks are the useful ones — to improve how AwardHome classifies awards for everyone.
      </p>
      <div id="weightList" style="max-height: 300px; overflow-y: auto;">Loading your award types…</div>
      <div style="margin-top: 0.75rem; display: flex; align-items: center; gap: 0.75rem;">
        <button onclick="saveWeights()" class="btn" style="background: #60a5fa; color: #0a0a0a; font-weight: 600; padding: 0.45rem 1.1rem;">Save emphasis</button>
        <span id="weightStatus" style="color: var(--text-muted); font-size: 0.85rem;"></span>
      </div>
    </div>
    <div style="margin-top: 1.5rem; display: flex; gap: 0.75rem; justify-content: flex-end;">
      <a class="btn" href="mailto:hello@awardhome.com?subject=Major%20Award%20classification%20-%20<%= encodeURIComponent(studio.name) %>"
        style="background: transparent; border: 1px solid var(--primary); color: var(--primary); text-decoration: none; padding: 0.5rem 1rem;">Something looks wrong</a>
      <button onclick="document.getElementById('majorInfoModal').style.display='none'" class="btn" style="background: var(--primary); color: #0a0a0a; font-weight: 600; padding: 0.5rem 1.2rem;">Got it</button>
    </div>
  </div>
</div>
<script>
  let majorInfoLoaded = false;
  function openMajorInfo() {
    const modal = document.getElementById('majorInfoModal');
    modal.style.display = 'flex';
    if (majorInfoLoaded) return;
    majorInfoLoaded = true;
    loadWeights();
    fetch('/manage/studio/<%= studio.id %>/history/major-awards')
      .then(r => r.ok ? r.json() : Promise.reject())
      .then(d => {
        const box = document.getElementById('majorInfoList');
        if (!d.count) { box.textContent = 'No awards currently meet this bar — the first one is coming.'; return; }
        const esc = t => String(t || '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
        box.innerHTML = '<div style="font-weight: 600; color: white; margin-bottom: 0.5rem;">Your ' + d.count
          + ' major award' + (d.count === 1 ? '' : 's') + '</div>'
          + '<div style="max-height: 260px; overflow-y: auto; font-size: 0.88rem; line-height: 1.7;">'
          + d.awards.map(a => '<div style="border-bottom: 1px solid rgba(255,255,255,0.06); padding: 0.35rem 0;">'
              + '<span style="color: #aa8529;">' + esc(a.award_type || a.category) + '</span>'
              + (a.performance_name ? ' <span style="color: white;">&mdash; ' + esc(a.performance_name) + '</span>' : '')
              + '<div style="color: var(--text-muted); font-size: 0.82rem;">' + esc(a.event_name) + ' &middot; ' + esc(a.year) + '</div>'
            + '</div>').join('')
          + '</div>';
      })
      .catch(() => { document.getElementById('majorInfoList').textContent = 'Could not load the list right now.'; });
  }
  function loadWeights() {
    fetch('/manage/studio/<%= studio.id %>/history/weights')
      .then(r => r.ok ? r.json() : Promise.reject())
      .then(d => {
        const box = document.getElementById('weightList');
        if (!d.terms.length) { box.textContent = 'No award types on record yet.'; return; }
        const esc = t => String(t || '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        box.innerHTML = d.terms.map(t => {
          const opts = Object.entries(d.scale).map(([v, label]) =>
            `<option value="${v}" ${String(t.weight) === v ? 'selected' : ''}>${label}</option>`).join('');
          return `<div style="display: flex; align-items: center; gap: 0.75rem; padding: 0.35rem 0; border-bottom: 1px solid rgba(255,255,255,0.06);">
            <div style="flex: 1; min-width: 0;">
              <div style="color: white; font-size: 0.9rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${esc(t.term)}</div>
              <div style="color: var(--text-muted); font-size: 0.78rem;">${t.firsts} first place${t.firsts === 1 ? '' : 's'} of ${t.count}</div>
            </div>
            <select class="weight-select" data-key="${esc(t.key)}"
              style="background: rgba(0,0,0,0.35); color: white; border: 1px solid rgba(255,255,255,0.15); border-radius: 6px; padding: 0.3rem 0.5rem; font-size: 0.85rem;">${opts}</select>
          </div>`;
        }).join('');
      })
      .catch(() => { document.getElementById('weightList').textContent = 'Could not load your award types.'; });
  }

  async function saveWeights() {
    const weights = [...document.querySelectorAll('.weight-select')]
      .map(sel => ({ key: sel.dataset.key, weight: parseInt(sel.value, 10) }));
    const status = document.getElementById('weightStatus');
    status.textContent = 'Saving…';
    try {
      const res = await fetch('/manage/studio/<%= studio.id %>/history/weights', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ weights }),
      });
      if (!res.ok) throw new Error();
      status.textContent = 'Saved — reloading…';
      setTimeout(() => location.reload(), 800);
    } catch (e) { status.textContent = 'Could not save — please try again.'; }
  }

  document.getElementById('majorInfoModal').addEventListener('click', function (e) {
    if (e.target === this) this.style.display = 'none';
  });
</script>

