<%- include('partials/header') %>
<link rel="stylesheet" href="/css/studio_v2.css">
<link rel="stylesheet" href="/css/dance_home_v2.css">
<style>
  /* Directory-only styles, layered on the Rafters base tokens. */
  .v2 .ue-filters { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: flex-end; justify-content: center; margin: 1.5rem 0 0; }
  .v2 .ue-filters label { display: block; font-family: var(--v2-display); font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--v2-ink-mut); margin-bottom: 0.35rem; }
  .v2 .ue-filters select { background: var(--v2-curtain); color: var(--v2-ink); border: 1px solid var(--v2-hairline-strong); border-radius: 6px; padding: 0.55rem 0.75rem; font-family: var(--v2-body); font-size: 0.95rem; min-width: 10.5rem; }
  .v2 .ue-filters .ue-clear { color: var(--v2-ink-mut); font-size: 0.85rem; text-decoration: underline; padding-bottom: 0.65rem; }
  .v2 .ue-month { font-family: var(--v2-display); color: var(--v2-champagne); letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.95rem; margin: 2.5rem 0 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--v2-hairline); }
  .v2 .ue-row { display: grid; grid-template-columns: 8.5rem 1fr auto; gap: 1rem; align-items: center; padding: 0.9rem 1rem; border: 1px solid var(--v2-hairline); border-radius: 8px; background: linear-gradient(145deg, var(--v2-curtain) 0%, var(--v2-stage) 100%); margin-bottom: 0.6rem; }
  .v2 .ue-dates { font-family: var(--v2-display); color: var(--v2-gold); font-size: 0.85rem; letter-spacing: 0.05em; }
  .v2 .ue-org { font-family: var(--v2-display); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--v2-ink-mut); margin-bottom: 0.2rem; }
  .v2 .ue-name { color: var(--v2-ink); font-size: 1.05rem; }
  .v2 .ue-place { color: var(--v2-ink-mut); font-size: 0.9rem; margin-top: 0.15rem; }
  .v2 .ue-reg { font-family: var(--v2-display); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--v2-plate-text); background: linear-gradient(160deg, var(--v2-gold-bright), var(--v2-gold-deep)); border-radius: 6px; padding: 0.5rem 0.9rem; text-decoration: none; white-space: nowrap; }
  .v2 .ue-reg.ue-reg-ghost { background: none; color: var(--v2-ink-mut); border: 1px solid var(--v2-hairline-strong); }
  .v2 .ue-note { color: var(--v2-ink-faint); font-size: 0.85rem; text-align: center; margin: 2.5rem auto 0; max-width: 44rem; line-height: 1.6; }
  .v2 .ue-actions { display: flex; align-items: center; gap: 0.6rem; }
  .v2 .ue-star { background: none; border: 1px solid var(--v2-hairline-strong); border-radius: 6px; color: var(--v2-ink-mut); font-size: 1rem; line-height: 1; padding: 0.45rem 0.6rem; cursor: pointer; }
  .v2 .ue-star.ue-starred { color: var(--v2-gold-bright); border-color: var(--v2-gold-deep); }
  .v2 .ue-dist { font-family: var(--v2-display); font-size: 0.62rem; letter-spacing: 0.12em; color: var(--v2-champagne); border: 1px solid var(--v2-hairline); border-radius: 999px; padding: 0.2rem 0.55rem; white-space: nowrap; }
  .v2 .ue-toolbtn { font-family: var(--v2-display); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--v2-ink); background: none; border: 1px solid var(--v2-hairline-strong); border-radius: 6px; padding: 0.55rem 0.9rem; cursor: pointer; text-decoration: none; display: inline-block; }
  .v2 .ue-toolbtn.ue-on { color: var(--v2-plate-text); background: linear-gradient(160deg, var(--v2-gold-bright), var(--v2-gold-deep)); border-color: transparent; }
  .v2 .ue-toolbar { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; margin-top: 0.9rem; align-items: center; }
  .v2 .ue-geo-note { color: var(--v2-ink-faint); font-size: 0.78rem; width: 100%; text-align: center; }
  @media (max-width: 640px) { .v2 .ue-row { grid-template-columns: 1fr; gap: 0.4rem; } }
</style>

<div class="v2">
  <section class="v2-hero">
    <p class="v2-eyebrow">PLAN YOUR SEASON</p>
    <h1>Upcoming Events</h1>
    <p class="v2-bio">Every competition's published tour dates, in one place &mdash; filter by state, month, or circuit and map out the season without the spreadsheet.</p>

    <form class="ue-filters" method="GET" action="/dance/events" id="ue-filter-form">
      <% if (filters.near) { %><input type="hidden" name="near" value="<%= filters.near.lat %>,<%= filters.near.lng %>"><% } %>
      <% if (filters.near && filters.radius) { %><input type="hidden" name="radius" value="<%= filters.radius %>" id="ue-radius-hidden"><% } %>
      <% if (filters.saved) { %><input type="hidden" name="saved" value="1"><% } %>
      <div>
        <label for="ue-state">State</label>
        <select id="ue-state" name="state" onchange="this.form.submit()">
          <option value="">All states</option>
          <% states.forEach(function(s) { %>
            <option value="<%= s %>" <%= filters.state === s ? 'selected' : '' %>><%= s %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label for="ue-month">Month</label>
        <select id="ue-month" name="month" onchange="this.form.submit()">
          <option value="">All months</option>
          <% months.forEach(function(m) { %>
            <option value="<%= m.value %>" <%= filters.month === m.value ? 'selected' : '' %>><%= m.label %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label for="ue-org">Competition</label>
        <select id="ue-org" name="org" onchange="this.form.submit()">
          <option value="">All competitions</option>
          <% orgOptions.forEach(function(o) { %>
            <option value="<%= o.id %>" <%= filters.org === o.id ? 'selected' : '' %>><%= o.name %></option>
          <% }); %>
        </select>
      </div>
      <% if (filters.state || filters.month || filters.org || filters.near || filters.saved) { %>
        <a class="ue-clear" href="/dance/events">Clear filters</a>
      <% } %>
    </form>

    <div class="ue-toolbar">
      <% if (filters.near) { %>
        <span class="ue-toolbtn ue-on">&#128205; Near me</span>
        <select id="ue-radius" class="ue-toolbtn" style="cursor: pointer;">
          <% [100, 250, 500].forEach(function(r) { %>
            <option value="<%= r %>" <%= filters.radius === r ? 'selected' : '' %>>within <%= r %> mi</option>
          <% }); %>
        </select>
      <% } else { %>
        <button type="button" class="ue-toolbtn" id="ue-nearme">&#128205; Near me</button>
      <% } %>
      <% if (isLoggedIn) { %>
        <a class="ue-toolbtn <%= filters.saved ? 'ue-on' : '' %>" href="/dance/events<%= filters.saved ? '' : '?saved=1' %>">&#9733; My Shortlist<%= shortlistCount ? ' (' + shortlistCount + ')' : '' %></a>
      <% } %>
      <a class="ue-toolbtn" id="ue-ics" href="/dance/events.ics">&#8681; Add to Calendar (.ics)</a>
      <span class="ue-geo-note" id="ue-geo-note" style="display: none;"></span>
    </div>
  </section>

  <main class="v2-wrap">
    <% if (groups.length === 0) { %>
      <p class="ue-note" style="margin-top: 3rem;">
        <% if (filters.saved) { %>
          Nothing on your shortlist yet &mdash; browse the <a href="/dance/events" style="color: var(--v2-gold);">full directory</a> and tap the &#9734; on events you're considering.
        <% } else if (filters.state || filters.month || filters.org || filters.near) { %>
          No upcoming events match these filters &mdash; try <a href="/dance/events" style="color: var(--v2-gold);">clearing them</a><% if (filters.near) { %> or widening the radius<% } %>.
        <% } else { %>
          Tour dates for the coming season are being gathered now &mdash; check back soon.
        <% } %>
      </p>
    <% } else { %>
      <% groups.forEach(function(g) { %>
        <h2 class="ue-month"><%= g.label %></h2>
        <% g.events.forEach(function(ev) { %>
          <div class="ue-row">
            <div class="ue-dates">
              <%= ev.start_date.slice(5).replace('-', '/') %><%= ev.end_date ? ' – ' + ev.end_date.slice(5).replace('-', '/') : '' %>
            </div>
            <div>
              <div class="ue-org"><%= ev.org_name %></div>
              <div class="ue-name"><%= ev.name %></div>
              <% if (ev.city || ev.venue) { %>
                <div class="ue-place"><%= [ [ev.city, ev.state].filter(Boolean).join(', '), ev.venue ].filter(Boolean).join(' — ') %></div>
              <% } %>
            </div>
            <div class="ue-actions">
              <% if (typeof ev.distance === 'number') { %>
                <span class="ue-dist">&asymp; <%= ev.distance %> mi</span>
              <% } %>
              <% if (isLoggedIn) { %>
                <button type="button" class="ue-star <%= ev.saved ? 'ue-starred' : '' %>" data-event-id="<%= ev.id %>"
                        title="<%= ev.saved ? 'Remove from shortlist' : 'Save to shortlist' %>" aria-pressed="<%= ev.saved ? 'true' : 'false' %>"><%= ev.saved ? '\u2605' : '\u2606' %></button>
              <% } else { %>
                <a class="ue-star" href="/login?redirect=<%= encodeURIComponent('/dance/events') %>" title="Sign in to save events to a shortlist">&#9734;</a>
              <% } %>
              <% if (ev.registration_url) { %>
                <% const isGold = ev.org_sponsored || ev.gold; %>
                <a class="ue-reg <%= isGold ? '' : 'ue-reg-ghost' %>" href="<%= ev.registration_url %>" target="_blank" rel="noopener nofollow"
                   <%= isGold ? 'title="Featured partner placement"' : '' %>>Register</a>
              <% } else if (ev.org_website) { %>
                <% const isGoldSite = ev.org_sponsored || ev.gold; %>
                <a class="ue-reg <%= isGoldSite ? '' : 'ue-reg-ghost' %>" href="<%= ev.org_website %>" target="_blank" rel="noopener nofollow"
                   <%= isGoldSite ? 'title="Featured partner placement"' : '' %>>Official Site</a>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% }); %>

      <p class="ue-note">
        Dates come from each organizer's published schedule and from organizers who maintain their
        listings here directly<% if (lastChecked) { %> (last checked <%= lastChecked %>)<% } %>.
        Schedules change &mdash; always confirm dates and venues with the organizer before booking travel.
        Gold Register buttons are featured placements from partner organizers &mdash; one of the ways
        AwardHome stays free for dancers, families, and studios. Listing order is never sponsored.
      </p>
    <% } %>
  </main>
</div>

<script>
(function () {
  // "Near me": browser geolocation, used once as a query param — never stored.
  var nearBtn = document.getElementById('ue-nearme');
  var note = document.getElementById('ue-geo-note');
  if (nearBtn) {
    nearBtn.addEventListener('click', function () {
      if (!navigator.geolocation) { note.textContent = 'Location is not available in this browser — use the State filter instead.'; note.style.display = ''; return; }
      nearBtn.disabled = true; nearBtn.textContent = 'Locating…';
      navigator.geolocation.getCurrentPosition(function (pos) {
        var u = new URL(location.href);
        u.searchParams.set('near', pos.coords.latitude.toFixed(3) + ',' + pos.coords.longitude.toFixed(3));
        location.href = u.href;
      }, function () {
        nearBtn.disabled = false; nearBtn.innerHTML = '&#128205; Near me';
        note.textContent = 'Location was declined — no problem, the State filter works too.';
        note.style.display = '';
      }, { timeout: 10000, maximumAge: 300000 });
    });
  }

  var radiusSel = document.getElementById('ue-radius');
  if (radiusSel) {
    radiusSel.addEventListener('change', function () {
      var u = new URL(location.href);
      u.searchParams.set('radius', radiusSel.value);
      location.href = u.href;
    });
  }

  // calendar export mirrors the current filters
  var ics = document.getElementById('ue-ics');
  if (ics) {
    var qs = location.search;
    if (qs) ics.href = '/dance/events.ics' + qs;
  }

  // shortlist stars (csrf.js adds the X-CSRF-Token header to fetch)
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('button.ue-star');
    if (!btn) return;
    var id = btn.getAttribute('data-event-id');
    btn.disabled = true;
    fetch('/api/upcoming/' + id + '/save', { method: 'POST', headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        btn.disabled = false;
        if (typeof data.saved !== 'boolean') return;
        btn.classList.toggle('ue-starred', data.saved);
        btn.textContent = data.saved ? '\u2605' : '\u2606';
        btn.title = data.saved ? 'Remove from shortlist' : 'Save to shortlist';
        btn.setAttribute('aria-pressed', data.saved ? 'true' : 'false');
        var chip = document.querySelector('a[href$="saved=1"], a.ue-toolbtn.ue-on[href="/dance/events"]');
        if (chip && /Shortlist/.test(chip.textContent)) {
          chip.innerHTML = '&#9733; My Shortlist' + (data.count ? ' (' + data.count + ')' : '');
        }
      })
      .catch(function () { btn.disabled = false; });
  });
})();
</script>

<%- include('partials/footer') %>
