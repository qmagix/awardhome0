<%- include('partials/header', { pageTitle: 'News', pageDesc: 'News and stories from AwardHome — the digital trophy case for competitive dance.' }) %>

<style>
  .news-wrap { max-width: 760px; margin: 3rem auto 4rem; padding: 0 1.5rem; }
  .news-wrap h1 { font-size: 2.2rem; margin-bottom: 0.4rem; }
  .news-sub { color: var(--text-muted); margin-bottom: 2.25rem; }
  .news-item { display: block; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem 1.75rem; margin-bottom: 1rem; text-decoration: none; color: inherit; transition: border-color 0.2s ease; }
  .news-item:hover { border-color: var(--primary); }
  .news-item h2 { margin: 0 0 0.35rem; font-size: 1.25rem; color: white; }
  .news-item .news-date { color: var(--primary); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; }
  .news-item p { color: var(--text-muted); margin: 0.5rem 0 0; line-height: 1.55; }
</style>

<div class="news-wrap">
  <h1>AwardHome News</h1>
  <p class="news-sub">Announcements and stories from the digital trophy case for competitive dance.</p>
  <% articles.forEach(function(a) { %>
    <a class="news-item" href="/news/<%= a.slug %>">
      <span class="news-date"><%= new Date(a.date + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
      <h2><%= a.title %></h2>
      <p><%= a.summary %></p>
    </a>
  <% }); %>
</div>

<%- include('partials/footer') %>
