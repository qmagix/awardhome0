<%- include('partials/header') %>
<nav class="section-nav" aria-label="Page sections">
  <div class="section-nav-inner">
    <a href="#competitions">Competitions</a>
    <a href="#featured-studios">Featured Studios</a>
    <a href="#leaderboards">Leaderboards</a>
  </div>
</nav>
<section class="hero">
  <h1>Discover the Stars</h1>
  <p>Explore award-winning studios and dancers from top competitions.</p>
</section>
<div class="container">
  <h2 id="competitions" class="anchor-section">Competitions & Organizations</h2>
  <div class="grid" style="margin-bottom: 4rem;">
    <% orgs.forEach(function(org) { %>
      <div class="premium-org-card">
        <div class="content-wrapper">
          <h3><%= org.name %></h3>
          <div class="org-meta">
            <span class="badge-org"><%= org.event_count || 0 %> Events</span>
            <% if (org.event_count > 0) { %>
            <span style="color: var(--text-muted); font-size: 0.85rem; font-weight: 500;">(Since <%= org.data_since || 2022 %>)</span>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <h2 id="featured-studios" class="anchor-section">Featured Studios</h2>
  <div class="grid" style="margin-bottom: 4rem;">
    <% featuredStudios.forEach(function(s) { %>
      <a href="/dance/studio/<%= s.id %>" class="premium-studio-card">
        <div class="content-wrapper">
          <h3>
            <%= s.name %> 
            <span class="badge-studio" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;">★ Featured</span>
          </h3>
          <div style="margin-bottom: 1.5rem; margin-top: auto;">
            <span class="badge-studio" style="background: rgba(16, 185, 129, 0.2);"><%= s.total_awards %> Awards</span>
          </div>
          <span class="btn btn-outline" style="width: 100%; text-align: center; border-color: rgba(16, 185, 129, 0.3); color: #10b981;">View Awards &rarr;</span>
        </div>
      </a>
    <% }); %>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <h2 id="leaderboards" class="anchor-section" style="margin: 0;">🏆 Global Leaderboards</h2>
    <div class="view-toggle" style="display: flex; gap: 0.5rem; background: rgba(0,0,0,0.3); padding: 0.3rem; border-radius: 8px;">
      <button id="btn-studios" class="btn btn-primary btn-sm" onclick="setLeaderboardView('studios')" style="border-radius: 6px;">Top Studios</button>
      <button id="btn-dancers" class="btn btn-outline btn-sm" onclick="setLeaderboardView('dancers')" style="border-radius: 6px; border: none;">Top Dancers</button>
    </div>
  </div>
  
  <!-- STUDIOS LEADERBOARD -->
  <div id="leaderboard-studios-wrapper">
  
  <div class="tabs-container" style="margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); overflow-x: auto;">
    <ul class="year-tabs">
      <li class="tab-item active" data-target="leaderboard-alltime">All-Time (Past 5 Years)</li>
      <li class="tab-item" data-target="leaderboard-thisyear">This Year</li>
      <li class="tab-item" data-target="leaderboard-firstplaces-thisyear">1st Places This Year</li>
    </ul>
  </div>

  <div class="tab-pane active" id="leaderboard-alltime">
    <div class="card glass-card" style="padding: 0; overflow: hidden; margin-bottom: 4rem;">
      <div style="display: flex; padding: 1rem 1.5rem; background: rgba(0,0,0,0.3); border-bottom: 1px solid rgba(255,255,255,0.1); font-weight: bold; color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase;">
        <div style="width: 60px; text-align: center;">Rank</div>
        <div style="flex-grow: 1;">Studio Name</div>
        <div style="width: 100px; text-align: right;">Total Awards</div>
      </div>
      
      <% topStudios.forEach(function(s, idx) { 
        let rankClass = "badge-common rank-" + (idx + 1);
        let rankStyle = "background: rgba(255,255,255,0.1); color: white;";
        if (idx === 0) rankStyle = "background: rgba(251, 191, 36, 0.2); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.4); font-size: 1rem; font-weight: bold;";
        else if (idx === 1) rankStyle = "background: rgba(156, 163, 175, 0.2); color: #e5e7eb; border: 1px solid rgba(156, 163, 175, 0.4); font-size: 0.95rem; font-weight: bold;";
        else if (idx === 2) rankStyle = "background: rgba(180, 83, 9, 0.2); color: #d97706; border: 1px solid rgba(180, 83, 9, 0.4); font-size: 0.9rem; font-weight: bold;";
      %>
        <a href="/dance/studio/<%= s.id %>" style="display: flex; padding: 1rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.05); text-decoration: none; color: inherit; align-items: center; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='transparent'">
          <div style="width: 60px; text-align: center;">
            <span class="badge <%= rankClass %> leaderboard-rank-badge"><%= idx + 1 %></span>
          </div>
          <div class="leaderboard-name <%= idx < 3 ? 'top-3' : '' %>">
            <%= s.name %>
          </div>
          <div style="width: 100px; text-align: right;">
            <span class="badge badge-count"><%= s.total_awards %></span>
          </div>
        </a>
      <% }); %>
    </div>
  </div>

  <div class="tab-pane" id="leaderboard-thisyear">
    <div class="card glass-card" style="padding: 0; overflow: hidden; margin-bottom: 4rem;">
