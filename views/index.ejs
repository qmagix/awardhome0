          let rankClass = "badge-common rank-" + (idx + 1);
          let rankStyle = "background: rgba(255,255,255,0.1); color: white;";
          if (idx === 0) rankStyle = "background: rgba(251, 191, 36, 0.2); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.4); font-size: 1rem; font-weight: bold;";
          else if (idx === 1) rankStyle = "background: rgba(156, 163, 175, 0.2); color: #e5e7eb; border: 1px solid rgba(156, 163, 175, 0.4); font-size: 0.95rem; font-weight: bold;";
          else if (idx === 2) rankStyle = "background: rgba(180, 83, 9, 0.2); color: #d97706; border: 1px solid rgba(180, 83, 9, 0.4); font-size: 0.9rem; font-weight: bold;";
        %>
          <a href="/dancer/<%= d.unique_id %>" style="display: flex; padding: 1rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.05); text-decoration: none; color: inherit; align-items: center; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='transparent'">
            <div style="width: 60px; text-align: center;">
              <span class="badge <%= rankClass %> leaderboard-rank-badge"><%= idx + 1 %></span>
            </div>
            <div style="width: 50px; text-align: center;">
              <% if (d.headshot_url) { %>
                <img src="<%= d.headshot_url %>" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;">
              <% } else { %>
                <div style="width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">💃</div>
              <% } %>
            </div>
            <div style="flex-grow: 1; font-weight: 600; font-size: 1.1rem; color: <%= idx < 3 ? 'white' : 'var(--text-color)' %>; display: flex; align-items: center; gap: 0.5rem;">
              <%= d.name %>
              <% if (d.is_claimed) { %>
                <svg viewBox="0 0 24 24" fill="#3b82f6" width="16" height="16" title="Verified Dancer"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <% } %>
            </div>
            <div style="width: 100px; text-align: right;">
              <span class="badge badge-count"><%= d.total_awards %></span>
            </div>
          </a>
        <% }); %>
      </div>
